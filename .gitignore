# Python bytecode
**/__pycache__/

# BuildStream local state
.bst
.bst2
.cache/*

# Build / VM artifacts
*.img
*.raw
*.tar
.ovmf-vars.fd
.build-out

# mise load-image's cache-key/podman-image-ID marker (see docs/skills/mise.md
# § Skipping podman load when the artifact is unchanged) — per-workstation
# state, never committed.
.load-image-state
.debug-out/
debug-session/

# Ad-hoc local Buildbarn push/pull test config (tokens, never committed)
.buildbarn-test/

# BST artifact checkouts — can be 4+ GB and 70k+ files.
# Always check out to /tmp or a hidden directory listed here,
# never directly into the repo tree.
.*-deps-*

# Signing keys
cosign.key
files/boot-keys/

# Python venv (created by uv sync / mise deps)
.venv/

# Mise local overrides
.mise.local.toml

# AI agent session state (skills are committed; sessions are not)
.opencode/*
!.opencode/skills/

# pi local state
.pi-subagents

# Claude Code local state (AGENTS.md and .claude/commands/ are committed)
.claude/settings.local.json

# Git worktrees
.worktrees/
.claude/worktrees/

# Generated at build time — do not commit
include/image-version.yml
*.spdx.json
krytis.grype.json
krytis-push-digests.env

# Host-side build tools (compiled ad hoc)
files/fakecap/fakecap-restore
