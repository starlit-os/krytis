{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  // "pep621" is the manager for pyproject.toml — there is no "uv" manager.
  // It reads [project.dependencies] and refreshes uv.lock via `uv lock`.
  // Custom managers only run when "custom.regex" is listed here explicitly —
  // an enabledManagers allowlist otherwise silently skips customManagers.
  "enabledManagers": ["github-actions", "pep621", "mise", "custom.regex"],
  // Renamed from "baseBranches", which renovate-config-validator now reports
  // as needing migration.
  "baseBranchPatterns": ["main"],
  "pinDigests": true,
  // Commits via the GitHub API (Contents/GraphQL) instead of a raw git push.
  // API-authored commits are auto-signed by GitHub regardless of caller
  // credential, which is what will let these PRs merge once #154's
  // required_signatures ruleset rule lands — see #698, #154.
  "platformCommit": "enabled",
  "customManagers": [
    {
      // The GitHub Actions runner version is pinned in two places that must
      // move together: mise.toml [env] feeds `mise run runner/build`'s
      // --build-arg, and the ARG default in Containerfile.runner is what a
      // direct `podman build -f Containerfile.runner` uses. One manager owning
      // both means Renovate rewrites them in a single PR instead of letting the
      // ARG default rot. `mise` has no first-class datasource for [env] values,
      // hence regex rather than the mise manager.
      "customType": "regex",
      "description": "actions/runner version pinned in mise.toml and Containerfile.runner",
      "managerFilePatterns": ["/^mise\\.toml$/", "/^Containerfile\\.runner$/"],
      "matchStrings": [
        "RUNNER_VERSION = \\{ default = \"(?<currentValue>[^\"]+)\" \\}",
        "ARG RUNNER_VERSION=(?<currentValue>\\S+)",
      ],
      "depNameTemplate": "actions/runner",
      "datasourceTemplate": "github-releases",
      // Releases are tagged v2.325.0; both pins hold the bare version.
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
    {
      // pass-cli is not in the mise registry — the repo resolves the short name
      // through [tool_alias] to the github: backend — so the mise manager
      // cannot derive a datasource for it. `\d` anchors the match to the
      // version pin in [tools]; without it the [tool_alias] line
      // (`pass-cli = "github:protonpass/pass-cli"`) matches too.
      "customType": "regex",
      "description": "pass-cli pin in mise.toml [tools] (absent from the mise registry)",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["pass-cli = \"(?<currentValue>\\d[^\"]*)\""],
      "depNameTemplate": "protonpass/pass-cli",
      "datasourceTemplate": "github-releases",
    },
    {
      // The mise binary CI runs on. `jdx/mise-action` is SHA-pinned by the
      // github-actions manager, but the *mise version it installs* was
      // unpinned, and the action only installs/self-updates when a version is
      // requested: with no `version:` input it no-ops whenever a mise binary
      // already exists. Ephemeral runners therefore always got latest while
      // the persistent krytis-vps box stayed on whatever it was first given
      // (2026.9.5 from 2026-09-10) — see cache-warm.yml's comment and
      // docs/skills/ci-runner.md § Pin the mise version, not just the action.
      //
      // A custom manager is needed even though the github-actions manager
      // *does* extract this input natively (as `depType: "uses-with"`,
      // datasource `github-release-attachments`): this repo sets
      // `pinDigests: true` repo-wide, that datasource has no digest to pin,
      // and Renovate then drops the computed update — verified by dry-run,
      // "Could not determine new digest for update" followed by `updates: []`
      // for a deliberately stale 2026.9.5 pin. The regex dep resolves through
      // plain `github-releases` instead, the same path actions/runner already
      // uses successfully above.
      //
      // The `# renovate:` annotation above each pin is what anchors the
      // match; keying off position inside the `with:` block would break the
      // moment an input is reordered. All 31 pins share one depName and
      // currentValue, so they move in a single PR.
      "customType": "regex",
      "description": "mise version pinned on every jdx/mise-action step",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=jdx/mise\\s+version: (?<currentValue>[0-9][^\\s]*)",
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      // Releases are tagged v2026.9.11; the pins hold the bare version.
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      // Must match the repo's only enabled merge method (#697 disabled squash
      // and rebase). Renovate adapted on its own when this still said
      // "squash" — PR #721 automerged as a merge commit — but the mismatch
      // read as if squash automerge were still in play.
      "automergeStrategy": "merge",
    },
    {
      // Cool every tool `mise install` consumes for 24h, matching mise's own
      // `minimum_release_age` default. mise no longer *enforces* that window
      // on an exact pin replayed from mise.lock (jdx/mise#13128, #13251), so
      // this is not what keeps CI green — the mise version pin is. What it
      // restores is the protection the default was for: these bumps
      // auto-merge unattended, and a hijacked release should not reach a
      // build within hours of being published.
      "matchManagers": ["mise"],
      "minimumReleaseAge": "1 day",
    },
    {
      // Same window for the CI mise binary, which the native mise manager
      // cannot see (it is a workflow input, not a [tools] entry) and which
      // every runner self-updates to before anything else runs. Matchers
      // inside one rule are ANDed, so this cannot be folded into the rule
      // above — a single rule naming both a manager and this depName would
      // match nothing at all. pass-cli needs no rule here: it is
      // automerge: false below, so a human already gates it.
      "matchDepNames": ["jdx/mise"],
      "minimumReleaseAge": "1 day",
    },
    {
      // Hard-pinned in pyproject.toml for BST 2.5.x compatibility. A bump has
      // to be tested against the build, so it never auto-merges.
      "matchManagers": ["pep621"],
      "matchPackageNames": ["click", "dulwich"],
      "automerge": false,
      "prBodyNotes": [
        ":warning: Hard-pinned for BuildStream compatibility — merge only after `mise run validate` and a `mise run build` pass on this branch.",
      ],
    },
    {
      // BuildStream is coupled to the freedesktop-sdk / gnome-build-meta
      // junction versions — a bump may need junction bumps in lockstep.
      // PRs are for visibility; merging is a human call.
      "matchManagers": ["pep621"],
      "matchPackageNames": [
        "buildstream",
        "buildstream-plugins",
        "buildstream-plugins-community",
      ],
      "automerge": false,
      "prBodyNotes": [
        ":warning: BuildStream is coupled to the freedesktop-sdk junction — check whether `elements/freedesktop-sdk.bst` and `elements/gnome-build-meta.bst` need bumping in lockstep before merging.",
      ],
    },
    {
      // `requires-python = ">=3.12"` is a floor, not a pin — bumping it drops
      // interpreter support rather than picking up a new release.
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false,
    },
    {
      // buildstream-sbom is a `git+https://…@<sha>` direct reference, which the
      // pypi datasource cannot represent. Bump it by hand and re-verify
      // `mise run sbom` (see the comment in pyproject.toml).
      "matchManagers": ["pep621"],
      "matchPackageNames": ["buildstream-sbom"],
      "enabled": false,
    },
    {
      // pass-cli comes from the custom manager above (not the native mise
      // manager), and its mise.lock refresh has proven unreliable there:
      // two Renovate-authored bumps (2026-08-25, 2026-08-27) landed with a
      // stale lockfile entry, failing CI's `mise install --locked` step
      // (`pass-cli@X.Y.Z is not in the lockfile`) and needing a manual
      // force-push fix before merge. The native mise manager has had zero
      // such failures over the same period — see `renovate.md` § The mise
      // manager — so this rule stays manual while that one does not.
      "matchDepNames": ["protonpass/pass-cli"],
      "automerge": false,
      "prBodyNotes": [
        ":warning: Run `mise run mise-lock` on this branch and commit the refreshed `mise.lock` before merging — Renovate cannot update it.",
      ],
    },
    {
      // The python pin tracks pyproject.toml's `requires-python = ">=3.12"`,
      // and BST 2.5.x is validated against 3.12. Patch bumps are routine;
      // crossing the minor boundary is a deliberate, human decision.
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.13",
    },
  ],
}
