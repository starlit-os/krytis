kind: script

# Generates only the locales Krytis needs instead of the full glibc SUPPORTED
# list (~400+ locales) that freedesktop-sdk.bst:components/locales.bst produces.
#
# en_SE (English as spoken in Sweden) arrived in glibc 2.43 and is available
# since the fdsdk 26.08 bump (#305) took the junction to glibc 2.44. Verified
# present as /usr/share/i18n/locales/en_SE in the built image before adding
# it here — localedef fails the build outright on a missing source locale,
# but checking first is cheaper than a build round trip. Closes #159.

build-depends:
- freedesktop-sdk.bst:public-stacks/runtime-gnu.bst
- freedesktop-sdk.bst:components/gzip.bst

config:
  commands:
  - mkdir -p %{install-root}/usr/lib/locale
  # en_US.UTF-8 and C.UTF-8 are already generated by utf-locale.bst (in runtime-minimal).
  # Adding en_US here causes an overlap error at compose time.
  - localedef --prefix=%{install-root} --no-archive -i sv_SE -f UTF-8 sv_SE.UTF-8
  - localedef --prefix=%{install-root} --no-archive -i en_SE -f UTF-8 en_SE.UTF-8

public:
  bst:
    split-rules:
      locale:
        (>):
        - "%{indep-libdir}/locale"
        - "%{indep-libdir}/locale/**"
