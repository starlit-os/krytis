+// With a single installed session there is nothing to choose, so the picker
+// row, its focus stop and the F3 shortcut are dropped, like the user picker
+// with a single user.
+bool GreeterSurface::showsSessionSelector() const noexcept { return m_sessions.size() > 1; }
