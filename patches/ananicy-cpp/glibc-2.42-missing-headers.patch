# krytis#222: v1.2.0 fails to build with fdsdk's shipped GCC 16.2.0 —
# "'memset' is not a member of 'std'" in src/utility/argument_parsing/argument.cpp,
# then "'getpid' was not declared in this scope" in src/platform/linux/process.cpp,
# and so on across several files: older libstdc++/glibc transitively pulled in
# <cstring>/<cstdint>/<unistd.h> via other standard headers; newer ones don't.
#
# This is upstream's own fix, cherry-picked verbatim rather than re-derived by hand:
# commit 77866526e1116c0b237970cf6faa2972748e57f1 "fix: add missing <cstring> and
# <cstdint> headers for glibc 2.42" (merged to master 2026-08-18 via !43,
# https://gitlab.com/ananicy-cpp/ananicy-cpp/-/commit/77866526e1116c0b237970cf6faa2972748e57f1),
# landed on master after v1.2.0 (2026-03-27) and not yet in any tagged release.
# Carry until the next tag includes it.
diff --git a/src/config.cpp b/src/config.cpp
index 4a53e2f6a0523cf95ec6adc24fecee6b3063ee74..ce9eb3fe36673407a889b836801f17f4e423cc4a 100644
--- a/src/config.cpp
+++ b/src/config.cpp
@@ -6,6 +6,7 @@
 #include "core/priority.hpp"
 
 #include <chrono> // for system_clock::now
+#include <cstdint>
 #include <fstream>
 
 #include <fmt/chrono.h>
