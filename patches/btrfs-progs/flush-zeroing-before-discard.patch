# krytis#1294, tracked upstream in krytis#1302: mkfs.btrfs can leave the old
# filesystem's signatures on the disk.
#
# kdave/btrfs-progs d50769a4 ("mkfs: do zeroing before discard", v6.16.1+) zeroes
# the first and last 2 MiB with a buffered pwrite and then issues BLKDISCARD. The
# kernel's BLKDISCARD ioctl truncates the block device's page cache over the
# range without writing it back, so the zeroes are dropped before they reach the
# disk. A device that then ignores the discard (QEMU virtio-blk's default
# discard=ignore, or a drive whose TRIM isn't deterministic) keeps the old
# bytes. On a reinstall over an encrypted disk, both LUKS2 headers survive,
# blkid reports crypto_LUKS, and fisherman's plain remount fails.
#
# Flush the zeroes before discarding. Unchanged in btrfs-progs devel as of
# 2026-10-16.
diff --git a/common/device-utils.c b/common/device-utils.c
index 63240c1..fd447b7 100644
--- a/common/device-utils.c
+++ b/common/device-utils.c
@@ -293,6 +293,18 @@ int btrfs_prepare_device(int fd, const char *file, u64 *byte_count_ret,
 		goto err;
 	}
 
+	/*
+	 * The zeroes above are buffered. BLKDISCARD drops the discarded range
+	 * from the block device's page cache without writing it back, so
+	 * without this flush they never reach the disk. A device that then
+	 * ignores the discard keeps the old filesystem's signatures, e.g.
+	 * both LUKS2 headers, which blkid prefers over the new btrfs.
+	 */
+	if (fsync(fd) < 0) {
+		error("failed to flush zeroed ranges on '%s': %m", file);
+		goto err;
+	}
+
 	if (!(opflags & PREP_DEVICE_ZONED) && (opflags & PREP_DEVICE_DISCARD))
 		prepare_discard_device(file, fd, byte_count, opflags);
 
