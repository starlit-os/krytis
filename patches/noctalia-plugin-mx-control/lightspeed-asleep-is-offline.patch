# krytis#1292: on Lightspeed, the backported retry
# (retry-empty-settings.patch) re-reads an asleep device every tick.
#
# zachwilke/omarchy-mxcontrol#16's device_is_online() pings the device and
# falls back to the cached `online` flag if the ping raises. A Lightspeed
# receiver answers an asleep child's ping itself with HID++ 1.0 error
# UNKNOWN_DEVICE, about 3 ms. Solaar's Device.ping() catches only
# NoReceiver, so that escapes as NoSuchDevice, and the fallback returns the
# `online=True` the receiver reported at pairing. Measured 2026-10-17 on a G915
# TKL behind 046d:c547: about 4 pings and 2 full settings re-reads every 2 s for
# the whole 3.5 min the keyboard slept, and the snapshot kept saying online.
#
# Fix: treat NoSuchDevice as offline. Re-measured: the asleep G915 shows
# `online: false`, gets one 3 ms ping per 2 s and no re-read, and has 15
# settings 2 s after its link comes up. Its lighting stayed off throughout,
# so the pings do not wake it.
#
# Proposed upstream on 2026-10-17 as suggested changes on
# zachwilke/omarchy-mxcontrol#16 (pullrequestreview-5558966452), with a test.
# The PR took both verbatim on 2026-10-19 as 7432d3e. Remove when the
# plugin's backend no longer trusts the cached flag on NoSuchDevice.
diff --git a/mx-control/backend/mxctl.py b/mx-control/backend/mxctl.py
index 1aaeafd..ef12b26 100755
--- a/mx-control/backend/mxctl.py
+++ b/mx-control/backend/mxctl.py
@@ -801,7 +801,13 @@ def device_is_online(dev) -> bool:
     # constructs children with online=True. Only a live ping matches Solaar.
     try:
         return bool(dev.ping())
-    except Exception:
+    except Exception as exc:
+        # A Lightspeed receiver answers an asleep child's ping with
+        # UNKNOWN_DEVICE, and Solaar's Device.ping() lets that escape as
+        # NoSuchDevice. That is a live "not reachable"; the cached online
+        # flag would keep re-reading an asleep device every retry tick.
+        if type(exc).__name__ == "NoSuchDevice":
+            return False
         return getattr(dev, "online", None) is True
 
 
