+                    payload["lastError"] = last_error
+                    publish(payload)
+                elif time.monotonic() - last_heartbeat >= HEARTBEAT_SEC:
                     last_heartbeat = time.monotonic()
                     refresh_batteries(opened, payload, skip=covered)
                     actions.check(list(iter_devices(opened)))
