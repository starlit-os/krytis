# krytis#1313: disabling the plugin never stops its serve helper.
#
# onExit runs `pkill -TERM -f shared.HELPER_PATTERN`, and the pattern was
# "^python3 [^ ]*/mxctl\.py serve$". serve, started by
# runAsync({ "python3", ... }), shows up in the process list as
# `/usr/bin/python3 .../mxctl.py serve`, so pkill matched nothing. The old
# serve kept the helper lock and heartbeat, so a disable/enable never moved to
# a new copy of the backend (krytis#1293 needed a relogin).
#
# Fix: allow a path before python3, `^[^ ]*python3 ...`, still anchored so a
# shell that only mentions serve is not killed. The test previously pinned the
# pattern string. It now runs the pattern through `grep -E`, as pkill does,
# against real command lines, and fails on the old pattern.
#
# Proposed upstream on 2026-10-19 as noctalia-dev/community-plugins#1073,
# the same two hunks plus a 0.2.3 version bump. Remove when community-plugins'
# mx-control matches serve under an interpreter path.
diff --git a/mx-control/shared.luau b/mx-control/shared.luau
index 5afc10e..60563b0 100644
--- a/mx-control/shared.luau
+++ b/mx-control/shared.luau
@@ -13,8 +13,10 @@ local STALE_SEC = 150
 local HELPER_RESTART_SEC = 90
 
 -- A running serve, from any copy of the plugin; anchored so a shell or grep
--- that merely mentions it is never killed.
-M.HELPER_PATTERN = "^python3 [^ ]*/mxctl\\.py serve$"
+-- that merely mentions it is never killed. The interpreter may be a bare name
+-- or a path: serve started by runAsync({ "python3", ... }) shows up in the
+-- process list as /usr/bin/python3.
+M.HELPER_PATTERN = "^[^ ]*python3 [^ ]*/mxctl\\.py serve$"
 
 function M.helperNeedsStart(ts, nowSec)
     ts = tonumber(ts)
diff --git a/mx-control/tests/shared_test.lua b/mx-control/tests/shared_test.lua
index 723e003..e186407 100644
--- a/mx-control/tests/shared_test.lua
+++ b/mx-control/tests/shared_test.lua
@@ -172,7 +172,17 @@ check("a stale snapshot wins over its old permission error",
 check("no snapshot means the helper must start", shared.helperNeedsStart(nil, 1000))
 check("a heartbeat within 90 s means it is alive", not shared.helperNeedsStart(1000, 1089))
 check("a snapshot older than 90 s means it died", shared.helperNeedsStart(1000, 1091))
-check("the helper pattern is anchored to a real serve process", shared.HELPER_PATTERN == "^python3 [^ ]*/mxctl\\.py serve$")
+-- pkill -f matches HELPER_PATTERN as an ERE against the full command line.
+local function helperMatches(cmdline)
+    local p = io.popen("printf '%s\\n' '" .. cmdline .. "' | grep -Ec '" .. shared.HELPER_PATTERN .. "'")
+    local n = p:read("*n")
+    p:close()
+    return n == 1
+end
+check("the helper pattern matches serve run by bare name", helperMatches("python3 /x/mx-control/backend/mxctl.py serve"))
+check("the helper pattern matches serve run by path", helperMatches("/usr/bin/python3 /usr/share/noctalia/plugins/mx-control/backend/mxctl.py serve"))
+check("the helper pattern skips a shell that mentions serve", not helperMatches("bash -c python3 /x/mxctl.py serve"))
+check("the helper pattern skips other mxctl commands", not helperMatches("/usr/bin/python3 /x/mxctl.py status"))
 
 -- sectionFor
 check("dpi is a pointer setting", shared.sectionFor("dpi") == "pointer")
