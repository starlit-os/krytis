# Attempt FIDO2 unlock of the gpt-auto-discovered root, BEFORE the generated
# systemd-cryptsetup@root.service gets its turn.
#
# Why a separate unit instead of overriding the generated one's ExecStart:
# systemd-cryptsetup treats a missing FIDO2 token in the LUKS header as FATAL.
# find_fido2_auto_data() returns -ENXIO ("No valid FIDO2 token data found"), and
# unlike TPM2 - whose failures are deliberately mangled to -EAGAIN, "let's make any
# form of TPM2 failure non-fatal" - nothing downgrades it. So putting
# fido2-device=auto into the root's option string turns a working passphrase prompt
# into an immediate exit 1 and emergency mode on every machine WITHOUT an enrolled
# key, which is the default state of a fresh install.
#
# Measured, not reasoned: mise run luks-boot-test caught exactly that regression.
#
# This unit is therefore strictly additive. The `-` prefix means a machine with no
# enrolled token fails here silently, the generated unit runs untouched, and the
# passphrase prompt appears exactly as it does today. When a token IS enrolled, this
# attaches the volume and the generated unit is skipped by its ConditionPathExists.
#
# It also means krytis never restates systemd's own option set. The generated
# ExecStart carries tpm2-device=auto plus the tpm2-measure-* options, and an earlier
# version of this change copied them by hand - coupling us to an upstream argv layout
# for no benefit. See docs/skills/fido2.md § gpt-auto-generator owns the root's
# crypt options and #250.
#
# Ordering mirrors what gpt-auto's own add_cryptsetup() writes for this volume, so it is
# inherited rather than invented. Its BindsTo= on the device unit is deliberately NOT
# copied: that exists to tear the unlock down with the device, which is meaningless for a
# one-shot pre-attempt, and an unsatisfiable BindsTo is one more way to stall the boot
# ahead of the passphrase prompt. After= alone gives the ordering we need.
[Unit]
Description=FIDO2 unlock attempt for the gpt-auto root volume
Documentation=https://github.com/starlit-os/krytis/issues/250
DefaultDependencies=no
IgnoreOnIsolate=true

# Absent on an unencrypted install, which is krytis's default - skip quietly there.
ConditionPathExists=/dev/gpt-auto-root-luks

After=dev-gpt\x2dauto\x2droot\x2dluks.device cryptsetup-pre.target systemd-udevd.service
Before=systemd-cryptsetup@root.service cryptsetup.target umount.target
Conflicts=umount.target

[Service]
Type=oneshot
# No RemainAfterExit and no ExecStop: if this attempt wins, the volume is the ROOT and
# is never detached during shutdown anyway; if it loses, the generated unit owns the
# mapping and detaching it from here would fight that unit.
#
# headless=yes is what makes this safe to run first, and it was NOT obvious. Without it
# this is a full unlock attempt, not a FIDO2-only one: after the token path comes up empty
# systemd-cryptsetup falls through to ASKING FOR A PASSPHRASE itself. Measured 2026-08-08
# — the attempt sat for the whole TimeoutSec while its password request went to plymouth,
# invisible, and the real prompt only appeared once this unit was killed:
#
#   [ 3.442] systemd-cryptsetup[291]: Set cipher aes ... /dev/gpt-auto-root-luks
#   [ 3.452] Started systemd-ask-password-plymouth.service   <- this unit prompting
#   [63.497] krytis-fido2-root-unlock.service: start operation timed out
#
# With headless=yes both password and PIN querying return -ENOPKG immediately ("Password
# querying disabled via 'headless' option"), so this unit can only ever succeed via the
# token and can never compete with the generated unit for the password agent.
#
# Consequence worth knowing: a credential enrolled WITH a client PIN cannot unlock here,
# because supplying the PIN needs the prompt this option forbids. It fails, the generated
# unit asks for the passphrase, and the boot is correct but keyless. Enroll touch-only
# (systemd-cryptenroll --fido2-with-client-pin=no) for FIDO2 boot unlock.
#
# Bounded, unlike the generated unit's TimeoutSec=infinity. That one can block forever
# because a human is typing a passphrase into it; this one runs BEFORE that prompt, so a
# stall here delays the fallback rather than a person.
#
# THREE nested bounds, and the order between them is load-bearing (#547):
#
#   token-timeout=10s   systemd's wait-for-token udev monitor, for an enrolled token whose
#                       key is not plugged in
#   timeout=20s         systemd-cryptsetup's OWN deadline for the presence wait
#   TimeoutSec=30       systemd's backstop if it stalls anywhere else
#
# timeout= must stay STRICTLY LESS than TimeoutSec, or the visible bug in #547 comes back.
# Without it, arg_timeout is USEC_INFINITY, systemd-cryptsetup waits for the touch forever,
# and TimeoutSec SIGTERMs it. The plymouth "Please confirm presence on security token"
# message is torn down by `_cleanup_(plymouth_end_interaction)` in libfido2-util.c, which
# only runs when the function RETURNS — a killed process never unwinds, so the message is
# orphaned on screen underneath the passphrase prompt, inviting a touch that now unlocks
# nothing. With a deadline of its own, systemd-cryptsetup returns normally, the cleanup
# runs, and the fallback prompt appears alone.
#
# What this does NOT fix: the key keeps blinking until its own internal timeout, because
# systemd never cancels the CTAP2 assertion — fido_dev_cancel is not even in its dlopen
# symbol table (only fido_dev_close). That needs an upstream patch; see #547.
TimeoutSec=30

# `-`: failure is the expected path on a machine with no enrolled token.
ExecStart=-/usr/lib/systemd/systemd-cryptsetup attach root /dev/gpt-auto-root-luks '' fido2-device=auto,headless=yes,token-timeout=10s,timeout=20s
