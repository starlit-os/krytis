#!/usr/bin/bash
# krytis-esp-automount-generator: give a LUKS (device-mapper) root the ESP automount
# that systemd-gpt-auto-generator gives every plain root (#1328).
#
# Why: bootc's initramfs points /run/systemd/volatile-root at the device under
# /sysroot. On an encrypted install that is the dm-crypt mapping, and systemd's
# blockdev_get_root() takes volatile-root as is, without tracing it to the backing
# partition (only its other branch does that). gpt-auto then dissects the mapping, finds
# no GPT, and generates no ESP mount, silently. Without one, systemd-boot-update.service
# logs "Couldn't find EFI system partition, skipping." on every boot and the ESP's loader
# never moves past the version it was installed with. See docs/skills/secure-boot.md
# § The ESP's systemd-boot is updated by systemd, not bootc.
#
# This writes the same two units gpt-auto writes on a plain root (src/gpt-auto-generator/
# gpt-auto-generator.c add_partition_esp → add_automount, systemd v262), for the
# partition systemd-boot reports in LoaderDevicePartUUID. It does nothing unless
# volatile-root names a device-mapper device, so plain roots keep gpt-auto's own units.
# Its units go to the normal generator directory; gpt-auto writes to the late one, so if
# a future systemd fixes blockdev_get_root() and gpt-auto starts generating them too,
# these win and the result is the same mount.

set -eu
normal_dir="${1:?usage: $0 <normal-dir> [early-dir] [late-dir]}"

[ -e /etc/initrd-release ] && exit 0
[ -d /sys/firmware/efi ] || exit 0

# gpt-auto's own off switch covers this too.
read -r cmdline < /proc/cmdline || cmdline=""
for arg in ${cmdline}; do
    case "${arg}" in
        systemd.gpt_auto=0|systemd.gpt_auto=no|systemd.gpt_auto=false|systemd.gpt_auto=off) exit 0 ;;
        rd.systemd.gpt_auto=0|rd.systemd.gpt_auto=no|rd.systemd.gpt_auto=false|rd.systemd.gpt_auto=off) exit 0 ;;
    esac
done

# Only the case gpt-auto gives up on: volatile-root is a device-mapper device.
root=$(readlink /run/systemd/volatile-root 2>/dev/null) || exit 0
case "${root}" in
    /dev/block/*:*) ;;
    *) exit 0 ;;
esac
[ -e "/sys/dev/block/${root#/dev/block/}/dm" ] || exit 0

# The partition systemd-boot was loaded from: a 4-byte attribute header, then the GUID
# as UTF-16LE. The ESP by construction, and the one `bootctl` should update.
var=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
[ -r "${var}" ] || exit 0
uuid=$(tail -c +5 "${var}" | tr -d '\0' | tr 'A-F' 'a-f')
[[ "${uuid}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || exit 0

# An fstab entry for either mount point is explicit configuration; gpt-auto defers to it.
if [ -r /etc/fstab ] && grep -qE '^[[:space:]]*[^#[:space:]]+[[:space:]]+/(boot|efi)/?[[:space:]]' /etc/fstab; then
    exit 0
fi

# gpt-auto's choice (path_is_busy): /boot when it is unused and empty, else /efi. A path
# that is already a mount point is not busy: generators also run on daemon-reload, when
# the automount from the previous run is in place. A missing path is skipped rather than
# created, because the composefs root is read-only.
usable() {
    [ -d "$1" ] || return 1
    mountpoint -q "$1" && return 0
    [ -z "$(ls -A "$1" 2>/dev/null)" ]
}
if usable /boot; then
    where=/boot
elif usable /efi; then
    where=/efi
else
    exit 0
fi

what="/dev/disk/by-partuuid/${uuid}"
dev_unit=$(systemd-escape --path "${what}")
unit=$(systemd-escape --path "${where}")

{
    echo "# Automatically generated by krytis-esp-automount-generator"
    echo
    echo "[Unit]"
    echo "Description=EFI System Partition Automount"
    echo "Documentation=man:systemd-gpt-auto-generator(8)"
    # gpt-auto checks the ESP before mounting it whenever fsck.vfat is installed
    # (generator_write_fsck_deps); dosfstools ships it.
    if command -v fsck.vfat >/dev/null 2>&1; then
        echo "Requires=systemd-fsck@${dev_unit}.service"
        echo "After=systemd-fsck@${dev_unit}.service"
    fi
    echo "After=blockdev@${dev_unit}.target"
    echo
    echo "[Mount]"
    echo "What=${what}"
    echo "Where=${where}"
    echo "Type=vfat"
    # partition_pick_mount_options() for PARTITION_ESP: the ESP holds the boot loader's
    # random seed, so keep it root-only, and never execute or follow symlinks from it.
    echo "Options=fmask=0177,dmask=0077,rw,nodev,nosuid,noexec,nosymfollow"
} > "${normal_dir}/${unit}.mount"

{
    echo "# Automatically generated by krytis-esp-automount-generator"
    echo
    echo "[Unit]"
    echo "Description=EFI System Partition Automount"
    echo "Documentation=man:systemd-gpt-auto-generator(8)"
    echo
    echo "[Automount]"
    echo "Where=${where}"
    # LOADER_PARTITION_IDLE_USEC
    echo "TimeoutIdleSec=120"
} > "${normal_dir}/${unit}.automount"

mkdir -p "${normal_dir}/local-fs.target.wants"
ln -sf "../${unit}.automount" "${normal_dir}/local-fs.target.wants/${unit}.automount"
