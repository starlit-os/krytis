#!/usr/bin/env bash
#MISE description="Enroll a FIDO2 security key as a LUKS2 unlock factor via systemd-cryptenroll"

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "This task enrolls a LUKS token — run as root: sudo mise fido2:enroll-luks" >&2
  exit 1
fi

# Collect LUKS devices from /etc/crypttab
LUKS_DEVICES=()
if [[ -f /etc/crypttab ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue
    DEVICE=$(awk '{print $2}' <<< "$line")
    # crypttab commonly uses UUID= syntax; resolve to a path cryptsetup can open
    if [[ "$DEVICE" =~ ^UUID= ]]; then
      DEVICE="/dev/disk/by-uuid/${DEVICE#UUID=}"
    fi
    cryptsetup isLuks "$DEVICE" 2>/dev/null && LUKS_DEVICES+=("$DEVICE") || true
  done < /etc/crypttab
fi

# Fresh bootc installs have no /etc/crypttab — fall back to block device scan
if [[ ${#LUKS_DEVICES[@]} -eq 0 ]]; then
  while IFS= read -r dev; do
    [[ -n "$dev" ]] && LUKS_DEVICES+=("$dev")
  done < <(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null | sort)
fi

if [[ ${#LUKS_DEVICES[@]} -eq 0 ]]; then
  echo "No LUKS devices found (checked /etc/crypttab and blkid scan)" >&2
  exit 1
fi

if [[ ${#LUKS_DEVICES[@]} -eq 1 ]]; then
  DEVICE="${LUKS_DEVICES[0]}"
else
  echo "LUKS devices:"
  for i in "${!LUKS_DEVICES[@]}"; do
    echo "  $i) ${LUKS_DEVICES[$i]}"
  done
  read -rp "Select device [0-$((${#LUKS_DEVICES[@]}-1))]: " IDX
  DEVICE="${LUKS_DEVICES[$IDX]}"
fi

echo ""
read -rp "Enroll FIDO2 key on ${DEVICE}? [y/N] " CONFIRM
if [[ ! "$CONFIRM" =~ ^[yY]$ ]]; then
  echo "Aborted."
  exit 0
fi

echo "Enter the disk passphrase, then the key's PIN if it has one, then touch the key when it blinks..."
# --fido2-with-client-pin defaults to yes, so a key with a PIN set gets a credential that
# needs the PIN. Boot can ask for it since #1058: krytis-fido2-root-unlock (in the initrd)
# prompts for the PIN after a touch-only attempt fails with systemd's headless-PIN error.
systemd-cryptenroll --fido2-device=auto "$DEVICE"

# Boot unlock of the ROOT volume does not come from a karg: systemd-gpt-auto-generator
# builds the root's unit and ignores rd.luks.options= (#250). It comes from
# krytis-fido2-root-unlock.service (config/fido2-root-unlock.bst) in the initrd.
# See docs/skills/fido2.md § gpt-auto-generator owns the root's crypt options.
if cryptsetup luksDump --dump-json-metadata "$DEVICE" 2>/dev/null \
    | grep -Eq '"fido2-clientPin-required"[[:space:]]*:[[:space:]]*true'; then
  echo "Enrolled with a PIN. At boot, the disk asks for the key's PIN, then for a touch."
  echo "Leave the PIN empty at that prompt to type the disk passphrase instead."
else
  echo "Enrolled touch-only: the key alone, with a touch, unlocks the disk at boot."
fi
echo "Verify with: mise fido2:status"
