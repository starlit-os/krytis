#!/usr/bin/env bash
#MISE description="Show enrolled FIDO2 keys for sudo and LUKS slots"

set -euo pipefail

AUTHFILE="${XDG_CONFIG_HOME:-${HOME}/.config}/Yubico/u2f_keys"

echo "=== pam_u2f keys — sudo / polkit, plus login for non-homed users (${AUTHFILE}) ==="
if [[ -s "$AUTHFILE" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue
    USERNAME="${line%%:*}"
    NUM_KEYS=$(tr ':' '\n' <<< "$line" | tail -n +2 | wc -l)
    echo "  ${USERNAME}: ${NUM_KEYS} key(s)"
  done < "$AUTHFILE"
else
  echo "  (no keys enrolled — run: mise fido2:enroll)"
fi

echo ""
echo "=== systemd-homed login credentials (stale — see #759/#532) ==="

# #759/#532 retired the homed-owned login credential (`homectl update
# --fido2-device=auto`, rp_id io.systemd.home): systemd-homed always tries it
# first and prompts for a PIN before checking device presence, and a
# FIDO2-only login skips pam_unix so the login keyring never gets a password
# to unlock with. `mise fido2:enroll` no longer creates these and actively
# removes any it finds — a non-empty count here means enrollment predates
# that fix (or something re-added one by hand) and should be cleaned up.
HOMED_USERS=$(homectl list --json=short 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
if [[ -z "$HOMED_USERS" ]]; then
  echo "  (no systemd-homed users)"
else
  while IFS= read -r HOMED_USER; do
    [[ -z "$HOMED_USER" ]] && continue
    CREDS=$(homectl inspect --json=short "$HOMED_USER" 2>/dev/null |
      jq -r '(.fido2HmacCredential // []) | length' 2>/dev/null || echo 0)
    if [[ "$CREDS" -gt 0 ]]; then
      echo "  ${HOMED_USER}: ${CREDS} stale credential(s) — run: mise fido2:enroll to remove"
    else
      echo "  ${HOMED_USER}: none (expected — login is password-only)"
    fi
  done <<< "$HOMED_USERS"
fi

echo ""
echo "=== LUKS FIDO2 slots ==="

LUKS_DEVICES=()
if [[ -f /etc/crypttab ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue
    DEVICE=$(awk '{print $2}' <<< "$line")
    if [[ "$DEVICE" =~ ^UUID= ]]; then
      DEVICE="/dev/disk/by-uuid/${DEVICE#UUID=}"
    fi
    cryptsetup isLuks "$DEVICE" 2>/dev/null && LUKS_DEVICES+=("$DEVICE") || true
  done < /etc/crypttab
fi

if [[ ${#LUKS_DEVICES[@]} -eq 0 ]]; then
  while IFS= read -r dev; do
    [[ -n "$dev" ]] && LUKS_DEVICES+=("$dev")
  done < <(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null | sort)
fi

if [[ ${#LUKS_DEVICES[@]} -eq 0 ]]; then
  echo "  (no LUKS devices found)"
else
  for DEVICE in "${LUKS_DEVICES[@]}"; do
    echo "  ${DEVICE}:"
    systemd-cryptenroll "$DEVICE" 2>/dev/null | sed 's/^/    /' || true
  done
fi
