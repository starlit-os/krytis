[Unit]
Description=Pre-install krytis's system Flatpak applications
Documentation=https://github.com/starlit-os/krytis/issues/66
# No ConditionPathExists gate: the script keeps a per-app ledger and exits at
# once when every app is recorded, so an app added to its list reaches existing
# installs (#1319). network-online.target is already pulled in on every boot by
# starlit-update.service and others, so running each boot costs nothing extra.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/krytis/flatpak-preinstall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
