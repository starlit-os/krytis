[Unit]
Description=Put host cursor themes on the Flatpak XCursor search path
Documentation=https://github.com/starlit-os/krytis/issues/949
# Reasserted every boot, unlike flatpak-preinstall's once-per-app installs: this writes
# into /var, needs no network, and must reassert itself if /var is reset.
# Ordered before the graphical session so the first app launched already sees
# the override.
Before=graphical.target
# First of the boot-time `flatpak --system` writers: bazaar-host-etc.service and
# flatpak-preinstall.service order themselves after this unit, because on an
# empty /var concurrent flatpak processes race to create the repo (#1371).

[Service]
Type=oneshot
ExecStart=/usr/libexec/krytis/flatpak-cursor-path.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
