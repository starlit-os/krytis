#!/usr/bin/env bash
#MISE description="Boot the sealed UKI against an emulated TPM and assert the PCR barrier does not brick it (#466)"
#USAGE flag "--image <ref>" default="localhost/krytis:sealed" help="Sealed image whose UKI is booted"
#USAGE flag "--no-tpm" help="Control run: boot the same UKI with NO TPM, where the barrier is skipped entirely"
#USAGE flag "--keep" help="Keep the workdir (ESP, varstore, serial log) for inspection"

# The gate every other test was missing. systemd-pcrphase-initrd.service is guarded
# by ConditionSecurity=measured-uki, which is only satisfied when systemd-stub
# measured the UKI — and that needs a TPM. QEMU has none in boot-test,
# selfenroll-test, upgrade-test or iso-install-test, so the unit is silently SKIPPED
# in all of them and they pass on an image that reboot-loops on real hardware (#466).
#
# It carries FailureAction=reboot-force, so a failed measurement is not a degraded
# unit, it is an unbootable machine.
#
# Deliberately boots the UKI alone from a synthetic ESP: no install, no disk, no
# composefs. The barrier runs Before=sysinit.target, long before anything needs a
# root filesystem, so a failure here can only be about TPM measurement. ~40s.
#
# Secure Boot is off on purpose: the stub measures whenever a TPM is present,
# independent of Secure Boot, and with enforcement off it also honours the SMBIOS
# cmdline addition that gets us past the UKI's baked `quiet`.

set -euo pipefail

CLI_IMAGE=""; CLI_NO_TPM=""; CLI_KEEP=""
while [ $# -gt 0 ]; do
    case "$1" in
        --image)  CLI_IMAGE="$2"; shift 2 ;;
        --no-tpm) CLI_NO_TPM=true; shift ;;
        --keep)   CLI_KEEP=true; shift ;;
        *) break ;;
    esac
done

IMAGE="${CLI_IMAGE:-${usage_image:-localhost/krytis:sealed}}"
NO_TPM="${CLI_NO_TPM:-${usage_no_tpm:-}}"
KEEP="${CLI_KEEP:-${usage_keep:-}}"

podman image exists "${IMAGE}" || {
    echo "ERROR: ${IMAGE} not found locally — run 'mise run seal-uki' first." >&2
    exit 1
}

# swtpm is not packaged on every workstation and needs no privileges in a container,
# so the VM runs inside one. /dev/kvm must be accessible to it; on this project's
# hosts it is 0666, and --group-add keep-groups covers the group-permission case.
RUNNER_IMAGE="${TPM_TEST_IMAGE:-docker.io/library/fedora:41}"
command -v podman >/dev/null || { echo "ERROR: podman not found." >&2; exit 1; }
[ -r /dev/kvm ] || { echo "ERROR: /dev/kvm not readable — KVM is required." >&2; exit 1; }

WORKDIR=$(mktemp -d /var/tmp/krytis-tpm-boot.XXXXXX)
cleanup() {
    if [ -n "${KEEP}" ]; then echo "==> Kept ${WORKDIR}"; else rm -rf "${WORKDIR}"; fi
}
trap cleanup EXIT

echo "==> [1/3] Extracting the UKI from ${IMAGE}..."
CID=$(podman create "${IMAGE}" true)
podman cp "${CID}":/boot/EFI/Linux/krytis.efi "${WORKDIR}/uki.efi"
podman rm "${CID}" >/dev/null
[ -s "${WORKDIR}/uki.efi" ] || { echo "ERROR: ${IMAGE} has no UKI — not a sealed build." >&2; exit 1; }

echo "==> [2/3] Building a synthetic ESP around it..."
# Sized from the UKI rather than hardcoded: it is ~230MB today and grows with the
# kernel. mkfs.vfat and mtools need no privileges on a plain file.
UKI_MB=$(( ( $(stat -c%s "${WORKDIR}/uki.efi") / 1048576 ) + 64 ))
truncate -s "${UKI_MB}M" "${WORKDIR}/esp.img"
mkfs.vfat -F32 -n KRYTISTPM "${WORKDIR}/esp.img" >/dev/null
export MTOOLS_SKIP_CHECK=1
mmd -i "${WORKDIR}/esp.img" ::/EFI ::/EFI/BOOT
mcopy -i "${WORKDIR}/esp.img" "${WORKDIR}/uki.efi" ::/EFI/BOOT/BOOTX64.EFI

cat > "${WORKDIR}/run.sh" <<'GUEST'
#!/bin/bash
set -uo pipefail
. /repo/scripts/ovmf-paths.sh
CODE=$(ovmf_code_plain) || exit 1
VARS=$(ovmf_vars_plain) || exit 1
cp "$VARS" /work/vars.fd

TPM_ARGS=()
if [ "${WITH_TPM}" = yes ]; then
    mkdir -p /work/tpmstate
    swtpm socket --tpm2 --tpmstate dir=/work/tpmstate \
           --ctrl type=unixio,path=/work/swtpm.sock --daemon --log level=1 || exit 1
    sleep 1
    TPM_ARGS=(-chardev socket,id=chrtpm,path=/work/swtpm.sock
              -tpmdev emulator,id=tpm0,chardev=chrtpm
              -device tpm-tis,tpmdev=tpm0)
fi

# ignore_loglevel defeats the UKI's baked `quiet`; systemd-pcrextend logs its own
# failure to kmsg, which is otherwise invisible and cost real debugging time.
# log_target=kmsg is load-bearing, not decoration: without it systemd's
# "ConditionSecurity=… succeeded/failed" debug lines never reach the serial log, and
# the skipped-versus-ran distinction this whole test rests on becomes unobservable.
EXTRA='io.systemd.stub.kernel-cmdline-extra=console=ttyS0 loglevel=7 ignore_loglevel systemd.log_level=debug systemd.log_target=kmsg systemd.show_status=1'

# -no-reboot turns FailureAction=reboot-force into a clean QEMU exit instead of a
# loop, which is the difference between a test and a hang.
timeout 150 qemu-system-x86_64 \
    -enable-kvm -m 2048 -cpu host -smp 2 -machine q35 \
    -drive "if=pflash,format=raw,readonly=on,file=${CODE}" \
    -drive "if=pflash,format=raw,file=/work/vars.fd" \
    -drive "file=/work/esp.img,format=raw,if=virtio" \
    "${TPM_ARGS[@]}" \
    -smbios "type=11,value=${EXTRA}" \
    -display none -no-reboot \
    -serial file:/work/serial.log
GUEST
chmod +x "${WORKDIR}/run.sh"

WITH_TPM=yes; [ -n "${NO_TPM}" ] && WITH_TPM=no
echo "==> [3/3] Booting under QEMU (tpm=${WITH_TPM})..."
podman run --rm --device /dev/kvm --group-add keep-groups \
    -v "${WORKDIR}:/work" -v "$(pwd):/repo:ro" \
    -e WITH_TPM="${WITH_TPM}" \
    "${RUNNER_IMAGE}" bash -c \
    'dnf install -y -q qemu-system-x86-core swtpm swtpm-tools edk2-ovmf >/dev/null 2>&1 || {
        echo "ERROR: could not install qemu/swtpm/edk2-ovmf in ${0}" >&2; exit 1; }
     bash /work/run.sh' || true

LOG="${WORKDIR}/serial.log"
[ -s "${LOG}" ] || { echo "FAIL: no serial output — the guest never ran." >&2; exit 1; }

echo "==> Verdict"
# `|| true` matters: under `set -o pipefail` a grep with no matches exits 1 and takes
# the whole task down before any verdict runs — which is exactly what happened to the
# no-TPM control, whose log legitimately contains none of these strings.
grep -aE 'measured-uki|PCR Barrier|pcrextend\[|Forcibly rebooting' "${LOG}" |
    sed 's/^/    /' | head -8 || true

# Every signal here is chosen for durability, because three earlier attempts at this
# block reported the wrong cause:
#
#   - NEVER match the unit name. systemd's console status lines truncate it with an
#     ellipsis ("systemd-pcrphase-i…service"), so `grep systemd-pcrphase-initrd`
#     silently never matches.
#   - `pcrextend[NNN]:` is the reliable proof the barrier RAN: it is a kmsg line,
#     logged in full, and only exists if the unit's conditions passed and it forked.
#   - Skipping is detected by ABSENCE. The "ConditionSecurity=… failed" line only
#     reaches serial under log_target=console, while pcrextend's error needs
#     log_target=kmsg; the error is worth more, so absence carries the skip.
booted() {
    grep -aqE 'systemd [0-9]+.* running in system mode|Starting ' "${LOG}"
}
ran_barrier() {
    grep -aqE "pcrextend\[[0-9]+\]:|(Starting|Failed to start).*PCR Barrier \(initrd\)|measured-uki succeeded" "${LOG}"
}
measurement_broke() {
    grep -aqE "pcrextend\[[0-9]+\]: (Shared library|TPM2 support not installed|TPM device not usable)" "${LOG}"
}
force_rebooted() {
    grep -aq 'Forcibly rebooting' "${LOG}"
}
barrier_failed() {
    force_rebooted || measurement_broke ||
        grep -aqE 'Failed to start.*PCR Barrier \(initrd\)' "${LOG}"
}

booted || {
    echo "FAIL: the guest never reached systemd, so nothing here is about the TPM." >&2
    echo "      Inspect with --keep; the UKI may not have been found on the ESP." >&2
    exit 1
}

if [ "${WITH_TPM}" = no ]; then
    # The control. Proves the other gates' silence is the condition, not luck.
    if ! ran_barrier; then
        echo "==> PASS (control): booted, and the barrier never ran — no TPM means"
        echo "    ConditionSecurity=measured-uki cannot be satisfied. This is exactly what"
        echo "    every other QEMU gate sees, and why none of them can catch #466."
        exit 0
    fi
    echo "FAIL: the barrier ran without a TPM, which should be impossible." >&2
    exit 1
fi

# Failure first. Asking "did it run?" before "did it fail?" mislabels the very bug
# this task exists to catch, which is how the first three versions of this went wrong.
if barrier_failed; then
    echo "FAIL: the PCR barrier failed on a TPM-equipped boot (#466)." >&2
    force_rebooted &&
        echo "      It force-rebooted, so such a machine reboot-LOOPS." >&2
    measurement_broke && {
        echo "      Cause is above; the usual one is libtss2-tcti-device.so.0 missing from" >&2
        echo "      the initrd — dracut cannot see a dlopen'ed library, so" >&2
        echo "      elements/core/initramfs.bst must name tpm2-tss in add_dracutmodules." >&2
    }
    exit 1
fi

if ! ran_barrier; then
    echo "FAIL: a TPM was attached but the barrier never ran, so this proved nothing." >&2
    echo "      systemd-stub did not measure — check -device tpm-tis and swtpm." >&2
    exit 1
fi

echo "==> PASS: the UKI was measured against a real TPM and the PCR barrier completed,"
echo "    so a TPM-equipped machine boots past it."
