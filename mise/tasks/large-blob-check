#!/usr/bin/env bash
#MISE description="Fail if a tracked file exceeds the blob size ceiling (allowlist below)"
#USAGE flag "--max-bytes <bytes>" default="5242880" help="Size ceiling for a single tracked file. Default 5 MiB."
#USAGE flag "--ref <rev>" default="HEAD" help="Git revision whose tree is checked. Default HEAD."

# Guards the failure mode found in #1004: a 46 MiB Proton Pass CLI binary sat
# tracked at the repo root as `pc.tar.gz` for two months, added by an
# accidental `git add` in e3b241c (#452) and referenced by nothing. Nothing
# failed, nothing warned, and every clone paid for it.
#
# .gitignore cannot prevent the general case — the name was arbitrary, and a
# pattern broad enough to catch it (`*.tar.gz`) would also hide files somebody
# deliberately wants tracked. A size ceiling catches it by the property that
# actually matters, regardless of name or extension.
#
# Checked against the tree, not the diff, deliberately. A diff-scoped gate only
# sees the commit that adds the blob: rebase it away, split the branch, or land
# it before the gate exists, and the file becomes permanently invisible — which
# is precisely how pc.tar.gz survived. A tree-scoped gate re-asserts the
# invariant on every run, so anything already over the line has to be either
# removed or consciously allowlisted below.
#
# Adding to ALLOWED is a deliberate act with a stated reason, not a silencer:
# a stale entry (allowlisted path no longer tracked) is itself a failure, so
# the list cannot quietly outlive what it excuses.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

MAX_BYTES="${usage_max_bytes:-5242880}"
REV="${usage_ref:-HEAD}"

# path <TAB> reason. Every entry needs a reason a reviewer can check.
ALLOWED=$(
    cat <<'EOF'
files/fakecap-manifest.tsv	~989K-line capability manifest, regenerated by `mise run generate-fakecap-manifest` and committed on purpose — composefs xattr replay reads it at build time (docs/design/composefs-chunkah.md § The fakecap-manifest.tsv)
EOF
)

human() {
    awk -v b="$1" 'BEGIN {
        split("B KiB MiB GiB", u, " ")
        i = 1
        while (b >= 1024 && i < 4) { b /= 1024; i++ }
        printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i]
    }'
}

fail=0

echo "==> Checking tracked file sizes at ${REV} (ceiling $(human "$MAX_BYTES"))..."

# `git ls-tree -r -l` prints: <mode> <type> <oid> <size> <path>. Size is "-"
# for non-blobs (submodule commits), hence the type filter.
oversized=$(git ls-tree -r -l --full-name "$REV" | awk -v max="$MAX_BYTES" '$2 == "blob" && $4 + 0 > max { size = $4; $1 = $2 = $3 = $4 = ""; sub(/^ +/, ""); print size "\t" $0 }')

while IFS=$'\t' read -r size path; do
    [ -n "$path" ] || continue
    if printf '%s\n' "$ALLOWED" | cut -f1 | grep -qxF "$path"; then
        reason=$(printf '%s\n' "$ALLOWED" | grep -F "$path"$'\t' | cut -f2-)
        printf '  allowed  %-40s %10s — %s\n' "$path" "$(human "$size")" "$reason"
        continue
    fi
    printf '  TOO BIG  %-40s %10s\n' "$path" "$(human "$size")"
    fail=1
done <<<"$oversized"

# An allowlist entry for a path that is no longer tracked is dead weight that
# would silently excuse a *future* file re-added at the same path.
while IFS=$'\t' read -r path _; do
    [ -n "$path" ] || continue
    if ! git cat-file -e "${REV}:${path}" 2>/dev/null; then
        printf '  STALE    %-40s allowlisted but not tracked at %s\n' "$path" "$REV"
        fail=1
    fi
done <<<"$ALLOWED"

if [ "$fail" -ne 0 ]; then
    cat <<EOF
==> large-blob-check FAILED.

    A file over $(human "$MAX_BYTES") is tracked. Almost always this is an
    accidental \`git add\` of a downloaded release artifact, a build output, or
    a VM/ISO image — check before assuming otherwise:

      git log --oneline -- <path>     # one commit and never touched again?
      grep -rn '<path>' .             # referenced by any task/workflow/doc?

    If it genuinely belongs in the repo, add it to ALLOWED in
    mise/tasks/large-blob-check with a reason naming what reads it.
EOF
    exit 1
fi

echo "==> large-blob-check passed."
