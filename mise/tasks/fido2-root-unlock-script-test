#!/usr/bin/env bash
#MISE description="Unit-test the initrd FIDO2 root-unlock wrapper's PIN logic against stubbed systemd-cryptsetup/ask-password (#1058)"

# Runs files/fido2-root-unlock/krytis-fido2-root-unlock on the host with both binaries
# stubbed. It checks the script's decisions only: when it asks for a PIN, how often,
# when it gives up to the passphrase prompt. That systemd-cryptsetup really prints the
# headless-PIN message, and that plymouth shows the prompt, is what a VM or hardware
# run proves (mise run luks-boot-test, then T4 step 7 with a PIN-set key).
#
# The stub's behaviour per call comes from $STUB_PLAN, one word per attach call:
#   ok        attach succeeds
#   needpin   fails with systemd's "PIN querying disabled via 'headless' option" message
#   notoken   fails the way a volume with no FIDO2 token does
#   blocked   fails with "PIN of security token is blocked"
# and the ask-password stub answers from $STUB_PINS (one word per prompt, ERROR = failure).

set -euo pipefail

SCRIPT=files/fido2-root-unlock/krytis-fido2-root-unlock
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

cat >"$WORK/cryptsetup" <<'EOF'
#!/usr/bin/env bash
n=$(cat "$STUB_DIR/attach-count" 2>/dev/null || echo 0)
n=$((n + 1)); echo "$n" >"$STUB_DIR/attach-count"
echo "${PIN-<unset>}" >>"$STUB_DIR/pins-seen"
read -ra plan <<<"$STUB_PLAN"
case "${plan[$((n - 1))]:-notoken}" in
    ok) exit 0 ;;
    needpin) echo "PIN querying disabled via 'headless' option. Use the '\$PIN' environment variable." >&2; exit 1 ;;
    notoken) echo "No valid FIDO2 token data found." >&2; echo "Password querying disabled via 'headless' option." >&2; exit 1 ;;
    blocked) echo "PIN of security token is blocked, please remove/reinsert token." >&2; exit 1 ;;
esac
EOF
cat >"$WORK/ask" <<'EOF'
#!/usr/bin/env bash
n=$(cat "$STUB_DIR/ask-count" 2>/dev/null || echo 0)
n=$((n + 1)); echo "$n" >"$STUB_DIR/ask-count"
read -ra pins <<<"$STUB_PINS"
p="${pins[$((n - 1))]:-ERROR}"
[ "$p" = ERROR ] && exit 1
printf '%s\n' "$p"
EOF
chmod +x "$WORK/cryptsetup" "$WORK/ask"

FAIL=0
# case <name> <plan> <answers> <expected rc> <expected attach calls> <expected prompts> <expected pins seen>
check() {
    local name=$1 plan=$2 pins=$3 want_rc=$4 want_attach=$5 want_ask=$6 want_seen=$7
    local d="$WORK/$name"; mkdir -p "$d"
    local rc=0
    STUB_DIR="$d" STUB_PLAN="$plan" STUB_PINS="$pins" \
        KRYTIS_CRYPTSETUP="$WORK/cryptsetup" KRYTIS_ASK_PASSWORD="$WORK/ask" \
        bash "$SCRIPT" >/dev/null 2>"$d/stderr" || rc=$?
    local attach ask seen
    attach=$(cat "$d/attach-count" 2>/dev/null || echo 0)
    ask=$(cat "$d/ask-count" 2>/dev/null || echo 0)
    seen=$(paste -sd ' ' "$d/pins-seen" 2>/dev/null || true)
    if [ "$rc" = "$want_rc" ] && [ "$attach" = "$want_attach" ] && [ "$ask" = "$want_ask" ] && [ "$seen" = "$want_seen" ]; then
        echo "PASS  $name"
    else
        echo "FAIL  $name: rc=$rc/$want_rc attach=$attach/$want_attach prompts=$ask/$want_ask pins='$seen'/'$want_seen'"
        sed 's/^/      | /' "$d/stderr"
        FAIL=1
    fi
}

check touch-only        "ok"                     ""          0 1 0 "<unset>"
check no-token          "notoken"                ""          1 1 0 "<unset>"
check pin-right         "needpin ok"             "1234"      0 2 1 "<unset> 1234"
check pin-wrong-right   "needpin needpin ok"     "9999 1234" 0 3 2 "<unset> 9999 1234"
check pin-wrong-twice   "needpin needpin needpin" "1 2"      1 3 2 "<unset> 1 2"
check pin-skipped       "needpin"                "-"         1 1 1 "<unset>"
check pin-prompt-failed "needpin"                "ERROR"     1 1 1 "<unset>"
check pin-blocked       "needpin blocked"        "1234"      1 2 1 "<unset> 1234"

[ "$FAIL" -eq 0 ] && echo "==> fido2-root-unlock-script-test passed" || exit 1
