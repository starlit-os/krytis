#!/usr/bin/env bash
#MISE description="Boot an installed sealed disk against a pristine firmware and assert it enrols its own keys, then comes up enforcing (#438)"
#USAGE flag "--disk <path>" default="/var/tmp/dakota-sealed-install.img" help="Installed sealed disk, as left behind by 'mise run iso-install-test'"
#USAGE flag "--keep" help="Keep the workdir (disk copy, varstore, serial log) for inspection"

set -euo pipefail

# The end of the chain. enroll-test proves the .auth files enrol from an ESP
# holding nothing else; this proves the same thing on a REAL installed system —
# bootc's ESP layout, the UKI, composefs, the first-boot oneshot, all of it — and
# that the result is a healthy running machine rather than merely a firmware that
# did not complain.
#
# The varstore is deliberately PRISTINE (setup mode, no keys), which is what a
# machine that has never seen krytis looks like. .ovmf-vars-secure.fd would defeat
# the point: it already contains the keys, so nothing would need enrolling and
# `boot-test --secure` already covers that case.
#
# Verdict comes over SMBIOS type-11 credentials, never the serial console: a
# sealed system's cmdline is frozen inside the signed UKI, so console=ttyS0 cannot
# be injected and the kernel logs to tty0 only. See docs/skills/secure-boot.md
# § A sealed system's boot cannot be judged from the serial console.

CLI_DISK=""; CLI_KEEP=""
while [ $# -gt 0 ]; do
    case "$1" in
        --disk) CLI_DISK="$2"; shift 2 ;;
        --keep) CLI_KEEP=true; shift ;;
        *) break ;;
    esac
done

DISK="${CLI_DISK:-${usage_disk:-/var/tmp/dakota-sealed-install.img}}"
KEEP="${CLI_KEEP:-${usage_keep:-}}"

if [ ! -f "${DISK}" ]; then
    echo "ERROR: no installed disk at ${DISK}" >&2
    echo "  Produce one:  mise run build-iso --sealed --debug && mise run iso-install-test --secure" >&2
    echo "  iso-install-test leaves the disk in place; this task boots a copy of it." >&2
    exit 1
fi

command -v qemu-system-x86_64 >/dev/null || { echo "ERROR: qemu-system-x86_64 not found." >&2; exit 1; }

OVMF_CODE=""; OVMF_VARS_SRC=""
for c in /usr/share/edk2/ovmf/OVMF_CODE_4M.secboot.fd /usr/share/OVMF/OVMF_CODE_4M.secboot.qcow2 \
         /usr/share/edk2/x64/OVMF_CODE.4m.secboot.fd /usr/share/edk2/ovmf/OVMF_CODE.secboot.fd; do
    [ -f "$c" ] && OVMF_CODE="$c" && break
done
for v in /usr/share/edk2/ovmf/OVMF_VARS_4M.secboot.fd /usr/share/OVMF/OVMF_VARS_4M.secboot.qcow2 \
         /usr/share/edk2/x64/OVMF_VARS.4m.secboot.fd /usr/share/edk2/ovmf/OVMF_VARS.secboot.fd; do
    [ -f "$v" ] && OVMF_VARS_SRC="$v" && break
done
[ -n "${OVMF_CODE}" ] || { echo "ERROR: OVMF secboot firmware not found." >&2; exit 1; }
[ -n "${OVMF_VARS_SRC}" ] || { echo "ERROR: OVMF secboot vars template not found." >&2; exit 1; }

WORKDIR=$(mktemp -d /var/tmp/krytis-selfenroll.XXXXXX)
cleanup() {
    [ -f "${WORKDIR}/qemu.pid" ] && kill "$(cat "${WORKDIR}/qemu.pid")" 2>/dev/null || true
    if [ -n "${KEEP}" ]; then echo "==> Kept ${WORKDIR}"; else rm -rf "${WORKDIR}"; fi
}
trap cleanup EXIT

echo "==> [1/3] Preparing a copy of ${DISK} and a pristine varstore..."
# Always a copy: enrolling mutates the varstore, and a booted disk is no longer a
# first-boot disk. Reflink keeps a 64G sparse image free on btrfs.
cp --reflink=auto "${DISK}" "${WORKDIR}/disk.raw"
cp "${OVMF_VARS_SRC}" "${WORKDIR}/vars.fd"

printf '[Unit]\nWants=krytis-selfenroll-probe.service\n' > "${WORKDIR}/mu.conf"
cat > "${WORKDIR}/probe.service" <<'PROBE'
[Unit]
Description=krytis self-enrollment probe
DefaultDependencies=no
[Service]
Type=simple
ExecStart=/bin/bash /run/credentials/krytis-selfenroll-probe.service/probe.sh
ImportCredential=probe.sh
StandardOutput=file:/dev/ttyS0
StandardError=file:/dev/ttyS0
PROBE

cat > "${WORKDIR}/probe.sh" <<'PROBESH'
#!/bin/bash
sleep 50
echo "===KRYTIS-SELFENROLL==="
echo "state: $(systemctl is-system-running)"
bootctl status 2>&1 | grep -iE 'secure boot|setup mode' | sed 's/^ */sb: /'
echo "image: $(bootc status --json 2>/dev/null | python3 -c 'import json,sys
d = json.load(sys.stdin)
b = (d.get("status") or d).get("booted") or {}
print(((b.get("image") or {}).get("image") or {}).get("image", "<unknown>"))' 2>/dev/null || echo '<unparsed>')"
echo "failed-units:"; systemctl --failed --no-legend --no-pager | head -5
echo "===KRYTIS-SELFENROLL-END==="
systemctl poweroff --no-block
PROBESH

cred_b64() { base64 -w0 < "$1"; }

echo "==> [2/3] Booting against a setup-mode firmware (no keys enrolled)..."
qemu-system-x86_64 \
    -enable-kvm -m "${VM_RAM:-4096}" -cpu host -smp "${VM_CPUS:-4}" \
    -machine q35,smm=on \
    -global driver=cfi.pflash01,property=secure,value=on \
    -drive "file=${WORKDIR}/disk.raw,format=raw,if=virtio" \
    -drive "if=pflash,format=raw,readonly=on,file=${OVMF_CODE}" \
    -drive "if=pflash,format=raw,file=${WORKDIR}/vars.fd" \
    -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.multi-user.target=$(cred_b64 "${WORKDIR}/mu.conf")" \
    -smbios "type=11,value=io.systemd.credential.binary:systemd.extra-unit.krytis-selfenroll-probe.service=$(cred_b64 "${WORKDIR}/probe.service")" \
    -smbios "type=11,value=io.systemd.credential.binary:probe.sh=$(cred_b64 "${WORKDIR}/probe.sh")" \
    -display none \
    -serial "file:${WORKDIR}/serial.log" \
    -daemonize -pidfile "${WORKDIR}/qemu.pid"

DEADLINE=$((SECONDS + 240))
while [ "${SECONDS}" -lt "${DEADLINE}" ]; do
    grep -q 'KRYTIS-SELFENROLL-END' "${WORKDIR}/serial.log" 2>/dev/null && break
    grep -qE 'Access Denied|Security Violation' "${WORKDIR}/serial.log" 2>/dev/null && break
    sleep 5
done
# The guest powers itself off at the end of the probe, so qemu usually exits and
# removes its own pidfile before we get here. Only kill what is still there.
[ -f "${WORKDIR}/qemu.pid" ] && kill "$(cat "${WORKDIR}/qemu.pid")" 2>/dev/null || true
sleep 1

echo "==> [3/3] Verdict"
grep -E 'Enrolling|successfully enrolled|BdsDxe: (starting|failed to load)|systemd-boot@|systemd-stub@' \
    "${WORKDIR}/serial.log" | head -8 | sed 's/^/    /'
sed -n '/===KRYTIS-SELFENROLL===/,/===KRYTIS-SELFENROLL-END===/p' "${WORKDIR}/serial.log" \
    | tr -d '\r' | sed 's/^/    /'

if ! grep -q 'successfully enrolled' "${WORKDIR}/serial.log"; then
    echo "FAIL: the system never enrolled its own keys from ESP loader/keys/auto." >&2
    echo "      Either the .auth files are missing from the image, or secure-boot-enroll" >&2
    echo "      declined. Check with: mise run enroll-test" >&2
    exit 1
fi

if grep -qE 'Access Denied|Security Violation' "${WORKDIR}/serial.log"; then
    echo "FAIL: the firmware refused the loader AFTER enrolling this system's own keys." >&2
    echo "      That is #438's shape — the enrolled db does not authorise our binaries." >&2
    echo "      Confirm with: scripts/parse-efi-auth.py on the image's .auth files" >&2
    exit 1
fi

if ! grep -q 'state: running' "${WORKDIR}/serial.log"; then
    echo "FAIL: enrolled and started, but the system did not reach 'running'." >&2
    echo "      Not a Secure Boot failure — look at the failed units above." >&2
    echo "      Inspect with: mise run selfenroll-test --keep" >&2
    exit 1
fi

if ! grep -qi 'sb:.*Secure Boot: enabled' "${WORKDIR}/serial.log"; then
    echo "FAIL: reached 'running' but Secure Boot is not enabled — enrollment did not take" >&2
    echo "      effect, so this boot proves nothing about enforcement." >&2
    exit 1
fi

echo "==> PASS: installed system enrolled its own keys from a pristine firmware and"
echo "    came up healthy under Secure Boot enforcement."
