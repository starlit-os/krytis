#!/usr/bin/env bash
#MISE description="Verify overrides/ruby.bst still mirrors freedesktop-sdk's element and is still needed"

# elements/overrides/ruby.bst runs ruby 4.0.10 ahead of the junction for
# BIT-ruby-2026-97229 (Critical, KEV, fixed in 4.0.8) and ruby-lang's
# 2026-11-18 Regexp/String advisories (fixed in 4.0.10).
#
# Two ways the copy goes wrong without a signal:
#   1. A junction bump changes the upstream element's build config while the
#      copy keeps building the old one. This task diffs everything but the
#      tarball version and `ref:` against the junction's element.
#   2. The junction reaches 4.0.10 itself, and the override becomes dead
#      weight that would hold ruby back on the next upstream bump. This task
#      fails as soon as the junction's ruby is >= the held one.
#
# The junction's source may also move from `kind: tar` to `kind: anitya`
# (fdsdk's release/26.08 already has). That shows up as drift under (1): read
# the version from the anitya `ref: version:` and resync the copy.
#
# When it fails on (1), resync the copy. When it fails on (2), delete the
# override element, this task and the overrides entry in
# elements/freedesktop-sdk.bst.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

OVERRIDE="elements/overrides/ruby.bst"
UPSTREAM_PATH="elements/components/ruby.bst"

if [ ! -f "$OVERRIDE" ]; then
    echo "==> $OVERRIDE is gone — nothing to check."
    exit 0
fi

REF="$(grep -oP '^\s*ref:\s*\K\S+' elements/freedesktop-sdk.bst | head -1)"
SHA="${REF##*-g}"
if [ -z "$SHA" ] || [ "$SHA" = "$REF" ]; then
    echo "==> Could not read a git-describe ref from elements/freedesktop-sdk.bst" >&2
    exit 1
fi

URL="https://gitlab.com/freedesktop-sdk/freedesktop-sdk/-/raw/${SHA}/${UPSTREAM_PATH}"
echo "==> Comparing $OVERRIDE against freedesktop-sdk ${SHA:0:12}"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

if ! curl -fsSL --retry 3 --retry-delay 10 "$URL" -o "$TMP/upstream.bst"; then
    echo "==> Could not fetch $URL" >&2
    exit 1
fi

# ruby-X.Y.Z.tar.xz in a tar url, or `version: X.Y.Z` under an anitya ref.
ruby_version() {
    grep -oP 'ruby-\K[0-9]+\.[0-9]+\.[0-9]+(?=\.tar)|^\s*version:\s*\K[0-9.]+' "$1" | head -1
}

HELD="$(ruby_version "$OVERRIDE")"
JUNCTION="$(ruby_version "$TMP/upstream.bst")"
if [ -z "$HELD" ] || [ -z "$JUNCTION" ]; then
    echo "==> Could not read a ruby version (held '${HELD}', junction '${JUNCTION}')" >&2
    exit 1
fi
echo "==> Override holds ruby ${HELD}; the junction would supply ${JUNCTION}"

# Exit condition first: once the junction catches up, nothing else matters.
if [ "$(printf '%s\n%s\n' "$HELD" "$JUNCTION" | sort -V | tail -1)" = "$JUNCTION" ]; then
    echo
    echo "==> The junction's ruby ${JUNCTION} is >= the held ${HELD}; the override is"
    echo "    obsolete. Delete $OVERRIDE, this task and the overrides entry in"
    echo "    elements/freedesktop-sdk.bst."
    exit 1
fi

# Comments, blank lines, the `ref:` and the version in the tarball url may
# differ, and fdsdk's `tar_https:cache.ruby-lang.org/` is krytis's
# `ruby_lang:` alias (include/aliases.yml); sibling dependencies carry a `freedesktop-sdk.bst:` prefix because a
# bare `components/foo.bst` only resolves inside freedesktop-sdk's namespace.
normalise() {
    grep -vE '^\s*#|^\s*$|^\s*ref:' \
        | sed -e 's/^- freedesktop-sdk\.bst:/- /' \
              -e 's|tar_https:cache\.ruby-lang\.org/|ruby_lang:|' \
              -e 's/ruby-[0-9]\+\.[0-9]\+\.[0-9]\+\.tar/ruby-VERSION.tar/'
}

normalise <"$TMP/upstream.bst" >"$TMP/upstream.norm"
normalise <"$OVERRIDE" >"$TMP/override.norm"

if ! diff -u --label "freedesktop-sdk/$UPSTREAM_PATH" "$TMP/upstream.norm" \
        --label "$OVERRIDE" "$TMP/override.norm"; then
    echo
    echo "==> ruby-check FAILED — the override has drifted from the junction."
    echo "    Resync $OVERRIDE against freedesktop-sdk's element."
    exit 1
fi

echo "==> ruby-check passed."
