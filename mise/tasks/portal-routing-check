#!/usr/bin/env python3
#MISE description="Assert which xdg-desktop-portal backend serves each portal interface under niri and Umbriel"
#USAGE flag "--tag <tag>" default="localhost/krytis:latest" help="Image to check (must already be built/loaded)"
"""Ratchet for xdg-desktop-portal routing (#1027).

Routing decides which backend serves each org.freedesktop.impl.portal.*
interface, and a wrong answer is invisible until a Flatpak misbehaves. Three
inputs move it without anyone touching krytis: niri's niri-portals.conf changes
with every niri bump, desktop/xdg-desktop-portal-umbriel.bst tracks main and
ships umbriel-portals.conf, and a backend that grows an interface claims it
through `default=`.

xdg-desktop-portal resolves routing at startup, before it activates anything,
so this runs headlessly: one container start, xdp --verbose under each
desktop's XDG_CURRENT_DESKTOP, and its `Using <backend>.portal for <iface>`
lines are the answer. An interface with no such line has no backend (none).
Resolution took ~1.2 s when measured; each run gets XDP_SECONDS.

Fails on:
  mismatch      an interface resolves to a backend other than the table's;
  unclassified  an installed .portal file declares an interface the table has
                no row for — a backend grew one, a human decides;
  unparsable    an `Error loading …` warning: xdp skips a .portal file it
                cannot parse, with nothing but that warning (#1027);
  no config     no `Using portal configuration file` line for a desktop: xdp
                fell back to the legacy UseIn= matching;
  redundant     a key in a krytis /etc/xdg/xdg-desktop-portal/<d>-portals.conf
                that the upstream /usr/share file now resolves the same way on
                its own — upstream caught up, delete the key (#1028).

The tables are the expected state. A PR that changes routing on purpose edits
its rows in the same commit. See docs/skills/desktop.md § xdg-desktop-portal
routing.
"""

import os
import re
import subprocess
import sys

XDP_SECONDS = 4

# interface (without the org.freedesktop.impl.portal. prefix) -> (backend, why)
NIRI_UPSTREAM = "niri-portals.conf default=gnome;gtk"
EXPECTED = {
    "niri": {
        "Access": ("gtk", "niri-portals.conf interface key"),
        "Account": ("gnome", NIRI_UPSTREAM),
        "AppChooser": ("gnome", NIRI_UPSTREAM),
        "Background": ("gnome", NIRI_UPSTREAM),
        "Clipboard": ("gnome", "needs Mutter RemoteDesktop, niri lacks it (#1054)"),
        "DynamicLauncher": ("gnome", NIRI_UPSTREAM),
        "Email": ("gtk", "gnome.portal lacks it"),
        "FileChooser": ("gnome", "Nautilus"),
        "GlobalShortcuts": ("gnome", "needs org.gnome.Shell, niri lacks it (#1054)"),
        "Inhibit": ("gtk", "gnome.portal lacks it"),
        "InputCapture": ("gnome", "needs Mutter, niri lacks it (#1054)"),
        "Lockdown": ("gnome", NIRI_UPSTREAM),
        "Notification": ("gtk", "niri-portals.conf interface key"),
        "Print": ("gnome", NIRI_UPSTREAM),
        "RemoteDesktop": ("gnome", "needs Mutter RemoteDesktop, niri lacks it (#1054)"),
        "ScreenCast": ("gnome", "niri implements Mutter ScreenCast"),
        "Screenshot": ("gnome", "niri implements org.gnome.Shell.Screenshot"),
        "Secret": ("oo7-portal", "krytis /etc delta, niri's file says gnome-keyring (#1028)"),
        "Settings": ("gnome", NIRI_UPSTREAM),
        "Usb": ("gnome", NIRI_UPSTREAM),
        "Wallpaper": ("gnome", NIRI_UPSTREAM),
    },
    "Umbriel": {
        "Access": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "Account": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "AppChooser": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Background": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Clipboard": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "DynamicLauncher": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "Email": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "FileChooser": ("gtk", "umbriel-portals.conf default=umbriel;gtk (#1029)"),
        "GlobalShortcuts": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Inhibit": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "InputCapture": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Lockdown": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Notification": ("gtk", "umbriel-portals.conf default=umbriel;gtk"),
        "Print": ("gtk", "umbriel-portals.conf default=umbriel;gtk (#1029)"),
        "RemoteDesktop": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "ScreenCast": ("umbriel", "xdg-desktop-portal-umbriel"),
        "Screenshot": ("umbriel", "xdg-desktop-portal-umbriel"),
        "Secret": ("oo7-portal", "krytis /etc delta (#1028)"),
        "Settings": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Usb": ("none", "neither umbriel nor gtk implements it (#1029)"),
        "Wallpaper": ("none", "neither umbriel nor gtk implements it (#1029)"),
    },
}

PREFIX = "org.freedesktop.impl.portal."
USING = re.compile(r"Using (\S+)\.portal for org\.freedesktop\.impl\.portal\.(\w+)")
SECTION = re.compile(r"^@@(DESKTOP|PORTAL|CONF) (.+)$")


def probe(tag):
    """One container: xdp --verbose per desktop, every .portal file, every routing file."""
    script = f"""
for d in {' '.join(EXPECTED)}; do
    echo "@@DESKTOP $d"
    XDG_CURRENT_DESKTOP=$d timeout {XDP_SECONDS} dbus-run-session -- \\
        /usr/libexec/xdg-desktop-portal --verbose 2>&1
done
for f in /usr/share/xdg-desktop-portal/portals/*.portal; do
    echo "@@PORTAL $f"
    cat "$f"
done
for f in /usr/share/xdg-desktop-portal/*-portals.conf /etc/xdg/xdg-desktop-portal/*-portals.conf; do
    [ -e "$f" ] || continue
    echo "@@CONF $f"
    cat "$f"
done
"""
    return subprocess.run(["podman", "run", "--rm", "--entrypoint", "sh", tag, "-c", script],
                          check=True, capture_output=True, text=True).stdout


def parse(out):
    """Return {"DESKTOP": {name: lines}, "PORTAL": {path: lines}, "CONF": {path: lines}}."""
    sections, current = {"DESKTOP": {}, "PORTAL": {}, "CONF": {}}, None
    for line in out.splitlines():
        m = SECTION.match(line)
        if m:
            current = sections[m.group(1)].setdefault(m.group(2), [])
        elif current is not None:
            current.append(line)
    return sections


def implements(portals):
    """backend name -> interfaces its .portal file declares."""
    impls = {}
    for path, lines in portals.items():
        name = os.path.basename(path).removesuffix(".portal")
        impls[name] = {i[len(PREFIX):] for line in lines if line.startswith("Interfaces=")
                       for i in line[11:].split(";") if i.startswith(PREFIX)}
    return impls


def preferred(lines):
    """The [preferred] group of a portals.conf as {key: [backend, …]}."""
    group, keys = None, {}
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            group = line
        elif group == "[preferred]" and "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            keys[key.strip()] = [b.strip() for b in value.split(";") if b.strip()]
    return keys


def resolve_in(conf, iface, impls):
    """What one portals.conf alone resolves iface to; None means it falls through.
    Mirrors xdp_portal_config_find's per-file steps (desktop.md § xdg-desktop-portal routing)."""
    own, default = conf.get(PREFIX + iface), conf.get("default", [])
    if "none" in (own if own is not None else default):
        return "none"
    for backend in (own or []) + default:
        if iface in impls.get(backend, ()):
            return backend
    return None


def check_redundant(confs, impls):
    """Fail on an /etc delta key the upstream /usr/share file already resolves the same way."""
    ok = True
    for path, lines in sorted(confs.items()):
        if not path.startswith("/etc/"):
            continue
        upstream = confs.get("/usr/share/xdg-desktop-portal/" + os.path.basename(path))
        if upstream is None:
            continue
        upstream = preferred(upstream)
        for key in preferred(lines):
            if not key.startswith(PREFIX):
                continue
            iface = key[len(PREFIX):]
            ours = resolve_in(preferred(lines), iface, impls)
            if ours is not None and resolve_in(upstream, iface, impls) == ours:
                print(f"  REDUNDANT: {path}: {iface}={ours} — upstream's file now says the same;"
                      " delete the key")
                ok = False
    return ok


def check_desktop(desktop, lines, universe):
    ok = True
    if not any("Using portal configuration file" in l for l in lines):
        print(f"  NO CONFIG: xdp loaded no portals.conf for {desktop} (legacy UseIn= fallback)")
        ok = False

    got = {}
    for line in lines:
        m = USING.search(line)
        if m:
            got.setdefault(m.group(2), set()).add(m.group(1))

    expected = EXPECTED[desktop]
    for iface in sorted(universe):
        backends = got.get(iface, {"none"})
        if iface not in expected:
            print(f"  UNCLASSIFIED: {iface} → {'/'.join(sorted(backends))} has no row")
            ok = False
            continue
        want, why = expected[iface]
        if backends != {want}:
            print(f"  MISMATCH: {iface}: expected {want} ({why}), got {'/'.join(sorted(backends))}")
            ok = False
    print(f"    {sum(1 for i in universe if got.get(i))} of {len(universe)} interface(s) served")
    return ok


def main():
    os.chdir(subprocess.run(["git", "rev-parse", "--show-toplevel"], check=True,
                            capture_output=True, text=True).stdout.strip())
    tag = os.environ.get("usage_tag") or "localhost/krytis:latest"

    print(f"==> Resolving portal routing in {tag}")
    sections = parse(probe(tag))
    xdp, portals, confs = sections["DESKTOP"], sections["PORTAL"], sections["CONF"]
    print(f"    backends: {', '.join(sorted(os.path.basename(p) for p in portals))}")
    print(f"    routing files: {', '.join(sorted(confs))}")

    ok = True
    errors = sorted({l.split("Error loading ", 1)[1]
                     for lines in xdp.values() for l in lines if "Error loading " in l})
    for e in errors:
        print(f"  UNPARSABLE: {e}")
        ok = False

    impls = implements(portals)
    ok &= check_redundant(confs, impls)

    universe = set().union(*impls.values())
    for desktop in EXPECTED:
        print(f"==> XDG_CURRENT_DESKTOP={desktop}")
        ok &= check_desktop(desktop, xdp.get(desktop, []), universe | set(EXPECTED[desktop]))

    if ok:
        print("==> portal-routing-check passed.")
        return
    print("==> portal-routing-check FAILED. Each line above names its fix; a deliberate"
          " routing change updates its row in mise/tasks/portal-routing-check in the same"
          " commit. See docs/skills/desktop.md § xdg-desktop-portal routing.")
    sys.exit(1)


if __name__ == "__main__":
    main()
