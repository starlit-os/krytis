#!/usr/bin/env bash
#MISE description="Boot bootable.raw in QEMU (native KVM+UEFI) or qemux/qemu-docker fallback"
#USAGE flag "--disk <path>" default="bootable.raw" help="Disk image to boot"
#USAGE flag "--secure" help="Boot with OVMF secure boot enabled (requires 'mise run generate-ovmf-vars' first)"
#USAGE flag "--display <type>" help="QEMU -display backend. Default: first of gtk, sdl, none that this qemu actually supports"

set -euo pipefail

DISK="${usage_disk:-bootable.raw}"
SECURE="${usage_secure:-}"
WANT_DISPLAY="${usage_display:-}"

if [ ! -e "${DISK}" ]; then
    echo "ERROR: ${DISK} not found — run 'mise run generate-disk' first." >&2
    exit 1
fi

DISK=$(realpath "${DISK}")

if command -v qemu-system-x86_64 &>/dev/null; then
    echo "==> Using native qemu-system-x86_64..."

    # elements/dev/qemu.bst builds qemu --disable-gtk --disable-sdl
    # --disable-vnc --disable-spice --disable-curses, so on a krytis host the
    # ONLY backends are `none` and `dbus`. This task used to hardcode
    # `-display gtk`, which made it fail outright with the unhelpful
    # "Parameter 'type' does not accept value 'gtk'". Negotiate against what
    # the binary reports instead of assuming. See docs/skills/bootc-vm.md
    # § boot-vm is headless on a krytis host.
    qemu_displays() {
        qemu-system-x86_64 -display help 2>/dev/null \
            | sed -n '/^Available display backend types:/,/^$/p' \
            | tail -n +2 | sed '/^$/d'
    }

    if [ -n "${WANT_DISPLAY}" ]; then
        if ! qemu_displays | grep -qx -- "${WANT_DISPLAY}"; then
            echo "ERROR: this qemu does not support -display ${WANT_DISPLAY}." >&2
            echo "       Supported here: $(qemu_displays | tr '\n' ' ')" >&2
            echo "       A graphical backend needs elements/dev/qemu.bst rebuilt with" >&2
            echo "       --enable-gtk (or --enable-vnc); it currently disables all of them." >&2
            exit 1
        fi
        DISPLAY_TYPE="${WANT_DISPLAY}"
    else
        DISPLAY_TYPE=""
        for cand in gtk sdl none; do
            if qemu_displays | grep -qx -- "${cand}"; then
                DISPLAY_TYPE="${cand}"
                break
            fi
        done
        if [ -z "${DISPLAY_TYPE}" ]; then
            echo "ERROR: qemu reports no usable -display backend (not even 'none')." >&2
            exit 1
        fi
    fi

    . scripts/ovmf-paths.sh   # distro OVMF layout, one place (#458)
    if [ "${SECURE}" = "true" ]; then
        OVMF_CODE=$(ovmf_code_secboot) || exit 1
        OVMF_VARS=".ovmf-vars-secure.fd"
        if [ ! -e "${OVMF_VARS}" ]; then
            echo "ERROR: ${OVMF_VARS} not found — run 'mise run generate-ovmf-vars' first." >&2
            exit 1
        fi
        MACHINE_ARGS="q35,smm=on"
        FLASH_SECURE_ARGS=(-global driver=cfi.pflash01,property=secure,value=on)
    else
        OVMF_CODE=$(ovmf_code_plain) || exit 1

        OVMF_VARS=".ovmf-vars.fd"
        if [ ! -e "${OVMF_VARS}" ]; then
            OVMF_VARS_SRC=$(ovmf_vars_plain) || exit 1
            cp "${OVMF_VARS_SRC}" "${OVMF_VARS}"
        fi
        # q35, not qemu's default `pc` — see the same comment in boot-test and
        # #414: distro edk2's OvmfPkgX64 build emits no serial output at all on
        # i440fx and never boots. smm=on is only needed for --secure.
        MACHINE_ARGS="q35"
        FLASH_SECURE_ARGS=()
    fi

    echo "==> Booting ${DISK}"
    echo "    RAM: ${VM_RAM}M  CPUs: ${VM_CPUS}  Firmware: ${OVMF_CODE}  Secure boot: ${SECURE:-false}"
    echo "    SSH forward: localhost:2222 → guest:22"
    echo "    Display: ${DISPLAY_TYPE}"
    echo "    Serial console on stdio (ttyS0) — Ctrl-A x to quit QEMU"
    if [ "${DISPLAY_TYPE}" = "none" ]; then
        echo ""
        echo "    No graphical backend in this qemu build, so there is no window to type"
        echo "    into. The VGA console still exists on the virtio-vga device — drive it"
        echo "    over the HMP monitor (Ctrl-A c toggles serial/monitor on stdio):"
        echo "      sendkey ctrl-alt-f5          # switch the guest to VT5"
        echo "      screendump /tmp/vt.ppm       # then: magick /tmp/vt.ppm /tmp/vt.png"
        echo "    sendkey needs one QEMU key name per character and can drop them, so"
        echo "    screendump after each batch. See docs/skills/bootc-vm.md."
    fi
    echo ""

    qemu-system-x86_64 \
        -enable-kvm \
        -m "${VM_RAM}" \
        -cpu host \
        -smp "${VM_CPUS}" \
        ${MACHINE_ARGS:+-machine "${MACHINE_ARGS}"} \
        "${FLASH_SECURE_ARGS[@]}" \
        -drive "file=${DISK},format=raw,if=virtio" \
        -drive "if=pflash,format=raw,readonly=on,file=${OVMF_CODE}" \
        -drive "if=pflash,format=raw,file=${OVMF_VARS}" \
        -device virtio-vga \
        -display "${DISPLAY_TYPE}" \
        -device virtio-keyboard \
        -device virtio-mouse \
        -device virtio-net-pci,netdev=net0 \
        -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22" \
        -chardev stdio,id=char0,mux=on,signal=off \
        -serial chardev:char0 \
        -serial chardev:char0 \
        -mon chardev=char0

else
    if [ "${SECURE}" = "true" ]; then
        echo "ERROR: --secure requires native qemu-system-x86_64 (q35+SMM) — the qemux/qemu-docker fallback doesn't support it." >&2
        exit 1
    fi
    echo "==> qemu-system-x86_64 not found, falling back to ghcr.io/qemus/qemu..."

    PORT=8006
    while ss -tunalp 2>/dev/null | grep -q ":${PORT}"; do
        PORT=$(( PORT + 1 ))
    done
    echo "==> Web/VNC at http://localhost:${PORT}"
    xdg-open "http://localhost:${PORT}" &>/dev/null || true

    podman run \
        --rm --privileged \
        --device /dev/kvm \
        --pull=always \
        --publish "127.0.0.1:${PORT}:8006" \
        --publish "127.0.0.1:2222:22" \
        -e "USER_PORTS=22" \
        -e "NETWORK=user" \
        -e "CPU_CORES=${VM_CPUS}" \
        -e "RAM_SIZE=${VM_RAM}M" \
        -e "TPM=y" \
        -e "BOOT_MODE=uefi" \
        -e "ARGUMENTS=-snapshot" \
        -v "${DISK}:/boot.img" \
        ghcr.io/qemus/qemu:latest
fi
