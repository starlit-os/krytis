#!/usr/bin/env python3
#MISE description="Update seance element to the latest GitHub release"
#MISE hide=true
"""Regenerate elements/desktop/seance.bst from upstream's release tarball.

seance vendors ghostty as a git submodule, so its dependency graph spans several
build.zig.zon files (the project's own, ghostty's, and ghostty's nested pkg/*),
plus the zon files inside downloaded deps. `mise/lib/zig_zon.py` walks that whole
closure; this task only knows where seance's releases live.

Usage:
    mise run seance-update                # bump to the latest release
    mise run seance-update -- --regenerate  # re-resolve deps at the pinned version
"""

import re
import sys
import subprocess
import tarfile
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

import zig_zon  # noqa: E402

ELEMENT = Path("elements/desktop/seance.bst")
ZIG_ELEMENT = Path("elements/desktop/zig-0.16.bst")
REPO = "no1msd/seance"
UA = "seance-update/1.0"


def src_url(version: str) -> str:
    return (
        f"https://github.com/{REPO}/releases/download/"
        f"v{version}/seance-{version}-src.tar.gz"
    )


def latest_version() -> str:
    out = subprocess.run(
        ["gh", "api", f"repos/{REPO}/releases/latest", "--jq", ".tag_name"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    if not out:
        sys.exit(f"ERROR: no release found for {REPO}")
    return out.lstrip("v")


def current_version() -> str:
    # Scope to the url: line — a version in a comment matches the same regex
    # and head-of-file wins (see docs/skills/bst.md § One shared updater).
    for line in ELEMENT.read_text().splitlines():
        if not line.lstrip().startswith("url:"):
            continue
        m = re.search(r"/seance-(\S+?)-src\.tar\.gz", line)
        if m:
            return m.group(1)
    sys.exit(f"ERROR: could not find the source tarball url: line in {ELEMENT}")


def main() -> None:
    regenerate = "--regenerate" in sys.argv[1:]

    cur_ver = current_version()
    new_ver = cur_ver if regenerate else latest_version()

    if regenerate:
        print(f"==> Regenerating dep closure at pinned version {cur_ver}")
    else:
        print(f"==> Latest: v{new_ver}  Current: v{cur_ver}")
        if new_ver == cur_ver:
            print(f"==> Already up to date ({cur_ver})")
            return

    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)

        print("==> Downloading source tarball...")
        src_file = tmpdir / f"seance-{new_ver}-src.tar.gz"
        zig_zon.download(src_url(new_ver), src_file, UA)
        src_sha = zig_zon.sha256_file(src_file)
        print(f"    sha256={src_sha}")

        print("==> Collecting build.zig.zon files from the source tree...")
        zon_texts: list[str] = []
        min_zig: str | None = None
        with tarfile.open(src_file, "r:gz") as tf:
            for member in tf.getmembers():
                if not member.name.endswith("build.zig.zon"):
                    continue
                with tf.extractfile(member) as f:
                    text = f.read().decode(errors="replace")
                zon_texts.append(text)
                print(f"      {member.name}")
                # The project's own zon is the one that gates the toolchain.
                if member.name.count("/") == 1 and min_zig is None:
                    m = re.search(r'\.minimum_zig_version\s*=\s*"([^"]+)"', text)
                    if m:
                        min_zig = m.group(1)
        if not zon_texts:
            sys.exit("ERROR: no build.zig.zon found in the source tarball")

        print("==> Resolving transitive dep closure...")
        entries = zig_zon.resolve_closure(zon_texts, tmpdir, UA)
        print(f"    {len(entries)} deps")

    aliased_src = zig_zon.apply_alias(src_url(new_ver))
    new_sources = zig_zon.render_sources(
        (aliased_src, src_sha), entries,
        "seance source tarball (vendors the ghostty submodule)",
        base_dir="seance-*",
    )
    ELEMENT.write_text(zig_zon.replace_sources_block(ELEMENT.read_text(), new_sources))
    print(f"==> Updated {ELEMENT}: {cur_ver} → {new_ver} ({len(entries)} deps)")

    if min_zig:
        mz = re.search(r"zig-x86_64-linux-([0-9]+\.[0-9]+\.[0-9]+)\.tar", ZIG_ELEMENT.read_text())
        cur_zig = mz.group(1) if mz else None
        if cur_zig and tuple(map(int, cur_zig.split("."))) < tuple(map(int, min_zig.split("."))):
            print(
                f"==> WARNING: {ZIG_ELEMENT} has {cur_zig} but seance {new_ver} requires"
                f" minimum_zig_version={min_zig}."
            )

    print("==> Done. Run 'mise run validate' to verify.")


if __name__ == "__main__":
    main()
