#!/usr/bin/env bash
#MISE description="Update include/image-version.yml from git history; run before builds in CI"
#MISE hide=true

# The stamp names the last commit that changed what goes into the image, not
# HEAD. core/os-release.bst and oci/os-release.bst bake it in, so a stamp that
# moved with every commit gave the top of the graph (os-release, initramfs and
# the oci/krytis/* assembly elements) a new cache key on every docs-, CI- or
# task-only commit. Stamped this way, a commit that touches none of the paths
# below keeps main's keys, so its build is a full cache hit.
#
# IMAGE_INPUTS: the BuildStream graph (load-image's `sources` list, with all
# of include/: image-version.yml is gitignored, so git log never sees it), the
# Containerfiles that build the linted and sealed images, and the BuildStream
# install (pyproject.toml/uv.lock). Extend it when the image gains an input; a
# missing path lets a real change ship under the previous version.
#
# --first-parent: without it, git log looks through a merge to the PR's own
# commit, whose date can be older than an earlier merge, so the version could
# stall or go backwards. On main this picks the merge commit itself.

# Tasks run from config_root by default, so relative paths resolve to the project root.
set -euo pipefail
IMAGE_INPUTS=(elements files patches project.conf include Containerfile Containerfile.seal-uki pyproject.toml uv.lock)

SDK_VERSION=$(grep '^\s*branch:\s' project.conf | awk '{print $2}')

# A shallow clone (actions/checkout's default depth 1) makes its oldest commit
# look like it added every path, so the search below would stop at HEAD. Stamp
# HEAD outright there, which is the old behaviour, and say so. Workflows whose
# keys must match local builds and bow (cache-warm, publish, bench-cold-build)
# fetch full history instead.
if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
    echo "==> WARNING: shallow clone; stamping HEAD, not the last image-changing commit. Fetch full history (fetch-depth: 0) for a stamp that matches other builds." >&2
    STAMP_COMMIT=$(git rev-parse HEAD)
else
    STAMP_COMMIT=$(git log -1 --first-parent --format=%H HEAD -- "${IMAGE_INPUTS[@]}")
fi
: "${STAMP_COMMIT:?no commit touches the image inputs; is this a krytis checkout?}"

IMAGE_VERSION=$(git log -1 --format=%cd --date=format:%Y%m%d%H%M "$STAMP_COMMIT")
cat > include/image-version.yml <<EOF
# Generated by \`mise run generate-image-version\`. Do not edit by hand.
image-version: '${SDK_VERSION}.${IMAGE_VERSION}'
commit: '${STAMP_COMMIT}'
EOF
echo "==> Updated include/image-version.yml: ${SDK_VERSION}.${IMAGE_VERSION} @ ${STAMP_COMMIT:0:12}"
