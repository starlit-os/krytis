#!/usr/bin/env bash
#MISE description="Reclaim disk from stale build scratch, orphaned VM scratch, and dangling images (see #416, #913)"
#USAGE flag "--dry-run" help="Report what would be freed and delete nothing"
#USAGE flag "--yes" help="Skip the safety pause and delete immediately"
#USAGE flag "--min-age <hours>" default="24" help="Only reap VM scratch whose mtime is older than this many hours"
#USAGE flag "--install-scratch" help="Also remove /sysroot/.fisherman-scratch, the ISO installer's leftover container store (needs sudo)"

# Why this exists: BuildStream derives its CAS quota from the *filesystem*
# (buildbox-casd --quota-low=80% --reserved=46.5G), so a nearly-full disk makes
# builds fail to stage even when BST's own cache is small. The error names a
# quota, which misleads:
#
#   Error capturing "." in ".../cas/staging/cas-tmpdir...":
#     Out of space error in merklize() for path ".":
#     OutOfSpaceException ... errMsg = "Insufficient storage quota"
#
# When that bit, ~/.cache/buildstream was 27G and /var was at 94% from debris
# this task removes. See docs/skills/bst.md § Reclaiming disk when a build hits
# "Insufficient storage quota".
set -euo pipefail

DRY_RUN="${usage_dry_run:-}"
ASSUME_YES="${usage_yes:-}"
MIN_AGE_HOURS="${usage_min_age:-24}"
WITH_INSTALL="${usage_install_scratch:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)         DRY_RUN=true; shift ;;
        --yes)             ASSUME_YES=true; shift ;;
        --min-age)         MIN_AGE_HOURS="$2"; shift 2 ;;
        --install-scratch) WITH_INSTALL=true; shift ;;
        *) break ;;
    esac
done

if ! [[ "${MIN_AGE_HOURS}" =~ ^[0-9]+$ ]]; then
    echo "ERROR: --min-age takes whole hours, got '${MIN_AGE_HOURS}'" >&2
    exit 2
fi

# ── Safety: never run alongside a live build ──────────────────────────────────
# /var/tmp/buildah* belongs to an *in-flight* podman build while it exists;
# deleting it mid-build corrupts that build. bst is included because its
# staging dirs and CAS are equally live. This guard is the whole reason the
# task exists rather than a documented one-liner — the same class of mistake as
# deleting a running boot-test's WORKDIR (docs/skills/bootc-vm.md).
LIVE=$(pgrep -a -f 'buildah|bst |buildstream' 2>/dev/null | grep -v 'buildbox-casd' | grep -v 'clean-cache' || true)
if [ -n "${LIVE}" ]; then
    echo "ERROR: refusing to run — a build appears to be in flight:" >&2
    echo "${LIVE}" | sed 's/^/    /' >&2
    echo "  /var/tmp/buildah* belongs to running builds. Wait for it to finish." >&2
    exit 1
fi

human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0}B"; }

# Allocated blocks, never apparent size. /var/tmp/krytis-install.img is a 64G
# sparse file that held 23G when this was written: reporting apparent size
# would promise 41G of reclaim that does not exist.
disk_bytes() { du -s --block-size=1 --total "$@" 2>/dev/null | tail -1 | cut -f1; }

echo "==> Disk before:"
df -h /var | tail -1 | sed 's/^/    /'

# ── 1. Stale build scratch ────────────────────────────────────────────────────
# Interrupted `podman build` runs leave per-build temp dirs behind; nothing
# reaps them. Oldest seen in practice was three weeks old.
SCRATCH=()
for d in /var/tmp/buildah* /var/tmp/container_images_oci*; do
    [ -e "$d" ] && SCRATCH+=("$d")
done

# `du` must not be allowed to kill this task. buildah creates its per-build
# `mnt` dir mode d--x------ (traverse, no read) and leaves it behind; `du` then
# exits 1 on it, `pipefail` propagates that, and `set -e` aborts — *after* the
# assignment, so the run ended at "Disk before:" with no message and exit 1.
# The reclaim path failed silently in exactly the situation it exists for: a
# disk too full to build. Measure tolerantly and say so if the total is partial;
# the delete path below restores the read bit before removing anything.
SCRATCH_BYTES=0
SCRATCH_PARTIAL=""
if [ ${#SCRATCH[@]} -gt 0 ]; then
    if ! SCRATCH_BYTES=$(disk_bytes "${SCRATCH[@]}"); then
        SCRATCH_PARTIAL="; partial, some unreadable until deletion"
    fi
    SCRATCH_BYTES="${SCRATCH_BYTES:-0}"
    echo "==> Stale build scratch in /var/tmp ($(human "${SCRATCH_BYTES}") across ${#SCRATCH[@]} dirs${SCRATCH_PARTIAL}):"
    for d in "${SCRATCH[@]}"; do
        printf '    %-44s %s\n' "$d" "$(stat -c %y "$d" | cut -d. -f1)"
    done
else
    echo "==> Stale build scratch in /var/tmp: none"
fi

# ── 2. Orphaned VM scratch ───────────────────────────────────────────────────
# boot-test and enroll-test rm -rf their own WORKDIR from an EXIT trap, so a
# leftover means the run was SIGKILLed, the host crashed, or --debug-keep held
# it for a post-mortem. Each carries a 15G disk image; three of them, eight days
# old, were sitting in 48G of /var/tmp debris on a dev box while this task
# reclaimed 13G of buildah dirs beside them (#913).
#
# iso-boot-live's disks differ in kind: it creates them only when absent
# (`truncate -s 64G`) and otherwise *reuses* them, which is how a live-ISO
# install is handed to `iso-boot-installed`. Reaping one throws away that
# install, not just garbage — so the age gate is the safety, and the next
# iso-boot-live run starts from an empty disk.
#
# The name list, not a blanket `krytis-*`, is what bounds this to our own
# debris — /var/tmp also holds systemd-private-* dirs and whatever else a user
# parked there. The cost of that choice is that the list has to track every
# disk a task can produce, and it silently did not: `generate-disk --disk` and
# `boot-vm` write `.raw`, and naming one after the PR under test
# (`/var/tmp/krytis-802.raw`) is the established way to hand-verify a branch,
# per `docs/skills/workflow.md`. Two of those, 23G between them, sat through
# every clean-cache run on a dev box for two weeks — and were still invisible
# on the run where an ISO build beside them pushed /var to 96% and this task
# reported nothing left to reclaim (#944). `krytis-luks-boot.*`, luks-boot-test's
# WORKDIR, was missing for the same reason. Add the pattern here when you add a
# task that creates scratch; the Update-path gate for elements has no analogue
# for this one.
VM_SCRATCH=()
VM_IN_USE=()
# /proc cmdlines are world-readable, so this sees other users' VMs too.
CMDLINES=$(ps -eo args= 2>/dev/null || true)
while IFS= read -r -d '' p; do
    # An open path is not stale however old its mtime: qemu creates the disk up
    # front and then writes only through its own fd, so mtime stops advancing
    # while the VM runs. boot-test line 374 records what deleting one costs —
    # qemu survives on its open fds, orphaned, with no pidfile left to kill it
    # by. The age gate alone would not catch a long-running VM; this does.
    if printf '%s\n' "${CMDLINES}" | grep -Fq -- "$p"; then
        VM_IN_USE+=("$p")
    else
        VM_SCRATCH+=("$p")
    fi
done < <(find /var/tmp -maxdepth 1 \
    \( -name 'krytis-boot-test.*' -o -name 'krytis-enroll-test.*' \
       -o -name 'krytis-luks-boot.*' \
       -o -name 'krytis-*.img' -o -name 'krytis-*.raw' \
       -o -name 'krytis-qemu-*-vars.fd' \) \
    -mmin "+$((MIN_AGE_HOURS * 60))" -print0 2>/dev/null)

if [ ${#VM_SCRATCH[@]} -gt 0 ]; then
    VM_BYTES=$(disk_bytes "${VM_SCRATCH[@]}" || true)
    echo "==> Orphaned VM scratch older than ${MIN_AGE_HOURS}h ($(human "${VM_BYTES:-0}") across ${#VM_SCRATCH[@]} paths):"
    for p in "${VM_SCRATCH[@]}"; do
        printf '    %-44s %s\n' "$p" "$(stat -c %y "$p" | cut -d. -f1)"
    done
else
    echo "==> Orphaned VM scratch older than ${MIN_AGE_HOURS}h: none"
fi
if [ ${#VM_IN_USE[@]} -gt 0 ]; then
    echo "==> VM scratch skipped — open in a running process:"
    printf '    %s\n' "${VM_IN_USE[@]}"
fi

# ── 3. Dangling images ───────────────────────────────────────────────────────
# Untagged, unreachable layers — mostly superseded krytis:{latest,sealed,
# sealed-base} generations, ~7G per build+seal-uki cycle. Tagged images are
# never touched.
DANGLING=$(podman images --filter dangling=true -q 2>/dev/null | wc -l)
RECLAIMABLE=$(podman system df --format '{{.Reclaimable}}' 2>/dev/null | head -1 || true)
echo "==> Dangling images: ${DANGLING} (podman reports ${RECLAIMABLE:-unknown} reclaimable across all images)"

# ── 4. Installer scratch ─────────────────────────────────────────────────────
# fisherman — the ISO's bootc installer — works in /sysroot/.fisherman-scratch:
# a throwaway root podman store (containers-root/) plus the oci-cache it pulled
# the payload into, and a var-tmp-override it bind-mounts over /var/tmp to get
# room during the install. All three are write-once. On a machine installed in
# August they were still sitting there in September, 9.6G, every timestamp
# inside the four minutes the install took, referenced by no unit, no mount and
# no process (#913).
#
# Opt-in, because reclaiming it is not just a sudo away: bootc mounts /sysroot
# **read-only**, so `rm -rf` there returns EROFS on every single file. Freeing
# it means remounting the OS root rw, which is a decision for the operator, not
# for a cache-cleaning task — so this reports the exact incantation and stops.
INSTALL_SCRATCH=/sysroot/.fisherman-scratch
SYSROOT_RO=""
case "$(findmnt -rno OPTIONS /sysroot 2>/dev/null)" in ro | ro,*) SYSROOT_RO=true ;; esac
if [ -d "${INSTALL_SCRATCH}" ]; then
    # Root-owned and mode 700, so a rootless `du` cannot size it. Don't prompt
    # for a password just to print a number — say so instead.
    IS_BYTES=$(sudo -n du -s --block-size=1 "${INSTALL_SCRATCH}" 2>/dev/null | cut -f1 || true)
    if [ -n "${IS_BYTES}" ]; then
        echo "==> Installer scratch: ${INSTALL_SCRATCH} ($(human "${IS_BYTES}"), installed $(stat -c %y "${INSTALL_SCRATCH}" | cut -d' ' -f1))"
    else
        echo "==> Installer scratch: ${INSTALL_SCRATCH} (size needs sudo)"
    fi
    if [ "${WITH_INSTALL}" != "true" ]; then
        echo "    kept — pass --install-scratch to remove it"
    elif [ -n "${SYSROOT_RO}" ]; then
        echo "    /sysroot is mounted read-only — bootc keeps it that way, and rm returns"
        echo "    EROFS on every file. Remounting the OS root rw is your call, not this"
        echo "    task's. To do it by hand:"
        echo "        sudo mount -o remount,rw /sysroot \\"
        echo "          && sudo rm -rf ${INSTALL_SCRATCH} \\"
        echo "          && sudo mount -o remount,ro /sysroot"
    fi
fi

# ── Never touched ────────────────────────────────────────────────────────────
# The systemd-buildbarn-storage-{cas,ac,fsac} and -asset-cache volumes (~70G)
# are the Buildbarn cache that `mise bst --pull` and cache-warm.yml depend on.
# Pruning them is a self-inflicted cache miss for the whole project, so this
# task never prunes volumes and never prunes tagged images.
echo "==> NOT touching: podman volumes (Buildbarn cache), tagged images, ~/.cache/buildstream,"
echo "    VM scratch newer than ${MIN_AGE_HOURS}h or open in a running process,"
echo "    the root podman store (its krytis:latest is tagged, and generate-disk re-copies it)"

if [ "${DRY_RUN}" = "true" ]; then
    echo "==> --dry-run: nothing deleted."
    exit 0
fi

if [ "${ASSUME_YES}" != "true" ]; then
    echo "==> Deleting in 5s — Ctrl-C to abort (or re-run with --dry-run)..."
    sleep 5
fi

if [ ${#SCRATCH[@]} -gt 0 ]; then
    echo "==> Removing stale build scratch..."
    # `rm -rf` cannot enumerate a d--x------ directory either, so it would fail
    # on buildah's leftover `mnt` and — under set -e — abort before the image
    # prune below. These dirs are ours (lily:lily, just with the read bit
    # stripped), so restoring it needs no sudo. Done here rather than at
    # measurement time so --dry-run stays free of side effects.
    chmod -R u+rwX "${SCRATCH[@]}" 2>/dev/null || true
    if ! rm -rf "${SCRATCH[@]}"; then
        echo "    WARNING: some scratch could not be removed; continuing to the" >&2
        echo "             image prune so the run still reclaims what it can." >&2
    fi
fi

if [ ${#VM_SCRATCH[@]} -gt 0 ]; then
    echo "==> Removing orphaned VM scratch..."
    rm -rf "${VM_SCRATCH[@]}"
fi

echo "==> Pruning dangling images..."
podman image prune -f

# Runs after the image prune, and never aborts the task: this step is opt-in,
# touches the OS root, and must not cost the caller the reclaim they came for.
if [ "${WITH_INSTALL}" = "true" ] && [ -z "${SYSROOT_RO}" ] && [ -d "${INSTALL_SCRATCH}" ]; then
    # A half-finished install still holds var-tmp-override bind-mounted over
    # /var/tmp; pulling the backing directory out from under a live installer
    # is the boot-test-WORKDIR mistake with the OS image at stake.
    INSTALL_LIVE=$(pgrep -a -f 'fisherman|bootc install' 2>/dev/null | grep -v 'clean-cache' || true)
    if [ -n "${INSTALL_LIVE}" ] || findmnt -rno TARGET | grep -q "^${INSTALL_SCRATCH}"; then
        echo "    WARNING: installer scratch is in use — skipping:" >&2
        echo "${INSTALL_LIVE}" | sed 's/^/        /' >&2
    else
        echo "==> Removing installer scratch (sudo)..."
        sudo rm -rf "${INSTALL_SCRATCH}" || echo "    WARNING: installer scratch not fully removed" >&2
    fi
fi

echo "==> Disk after:"
df -h /var | tail -1 | sed 's/^/    /'

# The root podman store is invisible to rootless `podman system df`, and
# `bootc install` copies every image there via generate-disk. Nothing in this
# task reclaims it; report it so the number is at least visible.
if sudo -n true 2>/dev/null; then
    echo "==> Root podman store (not pruned by this task):"
    sudo podman system df 2>/dev/null | sed 's/^/    /' || true
else
    echo "==> Root podman store not measured (needs sudo). generate-disk copies images"
    echo "    there for bootc install; check with: sudo podman system df"
fi
