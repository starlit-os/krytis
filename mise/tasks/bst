#!/usr/bin/env bash
#MISE description="Run any bst command (native uv venv by default; --container for podman)"
#MISE depends=["generate-image-version"]
#USAGE flag "--container" help="Use the pinned bst2 podman container instead of native BST"
#USAGE flag "--push" help="Wire krytis's bow Buildbarn cache with push+pull access (BUILDBARN_PUSH_TOKEN env var or fnox)"
#USAGE flag "--pull" help="Wire krytis's bow Buildbarn cache with pull-only access (BUILDBARN_PULL_TOKEN env var or fnox)"
#USAGE arg "<args>" var=#true help="bst subcommand and arguments (e.g. build stacks/base-system.bst)"

# BST_FLAGS: appended to default flags; BST_FLAGS_OVERRIDE: replaces all defaults.
# BST_CACHE_QUOTA: cap the local CAS for this run (e.g. 50G). Unset = no cap
# from this task: BuildStream uses whatever the user's own config says, or its
# default (no quota, 5% of the disk kept free). See docs/skills/mise.md § BST
# CAS quota for why the task no longer picks a size itself (#1507).
set -euo pipefail

DEFAULT_FLAGS="-o x86_64_v3 true --no-interactive"
BST_CACHE_QUOTA="${BST_CACHE_QUOTA:-}"
# The krytis-vps runner is a systemd service with no HOME in its environment.
# Bash's `~` and BuildStream (Python's expanduser) both fall back to the passwd
# entry there, so resolve it the same way rather than die under `set -u`.
HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"

if [ -n "${BST_FLAGS_OVERRIDE:-}" ]; then
    FLAGS="${BST_FLAGS_OVERRIDE}"
else
    FLAGS="${DEFAULT_FLAGS} ${BST_FLAGS:-}"
fi

# usage_container/usage_push/usage_pull are set by mise when invoked directly
# (and inherited by child processes, so a parent task like validate may also
# set them). When a parent task passes one of these as a literal first arg to
# this script, consume it here regardless — mise already stripped it from $@
# for the direct-invocation case. See docs/skills/mise.md § Propagating flags
# through tasks that call other tasks.
CONTAINER="${usage_container:-false}"
PUSH="${usage_push:-false}"
PULL="${usage_pull:-false}"
while [ "${1:-}" = "--container" ] || [ "${1:-}" = "--push" ] || [ "${1:-}" = "--pull" ]; do
    case "$1" in
        --container) CONTAINER=true ;;
        --push) PUSH=true ;;
        --pull) PULL=true ;;
    esac
    shift
done

# BST_CONTAINER=true in .mise.local.toml [env] is the workstation-wide default for
# machines without native BST host deps. Explicit --container (above) always wins.
if [ "$CONTAINER" != "true" ] && [ "${BST_CONTAINER:-false}" = "true" ]; then
    CONTAINER=true
fi

if [ "$PUSH" = "true" ] && [ "$PULL" = "true" ]; then
    echo "ERROR: --push and --pull are mutually exclusive — a push-capable bow connection already serves reads." >&2
    exit 1
fi

# Wire krytis's bow Buildbarn cache when --push/--pull is requested. Neither
# flag -> no remote cache for krytis's own elements at all: project.conf
# declares none since #942/#954, and the junctions' caches serve only their own
# elements. bow is deliberately never declared in project.conf either — see
# docs/skills/ci-runner.md and cache-warm.yml.
# BST_CONFIG is the temporary config passed as `bst --config`, written only when
# this run needs settings of its own (bow, BST_CACHE_QUOTA). On the native path
# it is layered over the user's default config, because --config replaces that
# file rather than merging with it (scripts/bst-merge-user-config.py).
BOW_CONFIG=""
BOW_TOKEN_FILE=""
cleanup_bow() {
    local rc=$?
    [ -n "$BOW_TOKEN_FILE" ] && rm -f "$BOW_TOKEN_FILE"
    [ -n "$BOW_CONFIG" ] && rm -f "$BOW_CONFIG"
    exit "$rc"
}
trap cleanup_bow EXIT

if [ "$PUSH" = "true" ] || [ "$PULL" = "true" ]; then
    if [ "$PUSH" = "true" ]; then
        ROLE="push"; TOKEN_VAR="BUILDBARN_PUSH_TOKEN"
    else
        ROLE="pull"; TOKEN_VAR="BUILDBARN_PULL_TOKEN"
    fi

    TOKEN="${!TOKEN_VAR:-}"
    if [ -z "$TOKEN" ]; then
        if command -v fnox >/dev/null 2>&1 && [ -f fnox.toml ]; then
            TOKEN=$(fnox get "$TOKEN_VAR") || {
                echo "ERROR: fnox get ${TOKEN_VAR} failed. Set ${TOKEN_VAR} directly or fix fnox/pass-cli auth." >&2
                exit 1
            }
        else
            echo "ERROR: ${TOKEN_VAR} not set and fnox is not configured. Export ${TOKEN_VAR} or set up fnox.toml." >&2
            exit 1
        fi
    fi

    BOW_TOKEN_FILE=$(mktemp)
    chmod 600 "$BOW_TOKEN_FILE"
    printf '%s' "$TOKEN" > "$BOW_TOKEN_FILE"

    PUSH_BOOL=$([ "$ROLE" = "push" ] && echo true || echo false)
    BOW_CONFIG=$(mktemp)
    chmod 600 "$BOW_CONFIG"
    cat > "$BOW_CONFIG" <<EOF
build:
  max-jobs: 4
artifacts:
  servers:
  - url: https://bst-cache.werewolf-stonecat.ts.net:7981
    type: index
    push: ${PUSH_BOOL}
    auth:
      server-cert: __CERT_PATH__
      access-token: __TOKEN_PATH__
  - url: https://bst-cache.werewolf-stonecat.ts.net:7982
    type: storage
    push: ${PUSH_BOOL}
    auth:
      server-cert: __CERT_PATH__
      access-token: __TOKEN_PATH__
source-caches:
  servers:
  - url: https://bst-cache.werewolf-stonecat.ts.net:7981
    type: index
    push: ${PUSH_BOOL}
    auth:
      server-cert: __CERT_PATH__
      access-token: __TOKEN_PATH__
  - url: https://bst-cache.werewolf-stonecat.ts.net:7982
    type: storage
    push: ${PUSH_BOOL}
    auth:
      server-cert: __CERT_PATH__
      access-token: __TOKEN_PATH__
EOF

    # Fail now if bow is not reachable (#1113). BuildStream only WARNS when it
    # cannot initialise a remote ("Failed to initialize remote …: UNAVAILABLE")
    # and then carries on without it, so every artifact missing locally is built
    # from source — freedesktop-sdk's toolchain included, hours of work the
    # Toolchain Gate (AGENTS.md) exists to stop. On 2026-10-06 a `build --pull`
    # started while bow was briefly down and was compiling gcc-stage2 before
    # anyone noticed. The probe retries transient UNAVAILABLE for about a minute
    # and fails at once on an auth error. It runs where bst will run: the
    # project venv natively, or the bst2 image under --container (same grpc and
    # BuildStream protos either way). It cannot see bow dropping in the seconds
    # between this check and bst's own remote initialisation.
    PROBE=(scripts/bow-artifact-check.py --probe bst-cache.werewolf-stonecat.ts.net:7981 bst-cache.werewolf-stonecat.ts.net:7982)
    if [ "$CONTAINER" = "true" ]; then
        PROBE_CMD=(podman run --rm --network=host -e BOW_TOKEN -v "$(pwd):/src:ro" -w /src
            "${BST2_IMAGE}" python3 "${PROBE[@]}" /src/quadlet/buildbarn/certs/bow-server.crt)
    else
        PROBE_CMD=(uv run --quiet python3 "${PROBE[@]}" quadlet/buildbarn/certs/bow-server.crt)
    fi
    if ! BOW_TOKEN="$TOKEN" "${PROBE_CMD[@]}" >/dev/null; then
        echo "ERROR: --${ROLE} was requested but bow (bst-cache.werewolf-stonecat.ts.net) cannot be used (reason above)." >&2
        echo "       Not starting bst: without bow it would build everything missing locally from source." >&2
        echo "       Retry once bow is back, or drop --${ROLE} to build deliberately without it." >&2
        exit 1
    fi
fi

# An explicit BST_CACHE_QUOTA applies with or without bow. Without one, no
# `cache:` key is written, so a --pull/--push run caps the cache exactly as a
# flagless run does: by the user's own config, or not at all.
if [ -n "$BST_CACHE_QUOTA" ]; then
    if [ -z "$BOW_CONFIG" ]; then
        BOW_CONFIG=$(mktemp)
        chmod 600 "$BOW_CONFIG"
    fi
    printf 'cache:\n  quota: %s\n' "$BST_CACHE_QUOTA" >> "$BOW_CONFIG"
fi

if [ "$CONTAINER" = "true" ]; then
    mkdir -p "${HOME}/.cache/buildstream"
    EXTRA_MOUNTS=()
    CONFIG_ARGS=()
    if [ -n "$BOW_CONFIG" ]; then
        sed -i 's#__CERT_PATH__#/src/quadlet/buildbarn/certs/bow-server.crt#; s#__TOKEN_PATH__#/run/secrets/buildbarn-token#' "$BOW_CONFIG"
        EXTRA_MOUNTS=(-v "${BOW_CONFIG}:/run/secrets/buildstream-bow.conf:ro" -v "${BOW_TOKEN_FILE}:/run/secrets/buildbarn-token:ro")
        CONFIG_ARGS=(--config /run/secrets/buildstream-bow.conf)
    fi
    # word-splitting on FLAGS is intentional (space-separated option flags)
    # shellcheck disable=SC2086
    # Not exec'd: the bow temp token/config files (if any) must be cleaned up
    # by the trap below, which exec would bypass by replacing this process.
    podman run --rm \
        --privileged \
        --device /dev/fuse \
        --network=host \
        --memory "${BST_MEMORY_LIMIT}" \
        -v "$(pwd):/src:rw" \
        -v "${HOME}/.cache/buildstream:/root/.cache/buildstream:rw" \
        "${EXTRA_MOUNTS[@]}" \
        -w /src \
        "${BST2_IMAGE}" \
        bst --colors "${CONFIG_ARGS[@]}" ${FLAGS} "$@"
    exit $?
fi

# Native path. Nothing is written to the user's own config: an earlier version
# appended a quota to ~/.config/buildstream/user.conf, a file BuildStream never
# reads (it reads buildstream2.conf, then buildstream.conf; #1507).
CONFIG_ARGS=()
if [ -n "$BOW_CONFIG" ]; then
    sed -i "s#__CERT_PATH__#$(pwd)/quadlet/buildbarn/certs/bow-server.crt#; s#__TOKEN_PATH__#${BOW_TOKEN_FILE}#" "$BOW_CONFIG"
    uv run --quiet python3 scripts/bst-merge-user-config.py "$BOW_CONFIG"
    CONFIG_ARGS=(--config "$BOW_CONFIG")
fi

# Not exec'd here either, for the same reason as the container path above.
# shellcheck disable=SC2086
uv run bst --colors "${CONFIG_ARGS[@]}" ${FLAGS} "$@"
exit $?
