#!/usr/bin/env bash
#MISE description="Assert --luks-offline-discard=no stops a homed image stranding btrfs space across logins, and that the default does strand it (#1646)"
#USAGE flag "--image <tag>" default="localhost/krytis:latest" help="Local image tag to install and boot"
#USAGE flag "--reuse-disk <path>" help="Boot a copy of this already-installed raw disk instead of running generate-disk (skips the only step that needs root)"
#USAGE flag "--cycles <n>" default="4" help="Activate/churn/deactivate cycles per home"
#USAGE flag "--keep" help="Keep WORKDIR (disk copy, serial log, keys, measurements) and print its path"

# What this proves, on a booted krytis VM whose root is btrfs (generate-disk's
# default), the same layout as a real install:
#
#   1. CONTROL: a homed LUKS2 home with systemd's default offline discard
#      (`LUKS Discard: online=no offline=yes`) strands space in the host btrfs.
#      Each cycle writes files, deletes every other one and logs out. Logout
#      discards the scattered free ranges; the next login fallocates them back
#      into new extents, while the punched-through old ones stay pinned. Its
#      stranded bytes must grow. If they don't, this VM doesn't reproduce
#      #1646 and the test proves nothing, so that is a FAIL, not a pass.
#   2. FIX: a home created with the first-boot wizard's flags, which include
#      --luks-offline-discard=no, goes through the same churn and must not:
#      no "Discarded unused" from systemd-homework, and stranded bytes stay
#      flat.
#
# Each measurement is taken after logout, with the control's image punched, so
# its "stranded" is exactly what the next login will allocate on top of the
# image's size.
#
# Stranding is invisible to du/stat/ls (the file's size and allocated blocks
# never change). It is measured with mise/tasks/homed-image-check, copied into
# the guest, which reads the extent tree the way compsize does.
#
# Provisioning follows homed-ssh-fallback-test: SMBIOS credentials only, the
# installed disk is never mutated, and only generate-disk needs root.

# shellcheck disable=SC2015  # pass() cannot fail, so `A && pass || fail` is a true if/else
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

CLI_IMAGE=""; CLI_REUSE_DISK=""; CLI_CYCLES=""; CLI_KEEP=""
while [ $# -gt 0 ]; do
    case "$1" in
        --image)      CLI_IMAGE="$2"; shift 2 ;;
        --reuse-disk) CLI_REUSE_DISK="$2"; shift 2 ;;
        --cycles)     CLI_CYCLES="$2"; shift 2 ;;
        --keep)       CLI_KEEP=true; shift ;;
        *) break ;;
    esac
done
IMAGE="${CLI_IMAGE:-${usage_image:-localhost/krytis:latest}}"
REUSE_DISK="${CLI_REUSE_DISK:-${usage_reuse_disk:-}}"
CYCLES="${CLI_CYCLES:-${usage_cycles:-4}}"
KEEP="${CLI_KEEP:-${usage_keep:-}}"

case "${CYCLES}" in ''|*[!0-9]*) echo "ERROR: --cycles must be a number" >&2; exit 1 ;; esac
[ "${CYCLES}" -ge 2 ] || { echo "ERROR: --cycles must be at least 2" >&2; exit 1; }
if [ -n "${REUSE_DISK}" ] && [ ! -f "${REUSE_DISK}" ]; then
    echo "ERROR: --reuse-disk file not found: ${REUSE_DISK}" >&2
    exit 1
fi
command -v qemu-system-x86_64 >/dev/null || { echo "ERROR: qemu-system-x86_64 not found." >&2; exit 1; }

CONTROL_USER="discardcontrol"
FIX_USER="discardfix"
# The control home differs from the fix home in exactly one flag.
HOME_MIB=1024
COMMON_FLAGS="--auto-resize-mode=off --rebalance-weight=off --disk-size=${HOME_MIB}M"
# Each cycle: 16 x 24 MiB written, every other file deleted. The deleted half
# is 192 MiB of free space in 24 MiB pieces, scattered through the data.
FILES=16
FILE_MIB=24
# Thresholds. The control must strand at least STRAND_MIN_MIB over the run;
# the fix may differ from its first measurement by at most FLAT_MAX_MIB.
STRAND_MIN_MIB=64
FLAT_MAX_MIB=16

TEST_PASS="$(python3 -c 'import secrets; print(secrets.token_urlsafe(18))')"

WORKDIR=$(mktemp -d /var/tmp/krytis-homed-discard-test.XXXXXX)
DISK="${WORKDIR}/test.raw"

QEMU_PID=""
cleanup() {
    [ -n "${QEMU_PID}" ] && kill "${QEMU_PID}" 2>/dev/null || true
    if [ -n "${KEEP}" ]; then
        echo "==> WORKDIR kept at ${WORKDIR}"
    else
        rm -rf "${WORKDIR}"
    fi
}
trap cleanup EXIT
trap 'echo "==> ABORTED at line ${LINENO}: ${BASH_COMMAND}" >&2' ERR

ssh-keygen -t ed25519 -N '' -C 'krytis homed-discard-test root' -f "${WORKDIR}/id_root" -q

if [ -n "${REUSE_DISK}" ]; then
    echo "==> [1/5] Copying ${REUSE_DISK} (no install, no root)..."
    cp --reflink=auto "${REUSE_DISK}" "${DISK}"
else
    echo "==> [1/5] Installing ${IMAGE} → ${DISK}..."
    ./mise/tasks/generate-disk --image "${IMAGE}" --disk "${DISK}" --size 15G
fi

echo "==> [2/5] Booting headless with sshd enabled for this boot only..."
printf '[Unit]\nWants=sshd.service\n' > "${WORKDIR}/mu-dropin.conf"
cat > "${WORKDIR}/sshd-dropin.conf" <<'DROPIN'
[Service]
ImportCredential=krytis.homedtest_root_keys
ExecStart=
ExecStart=/usr/bin/sshd -D -o "AuthorizedKeysFile .ssh/authorized_keys ${CREDENTIALS_DIRECTORY}/krytis.homedtest_root_keys"
DROPIN
# No GPU here, and the greeter compositor free-spins without one (#764).
printf '[Service]\nExecStart=\nExecStart=/usr/bin/true\nRestart=no\n' > "${WORKDIR}/greetd-dropin.conf"

cred_b64() { base64 -w0 < "$1"; }
. scripts/ovmf-paths.sh   # #458
OVMF_CODE=$(ovmf_code_plain)
cp "$(ovmf_vars_plain)" "${WORKDIR}/vars.fd"

launch_qemu() {
    qemu-system-x86_64 \
        -enable-kvm -m "${VM_RAM:-8192}" -cpu host -smp "${VM_CPUS:-4}" \
        -machine q35 \
        -drive "file=${DISK},format=raw,if=virtio" \
        -drive "if=pflash,format=raw,readonly=on,file=${OVMF_CODE}" \
        -drive "if=pflash,format=raw,file=${WORKDIR}/vars.fd" \
        -device virtio-net-pci,netdev=net0 \
        -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22" \
        -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.multi-user.target=$(cred_b64 "${WORKDIR}/mu-dropin.conf")" \
        -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.sshd.service=$(cred_b64 "${WORKDIR}/sshd-dropin.conf")" \
        -smbios "type=11,value=io.systemd.credential.binary:systemd.unit-dropin.greetd.service=$(cred_b64 "${WORKDIR}/greetd-dropin.conf")" \
        -smbios "type=11,value=io.systemd.credential.binary:krytis.homedtest_root_keys=$(cred_b64 "${WORKDIR}/id_root.pub")" \
        -display none \
        -serial "file:${WORKDIR}/serial.log" \
        -daemonize -pidfile "${WORKDIR}/qemu.pid"
}
. scripts/qemu-hostfwd.sh   # #1373
qemu_launch_hostfwd 2422 launch_qemu
QEMU_PID=$(cat "${WORKDIR}/qemu.pid")

SSH_OPTS=(-p "${SSH_PORT}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
          -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=5)
ROOT() { timeout 600 ssh "${SSH_OPTS[@]}" -o LogLevel=ERROR -i "${WORKDIR}/id_root" root@localhost "$@"; }

UP=false
DEADLINE=$((SECONDS + 300))
while [ "${SECONDS}" -lt "${DEADLINE}" ]; do
    if timeout 10 ssh "${SSH_OPTS[@]}" -i "${WORKDIR}/id_root" root@localhost true 2>/dev/null; then
        UP=true; break
    fi
    sleep 3
done
if [ "${UP}" != true ]; then
    echo "==> FAIL: root SSH never came up within 300s — nothing about homed was tested." >&2
    tail -40 "${WORKDIR}/serial.log" >&2 || true
    exit 1
fi
ROOT 'systemctl --version | head -1; findmnt -n -o FSTYPE /var' | sed 's/^/    /' || true
[ "$(ROOT 'findmnt -n -o FSTYPE --target /var/home')" = btrfs ] \
    || { echo "==> FAIL: /var/home in the guest is not btrfs; #1646 cannot occur there" >&2; exit 1; }

ROOT 'cat > /run/homed-image-check && chmod +x /run/homed-image-check' < mise/tasks/homed-image-check

echo "==> [3/5] Creating ${CONTROL_USER} (systemd default discard) and ${FIX_USER} (first-boot wizard flags)..."
# FIX_USER's flags are the wizard's (files/systemd-firstboot/firstboot-wizard.sh)
# except --disk-size, which is fixed small so two homes fit and churn is quick.
# Both images are allocated in full at every login (the control's after each
# logout's discard), so the guest needs room for both plus the stranding.
# statvfs, not df: the guest's df is uutils, which has no -m/--output.
FREE_MIB=$(ROOT "python3 -c 'import os; s = os.statvfs(\"/var/home\"); print(s.f_bavail * s.f_frsize >> 20)'")
echo "    guest /var/home free: ${FREE_MIB} MiB"
[ "${FREE_MIB}" -ge $((HOME_MIB * 3)) ] \
    || { echo "==> FAIL: guest has ${FREE_MIB} MiB free, need $((HOME_MIB * 3)) for two ${HOME_MIB} MiB homes plus stranding (generate-disk --size)" >&2; exit 1; }
printf '%s' "${TEST_PASS}" | ROOT "NEWPASSWORD=\$(cat) homectl create ${CONTROL_USER} ${COMMON_FLAGS}" \
    || { echo "==> FAIL: homectl create ${CONTROL_USER} failed" >&2; exit 1; }
printf '%s' "${TEST_PASS}" | ROOT "NEWPASSWORD=\$(cat) homectl create ${FIX_USER} ${COMMON_FLAGS} --luks-offline-discard=no" \
    || { echo "==> FAIL: homectl create ${FIX_USER} failed" >&2; exit 1; }

FAILED=0
pass() { echo "    PASS  $1"; }
fail() { echo "    FAIL  $1" >&2; FAILED=1; }

discard_line() { ROOT "homectl inspect $1 | sed -n 's/^ *LUKS Discard: //p'"; }
[ "$(discard_line "${CONTROL_USER}")" = "online=no offline=yes" ] \
    && pass "${CONTROL_USER}: LUKS Discard: online=no offline=yes (systemd default)" \
    || fail "${CONTROL_USER}: LUKS Discard is '$(discard_line "${CONTROL_USER}")', want the default online=no offline=yes"
[ "$(discard_line "${FIX_USER}")" = "online=no offline=no" ] \
    && pass "${FIX_USER}: LUKS Discard: online=no offline=no" \
    || fail "${FIX_USER}: LUKS Discard is '$(discard_line "${FIX_USER}")', want online=no offline=no"

# One cycle as root in the guest: activate, replace the previous cycle's files
# with FILES new ones, delete every other one, deactivate. Reads the password on
# stdin. Prints the number of "Discarded unused" lines homework logged during
# the cycle, then the checker's JSON for the image.
ROOT 'cat > /run/homed-churn && chmod +x /run/homed-churn' <<'GUEST'
#!/bin/bash
set -euo pipefail
u=$1; files=$2; mib=$3
start=$(date +%s)
PASSWORD=$(cat) homectl activate "$u" >/dev/null
h=$(homectl inspect "$u" | sed -n 's/^ *Directory: //p')
img=$(homectl inspect "$u" | sed -n 's/^ *Image Path: //p')
rm -f "$h"/churn.*
for i in $(seq 0 $((files - 1))); do head -c "${mib}M" /dev/urandom > "$h/churn.$i"; done
sync -f "$h"
for i in $(seq 0 2 $((files - 1))); do rm "$h/churn.$i"; done
sync -f "$h"
homectl deactivate "$u"
sleep 1
journalctl -q -t systemd-homework -S "@$start" --no-pager | grep -c 'Discarded unused' || true
/run/homed-image-check --json --max-overhead 1000000 "$img"
GUEST

declare -A DISCARDS STRANDED_FIRST STRANDED_LAST ONDISK_FIRST ONDISK_LAST
run_cycles() {
    local u=$1 n out discards json stranded on_disk
    DISCARDS[$u]=0
    for n in $(seq 1 "${CYCLES}"); do
        out=$(printf '%s' "${TEST_PASS}" | ROOT "/run/homed-churn $u ${FILES} ${FILE_MIB}") \
            || { fail "$u: cycle $n failed"; return; }
        discards=$(printf '%s\n' "${out}" | sed -n 1p)
        json=$(printf '%s\n' "${out}" | sed -n 2p)
        printf '%s\n' "${json}" >> "${WORKDIR}/$u.jsonl"
        stranded=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["stranded"])' "${json}")
        on_disk=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["on_disk"])' "${json}")
        DISCARDS[$u]=$(( ${DISCARDS[$u]} + discards ))
        [ "$n" -eq 1 ] && { STRANDED_FIRST[$u]=${stranded}; ONDISK_FIRST[$u]=${on_disk}; }
        STRANDED_LAST[$u]=${stranded}; ONDISK_LAST[$u]=${on_disk}
        printf '    %-15s cycle %d: discards %d, on disk %5d MiB, stranded %5d MiB\n' \
            "$u" "$n" "${discards}" $((on_disk >> 20)) $((stranded >> 20))
    done
}

echo "==> [4/5] ${CYCLES} cycles each of: log in, write ${FILES} x ${FILE_MIB} MiB, delete every other file, log out..."
run_cycles "${CONTROL_USER}"
run_cycles "${FIX_USER}"

echo "==> [5/5] Assertions..."
MIB=$((1 << 20))
if [ -n "${STRANDED_LAST[${CONTROL_USER}]:-}" ]; then
    [ "${DISCARDS[${CONTROL_USER}]}" -ge "${CYCLES}" ] \
        && pass "${CONTROL_USER}: homework discarded on every logout (${DISCARDS[${CONTROL_USER}]} times)" \
        || fail "${CONTROL_USER}: only ${DISCARDS[${CONTROL_USER}]} discards in ${CYCLES} logouts; the control is not exercising offline discard"
    [ "${STRANDED_LAST[${CONTROL_USER}]}" -ge $((STRAND_MIN_MIB * MIB)) ] \
        && pass "${CONTROL_USER}: stranded $((STRANDED_LAST[${CONTROL_USER}] >> 20)) MiB (>= ${STRAND_MIN_MIB}): the VM reproduces #1646" \
        || fail "${CONTROL_USER}: stranded only $((STRANDED_LAST[${CONTROL_USER}] >> 20)) MiB (< ${STRAND_MIN_MIB}); this VM does not reproduce #1646, so the fix result means nothing"
fi
if [ -n "${STRANDED_LAST[${FIX_USER}]:-}" ]; then
    [ "${DISCARDS[${FIX_USER}]}" -eq 0 ] \
        && pass "${FIX_USER}: no offline discard in ${CYCLES} logouts" \
        || fail "${FIX_USER}: homework discarded ${DISCARDS[${FIX_USER}]} times despite --luks-offline-discard=no"
    growth=$(( STRANDED_LAST[${FIX_USER}] - STRANDED_FIRST[${FIX_USER}] ))
    disk_growth=$(( ONDISK_LAST[${FIX_USER}] - ONDISK_FIRST[${FIX_USER}] ))
    [ "${growth#-}" -le $((FLAT_MAX_MIB * MIB)) ] && [ "${disk_growth#-}" -le $((FLAT_MAX_MIB * MIB)) ] \
        && pass "${FIX_USER}: stranded and on-disk usage flat across cycles (changed $((growth >> 20)) / $((disk_growth >> 20)) MiB, limit ${FLAT_MAX_MIB})" \
        || fail "${FIX_USER}: stranded changed $((growth >> 20)) MiB and on-disk $((disk_growth >> 20)) MiB across cycles (limit ${FLAT_MAX_MIB})"
fi

if [ "${FAILED}" -ne 0 ]; then
    echo "    --- guest journal: systemd-homed + systemd-homework ---" >&2
    ROOT "journalctl -b --no-pager -o short-monotonic -u systemd-homed -t systemd-homework | tail -60" 2>/dev/null | sed 's/^/    | /' >&2 || true
fi
ROOT systemctl poweroff >/dev/null 2>&1 || true

if [ "${FAILED}" -ne 0 ]; then
    echo "==> homed-discard-test FAILED"
    exit 1
fi
echo "==> homed-discard-test PASSED"
