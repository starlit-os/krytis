#!/usr/bin/env bash
#MISE description="generate-image-version + load-image + lint + umbriel-config-validate + cracklib-dict-check + portal-routing-check — full local build pipeline"
#USAGE flag "--container" help="Use the bst2 podman container instead of native BST"
#USAGE flag "--push" help="Wire krytis's bow Buildbarn cache with push+pull access"
#USAGE flag "--pull" help="Wire krytis's bow Buildbarn cache with pull-only access"
#USAGE flag "--force" help="Reload into podman even if oci/krytis/image.bst's cache key hasn't changed"

set -euo pipefail
CONTAINER=${usage_container:+--container}
PUSH=${usage_push:+--push}
PULL=${usage_pull:+--pull}
FORCE=${usage_force:+--force}

# No explicit generate-image-version call here: ./mise/tasks/load-image
# (below) already raw-calls it itself as its own first action (added so
# load-image works correctly when run standalone — see docs/skills/mise.md
# § Calling other tasks). Since build always calls load-image next with
# nothing in between, an explicit call here would just regenerate the exact
# same include/image-version.yml content twice in one invocation.
./mise/tasks/load-image ${CONTAINER:-} ${PUSH:-} ${PULL:-} ${FORCE:-}
./mise/tasks/lint
# Cheap (~2s, no GPU/seat/root) and it needs exactly what lint just produced.
# Runs here because nothing else connected files/umbriel/config.toml to the
# umbriel binary shipped beside it, and desktop/umbriel.bst is ref-bumped
# daily — see docs/skills/desktop.md § Validating the shipped Umbriel config.
./mise/tasks/umbriel-config-validate
# Same cost class (~1s, one podman run). fdsdk's cracklib integration command
# exits 0 with no dictionary when gzip is not staged beside it, and nothing
# else notices — see docs/skills/bst.md § An integration command's tools are
# not implied by the element that ships it (krytis#1001).
./mise/tasks/cracklib-dict-check
# Same cost class (~10s, one podman run). Portal routing changes with every
# niri bump and every daily xdg-desktop-portal-umbriel bump, and a wrong route
# is invisible until a Flatpak misbehaves — see docs/skills/desktop.md
# § xdg-desktop-portal routing (krytis#1027).
./mise/tasks/portal-routing-check
