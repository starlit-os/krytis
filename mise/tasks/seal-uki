#!/usr/bin/env bash
#MISE description="Build a signed UKI + signed systemd-boot via the Containerfile"
set -euo pipefail

# Ensure keys are present (pull from Proton Pass if configured)
if [ ! -f files/boot-keys/db.key ]; then
    mise run pull-keys
fi

# NOTE ON ENGINE VERSIONS — do not re-add a minimum-version check here without
# evidence. #524 added `podman >= 5` on the theory that the two-phase squash was
# only ever verified on 5.x. That was wrong: every sealed image this project has
# published was built on a hosted runner with **podman 4.9.3 / buildah 1.33.7**
# (GitHub's ubuntu-24.04 image, which Blacksmith mirrors), and the 2026-08-04
# artifact built there passed `tpm-boot-test`, `luks-install-test`,
# `iso-install-test --secure` and `selfenroll-test` — the first of which boots
# that exact UKI, so a wrong composefs digest could not have passed.
#
# 4.9.3 and 5.8.2 both produce a correct sealed image. The engine-sensitivity of
# the squash is real, but the way to catch a bad digest is to CHECK THE DIGEST
# (#528), not to guess at version numbers. Phase [3/3] below
# (mise/tasks/verify-composefs-digest) is that check — it runs on every
# seal-uki invocation, engine-agnostic, and fails loudly naming both digests
# on a real mismatch instead of guessing from a version number.

# Two-phase build — see Containerfile.seal-uki's header comment and
# docs/skills/secure-boot.md § `bootc container ukify` must run in a
# throwaway stage / § `--composefs-backend` requires a single layer, but
# squashing breaks the UKI digest for the full reasoning. Short version:
# `--composefs-backend` requires a single-layer image (multi-layer fails
# with "Unexpected EOF in splitstream", matching dakota#841), but squashing
# changes /tmp and /var/tmp mtimes, which breaks the UKI's baked composefs=
# digest if squashing happens after ukify runs. So: squash first (producing
# a stable reference), compute the digest against that already-squashed
# reference, then squash again for the final image — verified to produce a
# matching digest AND a single-layer image.

echo "==> [1/3] Building + squashing sealed rootfs -> localhost/krytis:sealed-base..."
podman build --squash-all --target sealed -t localhost/krytis:sealed-base \
    --build-arg SEAL_SECURE_BOOT=true \
    --secret id=db_key,src=files/boot-keys/db.key \
    --secret id=db_crt,src=files/boot-keys/db.crt \
    --secret id=kek_key,src=files/boot-keys/KEK.key \
    --secret id=kek_crt,src=files/boot-keys/KEK.crt \
    --secret id=pk_key,src=files/boot-keys/PK.key \
    --secret id=pk_crt,src=files/boot-keys/PK.crt \
    -f Containerfile .

# `bootc container ukify` computes the composefs digest through a temporary
# repository it creates with `tempfile::tempdir_in("/var/tmp")` — hardcoded, so
# TMPDIR is ignored (bootc crates/lib/src/bootc_composefs/digest.rs:28). Objects
# are ingested with O_TMPFILE, which fuse-overlayfs does not implement, so on a
# runner whose podman falls back to fuse-overlayfs the build dies with:
#
#   Computing composefs digest: ... Creating object tmpfile:
#     Opening temp file in objects directory: Operation not supported (os error 95)
#
# It passes on a workstation only because podman there uses native kernel
# overlayfs. composefs-rs 5a227a0 adds a named-tmpfile fallback, but that is not
# in any bootc release yet — bootc-dev/bootc#2340. Until it ships, give the build
# a /var/tmp on a filesystem that does support O_TMPFILE.
#
# Disk, not tmpfs: the object store is a full copy of the rootfs (6.5 GB measured),
# which is a plausible OOM on a runner and merely a rounding error on disk. Created
# under /var/tmp so it is on-disk on both CachyOS (btrfs) and the runners (ext4);
# /tmp is tmpfs on some hosts, which would reintroduce the memory cost.
UKI_TMP="$(mktemp -d -p /var/tmp krytis-ukify-XXXXXX)"
trap 'rm -rf "${UKI_TMP}"' EXIT

# Fail here rather than 30 seconds into the build if this filesystem is no better
# than the one we are working around (e.g. /var/tmp itself on overlayfs).
if ! python3 -c '
import os, sys
try:
    os.close(os.open(sys.argv[1], os.O_TMPFILE | os.O_RDWR, 0o600))
except OSError as exc:
    sys.exit(f"{exc.strerror} (errno {exc.errno})")
' "${UKI_TMP}"; then
    echo "==> ERROR: ${UKI_TMP} does not support O_TMPFILE, which bootc's composefs" >&2
    echo "    digest step requires. Point it at a directory on ext4/xfs/btrfs/tmpfs." >&2
    exit 1
fi

echo "==> [2/3] Building UKI against sealed-base -> localhost/krytis:sealed..."
podman build --squash-all -t localhost/krytis:sealed \
    --build-arg SEAL_SECURE_BOOT=true \
    --secret id=db_key,src=files/boot-keys/db.key \
    --secret id=db_crt,src=files/boot-keys/db.crt \
    -v "${UKI_TMP}:/var/tmp" \
    -f Containerfile.seal-uki .

echo "==> [3/3] Verifying baked composefs digest against the committed image (#528)..."
./mise/tasks/verify-composefs-digest --image localhost/krytis:sealed

echo "==> Sealed image built and verified: localhost/krytis:sealed"
