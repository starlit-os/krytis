#!/usr/bin/env bash
#MISE description="Install Krytis from a live ISO in QEMU and assert the installed system boots (secure boot optional)"
#USAGE flag "--iso <path>" help="ISO to install from. Default: output/krytis-live-sealed.iso under --secure, output/krytis-live.iso otherwise"
#USAGE flag "--secure" help="Boot the INSTALLED disk with secure boot enforced (requires 'mise run generate-ovmf-vars'). The live ISO always boots unsigned — it is not signed by design (#371)"
#USAGE flag "--expect-fail" help="Invert the result: the installed system MUST be rejected by secure boot (negative test)"
#USAGE flag "--payload-ref <ref>" help="Payload image ref for the fisherman recipe. Default: matches the ISO variant"
#USAGE flag "--payload-image <ref>" help="Image the ISO is expected to embed. Default: localhost/krytis:sealed. Must match build-iso's --payload-image when the ISO was built around a published image"

set -euo pipefail

# boot-test covers the image→disk install path (`bootc install to-disk`).
# This covers the ISO→fisherman→disk path, which is the only one that exercises
# the offline VFS store, the live installer's recipe.json, and targetImgref —
# i.e. everything `mise run build-iso --sealed` actually changes.
#
# The two phases deliberately run under DIFFERENT firmware:
#   phase 1  live ISO      → plain OVMF. The live ISO is unsigned by design
#                            (#371 Design Gate); enforcing here would be a
#                            guaranteed false negative, not a test.
#   phase 2  installed disk → enforcement + krytis's enrolled PK/KEK/db, under
#                            --secure. Without --secure it boots plain, which is
#                            the "sealed payload must still be a valid ordinary
#                            image" case.
# QEMU/fisherman orchestration is in iso-e2e-test (scripts/iso-install-fisherman.sh
# + mise/tasks/iso-boot-{live,installed}). The verdict for sealed payloads is
# delegated to boot-test, which provisions sshd via SMBIOS type-11 credentials
# — the only mechanism that works on a sealed system whose cmdline is frozen.

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

SECURE=$([[ "${usage_secure:-}" == "true" ]] && echo 1 || echo 0)
EXPECT_FAIL=$([[ "${usage_expect_fail:-}" == "true" ]] && echo 1 || echo 0)

# Mode-dependent defaults are resolved here, not in the #USAGE annotations: a
# `default=` there is indistinguishable from the user typing the same value, so
# an explicit --iso could not override it. Same reasoning as boot-test's --image.
if [[ "${SECURE}" -eq 1 && "${EXPECT_FAIL}" -eq 0 ]]; then
    DEFAULT_ISO="output/krytis-live-sealed.iso"
    DEFAULT_REF="ghcr.io/starlit-os/krytis:sealed"
else
    DEFAULT_ISO="output/krytis-live.iso"
    DEFAULT_REF="ghcr.io/starlit-os/krytis:latest"
fi

ISO="${usage_iso:-${DEFAULT_ISO}}"
PAYLOAD_REF="${usage_payload_ref:-${DEFAULT_REF}}"
INSTALL_DISK="/var/tmp/krytis-install.img"

# Every prerequisite is checked before QEMU starts. An install run is tens of
# minutes; discovering a missing varstore or the wrong ISO at minute 30 is the
# failure mode this block exists to prevent.
if [[ ! -f "${ISO}" ]]; then
    echo "ERROR: ISO not found: ${ISO}" >&2
    echo "       Build it:  mise run build-iso$([[ "${SECURE}" -eq 1 && "${EXPECT_FAIL}" -eq 0 ]] && echo ' --sealed') --debug" >&2
    exit 1
fi

# boot-test owns the varstore (it copies the enrolled original to scratch before
# booting), so only its existence is checked here — fail before the install, not
# after it.
if [[ "${SECURE}" -eq 1 ]]; then
    if [[ ! -f ".ovmf-vars-secure.fd" ]]; then
        echo "ERROR: .ovmf-vars-secure.fd missing — run 'mise run generate-ovmf-vars' first." >&2
        exit 1
    fi
    # The installed system must carry the sealed payload, or "boots under
    # enforcement" is being asserted about the wrong artifact. verify-iso-payload
    # is seconds and exact; skip it for --expect-fail, whose ISO is unsigned on
    # purpose.
    if [[ "${EXPECT_FAIL}" -eq 0 ]]; then
        echo "==> Confirming ${ISO} carries the sealed payload..."
        ./mise/tasks/verify-iso-payload --iso "${ISO}" \
            --image "${usage_payload_image:-localhost/krytis:sealed}"
    fi
fi

if ! command -v qemu-system-x86_64 &>/dev/null && ! command -v qemu-kvm &>/dev/null; then
    echo "ERROR: needs qemu-system-x86_64 or qemu-kvm on the host." >&2
    exit 1
fi

# The install is driven over SSH into the live session, which needs two things
# that only a --debug ISO has: sshd enabled, and password auth re-enabled.
# Krytis is pubkey-only by policy (/etc/ssh/sshd_config.d/10-krytis-auth.conf,
# both PasswordAuthentication and KbdInteractiveAuthentication set to no), so a
# production ISO refuses the installer's login with "Permission denied
# (publickey)" — and because the readiness probe IS an ssh login, the harness
# reports a flat timeout minutes later that reads like a boot or network fault.
DEBUG_DROPIN="etc/ssh/sshd_config.d/05-live-debug.conf"
SFS_OFFSET="$(python3 scripts/iso-squashfs-offset.py "${ISO}")"
if ! unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${DEBUG_DROPIN}" >/dev/null 2>&1; then
    echo "ERROR: ${ISO} has no ${DEBUG_DROPIN} in its live session — it was built" >&2
    echo "       without --debug, or predates the live-debug SSH override (#371)." >&2
    echo "       Krytis's pubkey-only sshd will refuse the installer's password login," >&2
    echo "       so this run would stall until the readiness probe times out." >&2
    echo "  Rebuild it:  mise run build-iso$([[ "${SECURE}" -eq 1 && "${EXPECT_FAIL}" -eq 0 ]] && echo ' --sealed') --debug" >&2
    exit 1
fi

ISO_ABS="$(realpath "${ISO}")"

echo "==> Installing Krytis from an ISO in QEMU"
echo "    iso:         ${ISO_ABS}"
echo "    payload:     ${PAYLOAD_REF}"
echo "    secure:      ${SECURE} (installed disk; the live ISO always boots unsigned)"
echo "    expect-fail: ${EXPECT_FAIL}"

# Phase 1-2 only: boot the live ISO and run the installer. The verdict is NOT
# delegated to iso-e2e-test's phase 4, because iso-verify-boot greps for
# "Reached target Graphical Interface" on the serial console — and a sealed
# system can never produce that. Its kernel cmdline is frozen inside the signed
# UKI, so `console=ttyS0` cannot be injected, the kernel logs to tty0 only,
# and serial output ends at systemd-stub's verified-chain confirmation. See
# docs/skills/secure-boot.md § sealed UKI serial output.
# `env -u` is load-bearing: mise exports THIS task's parsed flags as usage_*,
# and every child process inherits them (docs/skills/mise.md § `usage_container`
# is inherited by child processes). iso-e2e-test and boot-test carry flags of
# the same names, and their argc-fallback reads an inherited
# usage_expect_fail=true exactly as if --expect-fail had been passed — so
# `mise run iso-install-test --secure --expect-fail` died on iso-e2e-test's
# "--expect-fail is incompatible with --install-only" guard before any VM
# booted. Both children get every flag they need explicitly.
set +e
env -u usage_secure -u usage_expect_fail \
    "${REPO_ROOT}/mise/tasks/iso-e2e-test" \
    --iso "${ISO_ABS}" \
    --payload-ref "${PAYLOAD_REF}" \
    --install-only
RESULT=$?
set -e

if [[ "${RESULT}" -ne 0 ]]; then
    echo "==> FAILED during install (exit ${RESULT}). Serial logs from the run:" >&2
    ls -la /tmp/krytis-qemu-*serial*.log 2>/dev/null >&2 || true
    exit "${RESULT}"
fi

[[ -f "${INSTALL_DISK}" ]] || { echo "ERROR: installer reported success but ${INSTALL_DISK} is missing." >&2; exit 1; }

# boot-test is the verdict engine: it provisions sshd, an authorized key and a
# diagnostics probe as SMBIOS type-11 systemd credentials, which systemd reads
# with no kernel argument involved — so it works on a sealed system whose cmdline
# cannot be touched. It also already owns the OVMF secboot selection (smm=on +
# pflash secure=on), copies the enrolled varstore to scratch, and implements the
# negative case properly: --expect-fail asserts the FIRMWARE's rejection line
# rather than concluding "rejected" from a silent disk.
BOOT_TEST_ARGS=(--reuse-disk "${INSTALL_DISK}")
[[ "${SECURE}" -eq 1 ]] && BOOT_TEST_ARGS+=(--secure)
[[ "${EXPECT_FAIL}" -eq 1 ]] && BOOT_TEST_ARGS+=(--expect-fail)

echo "==> Verdict: booting the installed disk (boot-test ${BOOT_TEST_ARGS[*]})"
env -u usage_secure -u usage_expect_fail ./mise/tasks/boot-test "${BOOT_TEST_ARGS[@]}"

echo "==> PASS"
