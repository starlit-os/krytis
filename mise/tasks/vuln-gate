#!/usr/bin/env bash
#MISE description="Show or change the vuln-diff blocking gate (NEW_VULN_FAIL_ON repository variable)"
#USAGE flag "--set <severity>" help="Start blocking PRs that introduce a NEW match at/above this Grype severity (negligible|low|medium|high|critical)"
#USAGE flag "--clear" help="Return to report-only: delete the variable"

# The severity floor for .github/workflows/vuln-diff.yml lives in the
# repository variable NEW_VULN_FAIL_ON rather than in the workflow file
# (#730), so changing the gate's posture needs no PR. That convenience is
# also the risk this task exists to contain:
#
#   - A value the workflow never sees at review time can be a typo. Grype's
#     severities are capitalized (`Critical`), the CLI accepts lowercase, and
#     scripts/vuln-diff.py treats anything off the scale as "no floor" — so
#     `hgih` would leave the gate configured and dead. Validate before
#     writing, and let vuln-diff.py exit 2 on anything that still gets
#     through.
#   - Repository variables are NOT passed to `pull_request` runs from a
#     forked repo (GitHub community discussion 44322), so the gate cannot
#     block a fork PR no matter what is set here. vuln-diff.yml says so in
#     the job summary; the fix would be `pull_request_target`, which runs
#     fork code with the base repo's token, and is not worth it for this.
#
# The decision this task exists to serve was made in #690 on 2026-09-03:
# armed at `critical`, matching publish.yml's own pre-build bar. Lowering
# the floor or disarming is a Design Gate call too — a blocked PR that must
# land normally takes a .grype.yaml ignore rule (reviewed, in-tree), not a
# --clear that silently disarms the gate for every other PR as well.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

VAR="NEW_VULN_FAIL_ON"
REPO="starlit-os/krytis"
SEVERITIES="negligible low medium high critical"

command -v gh >/dev/null 2>&1 || { echo "ERROR: gh is required" >&2; exit 1; }

SET_TO="${usage_set:-}"
CLEAR=$([[ "${usage_clear:-}" == "true" ]] && echo 1 || echo 0)

if [ -n "$SET_TO" ] && [ "$CLEAR" -eq 1 ]; then
    echo "ERROR: --set and --clear are mutually exclusive" >&2
    exit 1
fi

current() {
    # 404 when unset — report-only, not an error.
    gh variable get "$VAR" --repo "$REPO" 2>/dev/null || true
}

if [ "$CLEAR" -eq 1 ]; then
    if [ -z "$(current)" ]; then
        echo "==> ${VAR} is already unset — gate is report-only."
        exit 0
    fi
    gh variable delete "$VAR" --repo "$REPO"
    echo "==> Deleted ${VAR}. The vuln-diff gate is REPORT ONLY from the next PR run."
    exit 0
fi

if [ -n "$SET_TO" ]; then
    # Lowercase to match Grype's CLI spelling; vuln-diff.py capitalizes for
    # its own comparison, so either case works downstream — but store one
    # form so `gh variable get` output is predictable.
    SET_TO=$(printf '%s' "$SET_TO" | tr '[:upper:]' '[:lower:]')
    case " $SEVERITIES " in
        *" $SET_TO "*) ;;
        *)
            echo "ERROR: '${SET_TO}' is not a Grype severity. Expected one of: ${SEVERITIES}" >&2
            exit 1
            ;;
    esac
    gh variable set "$VAR" --repo "$REPO" --body "$SET_TO"
    echo "==> Set ${VAR}=${SET_TO}."
    echo "    From the next PR run, a NEW match at or above ${SET_TO} FAILS the"
    echo "    'Diff vulnerabilities vs base' check. Revert with: mise run vuln-gate --clear"
    exit 0
fi

VALUE="$(current)"
if [ -z "$VALUE" ]; then
    echo "==> ${VAR} is unset — the vuln-diff gate is REPORT ONLY (#690)."
    echo "    Start blocking with: mise run vuln-gate --set <${SEVERITIES// /|}>"
else
    echo "==> ${VAR}=${VALUE} — the vuln-diff gate BLOCKS a PR that introduces a"
    echo "    new match at or above ${VALUE} severity."
    echo "    Return to report-only with: mise run vuln-gate --clear"
fi
echo
echo "    Note: repository variables are not passed to pull_request runs from a"
echo "    fork, so this gate cannot block a fork PR regardless of the value."
