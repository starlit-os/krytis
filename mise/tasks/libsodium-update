#!/usr/bin/env bash
#MISE description="Update libsodium element to the latest GitHub release"
#MISE hide=true

set -euo pipefail

ELEMENT="elements/desktop/libsodium.bst"
REPO="jedisct1/libsodium"

CURRENT_VER=$(grep -oP 'libsodium-\K[0-9.]+(?=\.tar\.gz)' "${ELEMENT}" | head -1)
echo "==> Current: ${CURRENT_VER}"

# Newest release with the source tarball, not `releases/latest`
# (scripts/github-release-with-assets.sh). Tags are "<ver>-RELEASE".
echo "==> Fetching latest ${REPO} release with a source tarball..."
LATEST_TAG=$(scripts/github-release-with-assets.sh --current "${CURRENT_VER}" \
  --strip-suffix -RELEASE "${REPO}" 'libsodium-{ver}.tar.gz')
LATEST_VER="${LATEST_TAG%-RELEASE}"

echo "==> Latest: ${LATEST_TAG}"

if [ "${LATEST_VER}" = "${CURRENT_VER}" ]; then
  echo "==> Already up to date (${CURRENT_VER})"
  exit 0
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

ARCHIVE="libsodium-${LATEST_VER}.tar.gz"
BASE_URL="https://github.com/${REPO}/releases/download/${LATEST_TAG}"

echo "==> Downloading ${ARCHIVE}..."
curl -fsSL --retry 3 --retry-delay 10 "${BASE_URL}/${ARCHIVE}" -o "${TMPDIR}/${ARCHIVE}"
SHA=$(sha256sum "${TMPDIR}/${ARCHIVE}" | awk '{print $1}')
echo "    sha256=${SHA}"

CURRENT_SHA=$(grep -A1 "libsodium-${CURRENT_VER}.tar.gz" "${ELEMENT}" | grep 'ref:' | awk '{print $2}')

echo "==> Updating ${ELEMENT}: ${CURRENT_VER} → ${LATEST_VER}"
sed -i "s|libsodium-${CURRENT_VER}.tar.gz|libsodium-${LATEST_VER}.tar.gz|g" "${ELEMENT}"
sed -i "s|download/[^/]*/libsodium|download/${LATEST_TAG}/libsodium|" "${ELEMENT}"
sed -i "s|ref: ${CURRENT_SHA}|ref: ${SHA}|" "${ELEMENT}"

echo "==> Done. Run 'mise run validate' to verify."
