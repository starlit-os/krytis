#!/usr/bin/env bash
#MISE description="Deregister the always-on Debian CI VPS runner from GitHub and stop its systemd service (issue #794)"

set -euo pipefail

# Resolves RUNNER_VPS_HOST (env, else the Krytis vault) and defines ssh_vps.
. scripts/runner-vps-host.sh
RUNNER_HOME="/opt/actions-runner"

# Deregister via the API directly (same as mise/tasks/runner/stop) rather
# than `config.sh remove --token <removal-token>` on the box — one fewer
# round trip, and it works even if the box is unreachable.
RUNNER_ID=$(gh api repos/starlit-os/krytis/actions/runners \
    --jq ".runners[] | select(.name == \"${RUNNER_VPS_NAME}\") | .id")
if [ -n "${RUNNER_ID}" ]; then
    echo "==> Deregistering runner '${RUNNER_VPS_NAME}' (id=${RUNNER_ID})..."
    gh api -X DELETE "repos/starlit-os/krytis/actions/runners/${RUNNER_ID}"
else
    echo "==> Runner '${RUNNER_VPS_NAME}' not found in GitHub — may already be deregistered."
fi

echo "==> Stopping and uninstalling the systemd service on ${RUNNER_VPS_HOST}..."
ssh_vps "cd ${RUNNER_HOME} && ./svc.sh stop && ./svc.sh uninstall"
echo "==> Done. The box itself (packages, actions-runner binary) is untouched — re-run 'mise runner-vps:register' to bring it back."
