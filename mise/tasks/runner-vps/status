#!/usr/bin/env bash
#MISE description="Show GitHub registration and systemd status for the always-on Debian CI VPS runner (issue #794)"

set -euo pipefail

# Resolves RUNNER_VPS_HOST (env, else the Krytis vault) and defines ssh_vps.
. scripts/runner-vps-host.sh
RUNNER_HOME="/opt/actions-runner"

echo "==> GitHub registration:"
gh api repos/starlit-os/krytis/actions/runners --jq \
    ".runners[] | select(.name == \"${RUNNER_VPS_NAME}\") | \"\(.name): \(.status) (busy=\(.busy))\"" \
    || echo "    (not registered)"

echo "==> systemd service on ${RUNNER_VPS_HOST}:"
ssh_vps "cd ${RUNNER_HOME} && ./svc.sh status" || true
