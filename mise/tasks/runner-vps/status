#!/usr/bin/env bash
#MISE description="Show GitHub registration and systemd status for the always-on Debian CI VPS runner (issue #794)"

set -euo pipefail

: "${RUNNER_VPS_HOST:?Set RUNNER_VPS_HOST (e.g. root@203.0.113.10) in .mise.local.toml [env] — see docs/skills/ci-runner.md § Always-on VPS runner}"
SSH_KEY="${RUNNER_VPS_SSH_KEY:-${HOME}/.ssh/id_ed25519_sk_rk_KrytisBuild}"
RUNNER_HOME="/opt/actions-runner"

echo "==> GitHub registration:"
gh api repos/starlit-os/krytis/actions/runners --jq \
    ".runners[] | select(.name == \"${RUNNER_VPS_NAME}\") | \"\(.name): \(.status) (busy=\(.busy))\"" \
    || echo "    (not registered)"

echo "==> systemd service on ${RUNNER_VPS_HOST}:"
env -u SSH_AUTH_SOCK ssh -i "${SSH_KEY}" -o IdentitiesOnly=yes -o IdentityAgent=none "${RUNNER_VPS_HOST}" \
    "cd ${RUNNER_HOME} && ./svc.sh status" || true
