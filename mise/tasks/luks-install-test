#!/usr/bin/env bash
#MISE description="Install Krytis to an ENCRYPTED root from a live ISO in QEMU, then boot it and answer the passphrase prompt (#473)"
#USAGE flag "--iso <path>" help="ISO to install from. Default: output/krytis-live-sealed.iso, falling back to output/krytis-live.iso"
#USAGE flag "--passphrase <s>" default="testpassphrase" help="LUKS passphrase to install with and answer the prompt with"
#USAGE flag "--payload-ref <ref>" help="Payload image ref for the fisherman recipe. Default: matches the ISO variant"
#USAGE flag "--keep" help="Keep the installed disk image after the run, for post-mortem inspection"

set -euo pipefail

# Why this gate exists, and how it differs from the ones next to it:
#
#   boot-test          image -> disk, unencrypted
#   iso-install-test   ISO -> fisherman -> disk, unencrypted
#   luks-boot-test     synthetic LUKS2 disk + the real UKI (#474). Proves the
#                      *boot* path prompts, with no installer involved.
#   THIS               ISO -> fisherman -> ENCRYPTED disk -> boot -> answer
#
# Before this, no gate did an encrypted install at all (#473), so nothing
# exercised the passphrase prompt, `rd.luks.options=` being honoured, or
# plymouth's interaction with systemd-ask-password. Two bugs reached real
# hardware through that gap, and the reported symptom was specifically a splash
# that never yielded a prompt — which is why the verdict asserts a prompt
# APPEARED rather than that the disk unlocked.
#
# The install is delegated to mise/tasks/iso-e2e-test --install-only, the same
# chain mise run iso-install-test uses, with the passphrase passed BOTH as
# --luks-passphrase and in the environment: the flag is what iso-e2e-test
# actually reads, and the env var is the interface scripts/iso-install-fisherman.sh
# documents. That chain is root-free and needs no sshpass.
# The verdict is delegated to boot-test, which already owns SMBIOS-credential
# provisioning (the only way into a sealed system whose cmdline cannot be
# touched), OVMF secboot selection, and now --luks-passphrase.

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

PASSPHRASE="${usage_passphrase:-testpassphrase}"
KEEP=$([[ "${usage_keep:-}" == "true" ]] && echo 1 || echo 0)

if [[ -n "${usage_iso:-}" ]]; then
    ISO="${usage_iso}"
elif [[ -f "output/krytis-live-sealed.iso" ]]; then
    ISO="output/krytis-live-sealed.iso"
else
    ISO="output/krytis-live.iso"
fi

if [[ "${ISO}" == *sealed* ]]; then
    DEFAULT_REF="ghcr.io/starlit-os/krytis:sealed"
else
    DEFAULT_REF="ghcr.io/starlit-os/krytis:latest"
fi
PAYLOAD_REF="${usage_payload_ref:-${DEFAULT_REF}}"

# Everything is checked before QEMU starts. An install run is tens of minutes;
# discovering a missing prerequisite at minute 30 is the failure this prevents.
if [[ ! -f "${ISO}" ]]; then
    echo "ERROR: ISO not found: ${ISO}" >&2
    echo "       Build it:  mise run build-iso$([[ "${ISO}" == *sealed* ]] && echo ' --sealed') --debug" >&2
    exit 1
fi

# Deliberately no --secure. Answering the prompt needs console=ttyS0 injected via
# io.systemd.stub.kernel-cmdline-extra, and systemd-stub ignores cmdline additions
# under enforcement — so a --secure run could never see or answer a prompt, and
# would fail for a harness reason rather than an image one. boot-test rejects the
# combination too. Enforcement is asserted separately by
# `mise run iso-install-test --secure`; this gate asserts the unlock.

if ! command -v qemu-system-x86_64 &>/dev/null && ! command -v qemu-kvm &>/dev/null; then
    echo "ERROR: needs qemu-system-x86_64 or qemu-kvm on the host." >&2
    exit 1
fi

# sfdisk only: the disk is inspected by reading the image file, never by
# attaching a loop device, so no cryptsetup/blkid and no root.
for tool in sfdisk; do
    command -v "${tool}" &>/dev/null || { echo "ERROR: needs ${tool} on the host." >&2; exit 1; }
done

# The install is driven over SSH into the live session, which needs a --debug
# ISO: krytis is pubkey-only by policy, so a production ISO refuses the
# installer's password login and the run stalls until the readiness probe times
# out minutes later. Same check, and same reasoning, as iso-install-test.
DEBUG_DROPIN="etc/ssh/sshd_config.d/05-live-debug.conf"
SFS_OFFSET="$(python3 scripts/iso-squashfs-offset.py "${ISO}")"
if ! unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${DEBUG_DROPIN}" >/dev/null 2>&1; then
    echo "ERROR: ${ISO} has no ${DEBUG_DROPIN} — it was built without --debug." >&2
    echo "       Krytis's pubkey-only sshd will refuse the installer's password login." >&2
    echo "  Rebuild it:  mise run build-iso$([[ "${ISO}" == *sealed* ]] && echo ' --sealed') --debug" >&2
    exit 1
fi

ISO_ABS="$(realpath "${ISO}")"
INSTALL_DISK="/var/tmp/krytis-install.img"

echo "==> Installing Krytis to an ENCRYPTED root from an ISO in QEMU"
echo "    iso:         ${ISO_ABS}"
echo "    payload:     ${PAYLOAD_REF}"
echo "    passphrase:  ${PASSPHRASE}"

echo "==> [1/3] Live ISO boot + encrypted install"
set +e
LUKS_PASSPHRASE="${PASSPHRASE}" \
    "${REPO_ROOT}/mise/tasks/iso-e2e-test" \
        --iso "${ISO_ABS}" \
        --payload-ref "${PAYLOAD_REF}" \
        --luks-passphrase "${PASSPHRASE}" \
        --install-only
RESULT=$?
set -e

if [[ "${RESULT}" -ne 0 ]]; then
    echo "==> FAILED during install (exit ${RESULT}). Serial logs from the run:" >&2
    ls -la /tmp/krytis-qemu-*serial*.log 2>/dev/null >&2 || true
    exit "${RESULT}"
fi

[[ -f "${INSTALL_DISK}" ]] || { echo "ERROR: installer reported success but ${INSTALL_DISK} is missing." >&2; exit 1; }

if [[ "${KEEP}" -eq 0 ]]; then
    trap 'rm -f "${INSTALL_DISK}"' EXIT
fi

echo "==> [2/3] Inspecting the installed disk"

# One probe of the partition table and the root partition's magic, read straight
# out of the image file. No loop devices and no cryptsetup: attaching a loop
# device needs root, and the whole point of this chain is that it runs
# unprivileged.
#
# The magic is classified in python and reported as a WORD. Reading it through
# `$(dd …)` instead puts raw bytes ("LUKS\xba\xbe") through command substitution,
# where NUL stripping and invalid UTF-8 made the comparison fail against a disk
# that was in fact encrypted — a false negative that looked like an installer bug.
#
# Root is the LAST partition — the ESP is 1 and root fills the remaining space —
# which is how fisherman's PartitionSystemdBoot lays it out.
read -r ROOT_PART ROOT_TYPE ROOT_KIND <<<"$(python3 - "${INSTALL_DISK}" <<'PY'
import json, subprocess, sys

disk = sys.argv[1]
d = json.loads(subprocess.run(['sfdisk', '--json', disk],
                              capture_output=True, text=True, check=True).stdout)['partitiontable']
parts = d['partitions']
root = parts[-1]
offset = root['start'] * d.get('sectorsize', 512)
with open(disk, 'rb') as f:
    f.seek(offset)
    magic = f.read(6)
# LUKS2 headers start "LUKS\xba\xbe" — same magic as LUKS1, the version follows.
kind = 'luks' if magic.startswith(b'LUKS\xba\xbe') else 'other:' + magic.hex()
# sfdisk numbers partitions by their order in the table, 1-based.
print(len(parts), root['type'].lower(), kind)
PY
)"
sfdisk -l -o Device,Start,Size,Type-UUID "${INSTALL_DISK}" 2>/dev/null | sed 's/^/    /'

# Assert the install really is encrypted BEFORE booting it. Otherwise a recipe
# that silently lost its encryption block produces a system that boots fine and
# never prompts, and the verdict below would blame the boot path for an install
# that never encrypted anything.
if [[ "${ROOT_KIND}" != "luks" ]]; then
    echo "ERROR: partition ${ROOT_PART} of ${INSTALL_DISK} is not a LUKS container." >&2
    echo "       First 6 bytes: ${ROOT_KIND#other:}" >&2
    echo "       The recipe asked for encryption.type=luks-passphrase but the" >&2
    echo "       installer produced an unencrypted root, so there is nothing to" >&2
    echo "       unlock and this gate cannot test what it exists to test." >&2
    exit 1
fi
echo "    partition ${ROOT_PART} carries a LUKS header — the install is encrypted"

# The root partition's GPT type decides whether a sealed UKI can find it at all.
# A UKI's cmdline is signed, so it carries no rd.luks.uuid, and hostonly=no means
# no /etc/crypttab in the initrd — leaving systemd-gpt-auto-generator as the only
# thing that can discover the volume, and it only recognises the Discoverable
# Partitions root GUID. Typed generic `linux`, the boot times out on
# dev-gpt-auto-root.device and drops to emergency mode with no prompt: exactly
# the hardware symptom in #473/#474.
#
# Until 2026-09-19 fisherman typed it generic and this gate repaired the disk
# before booting it, behind a --strict-installer opt-out. tuna-os/fisherman#219
# (v0.4.0) now writes the architecture's DPS root GUID when the table is
# created, which covers the encrypted layout the old post-install retag could
# never reach, and tuna-os/bootc-installer ships it. The repair is gone with
# it: a generic GUID today is a regression in the installer we ship, and
# repairing it here would hide exactly that.
DISCOVERABLE_ROOT="4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
GENERIC_LINUX="0fc63daf-8483-4772-8e79-3d69d8477de4"

if [[ "${ROOT_TYPE}" == "${DISCOVERABLE_ROOT}" ]]; then
    echo "    root partition carries the Discoverable Partitions GUID — installer is correct"
elif [[ "${ROOT_TYPE}" == "${GENERIC_LINUX}" ]]; then
    echo "ERROR: the installer typed the root partition ${GENERIC_LINUX} (generic linux)." >&2
    echo "       A sealed UKI cannot find an encrypted root with that type: the signed" >&2
    echo "       cmdline has no rd.luks.uuid and the initrd has no crypttab, so" >&2
    echo "       systemd-gpt-auto-generator is the only discovery mechanism and it" >&2
    echo "       needs ${DISCOVERABLE_ROOT}." >&2
    echo "       This was fixed upstream in tuna-os/fisherman#219 (v0.4.0) and ships in" >&2
    echo "       tuna-os/bootc-installer, so seeing it again means the ISO was built" >&2
    echo "       against a stale installer bundle — check live/src/install-flatpaks.sh." >&2
    exit 1
else
    echo "ERROR: unexpected root partition type ${ROOT_TYPE}." >&2
    echo "       Expected ${DISCOVERABLE_ROOT}." >&2
    exit 1
fi

echo "==> [3/3] Verdict: boot the encrypted disk and answer the prompt"
./mise/tasks/boot-test --reuse-disk "${INSTALL_DISK}" --luks-passphrase "${PASSPHRASE}"

echo "==> PASS: encrypted install booted, a passphrase prompt appeared, and it unlocked"
