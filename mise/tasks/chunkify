#!/usr/bin/env bash
#MISE description="Rechunk localhost/krytis:latest into composefs-ready component layers via chunkah"
#USAGE flag "--tag <tag>" default="localhost/krytis:latest" help="Image tag to chunkify in place"
#USAGE flag "--drop-root-copy" help="Delete the root-store copy once the chunked image is back in the rootless store (CI disk headroom; generate-disk re-copies on demand)"

set -euo pipefail

TAG="${usage_tag:-localhost/krytis:latest}"
DROP_ROOT_COPY="${usage_drop_root_copy:-false}"
# Consume flags passed as literal args by a caller that runs this file
# directly (see docs/skills/mise.md § Propagating flags through tasks that call
# other tasks).
while [ $# -gt 0 ]; do
    case "$1" in
        --tag) TAG="$2"; shift 2 ;;
        --drop-root-copy) DROP_ROOT_COPY=true; shift ;;
        *) break ;;
    esac
done

# Pinned chunkah image — bump via `mise chunkah-update` (see Task 4).
CHUNKAH_REF="quay.io/coreos/chunkah:v0.7.1@sha256:71e593421c5de7dcc7c8c5c50e98d3bac572055a76f399f61a491d123c20a523"

echo "==> Chunkifying ${TAG}..."

SUDO_CMD=""
ROOTLESS=false
if [ "$(id -u)" -ne 0 ]; then
    SUDO_CMD="sudo"
    ROOTLESS=true
fi

# The image of record is the invoking user's: `mise run build` and `seal-uki`
# write the rootless store, and `push` and `generate-disk` read it. chunking
# needs root (overlay mount, chunkah's xattr reads), so copy the image into the
# root store, chunk it there, and copy the result back under the same tag
# (#1688). Before this, `generate-disk`'s load-image-root saw a rootless ID that
# differed from the chunked root copy and overwrote the chunked image with the
# unchunked one.
if [ "${ROOTLESS}" = true ]; then
    "$(dirname "$0")/load-image-root" --image "${TAG}"
fi

SRC_ID=$($SUDO_CMD podman image inspect --format '{{.Id}}' "${TAG}")
CONFIG=$($SUDO_CMD podman inspect "${TAG}")

FAKECAP_RESTORE="$(pwd)/files/fakecap/fakecap-restore"
if [ ! -x "${FAKECAP_RESTORE}" ]; then
    echo "==> Compiling fakecap-restore..."
    gcc -O2 -o "${FAKECAP_RESTORE}" "$(pwd)/files/fakecap/fakecap-restore.c"
fi

LOWER=$($SUDO_CMD podman image mount "${SRC_ID}")

# Initialize overlay variables early so cleanup trap is always safe.
UPPER=""
WORK=""
MERGED=""

cleanup() {
    [ -n "$MERGED" ] && $SUDO_CMD umount "$MERGED" 2>/dev/null || true
    [ -n "$UPPER" ] && $SUDO_CMD rm -rf "$UPPER" || true
    [ -n "$WORK" ] && $SUDO_CMD rm -rf "$WORK" || true
    [ -n "$MERGED" ] && $SUDO_CMD rm -rf "$MERGED" || true
    # By ID: TAG names the chunked image by the time this runs.
    $SUDO_CMD podman image umount "${SRC_ID}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Pick the tmpdir with the most free space for the overlay work dirs.
# fakecap-restore triggers overlayfs copy-up for every file it touches;
# copy-ups can exhaust /var/tmp on machines where root has little free
# space (e.g. CI runners with a BTRFS loopback for /var/lib/containers).
# Ported from dakota's e0b5a52 — see docs/skills/chunkah.md.
_OVERLAY_TMPDIR="/var/tmp"
for _candidate in /var/lib/containers /var/tmp; do
    if [ -d "${_candidate}" ]; then
        _free=$(df --output=avail "${_candidate}" 2>/dev/null | tail -1 || echo 0)
        _best=$(df --output=avail "${_OVERLAY_TMPDIR}" 2>/dev/null | tail -1 || echo 0)
        if (( _free > _best )); then _OVERLAY_TMPDIR="${_candidate}"; fi
    fi
done
echo "==> overlay tmpdir: ${_OVERLAY_TMPDIR} ($(df -h --output=avail "${_OVERLAY_TMPDIR}" | tail -1 | tr -d ' ') free)"
UPPER=$(mktemp -d -p "${_OVERLAY_TMPDIR}")
WORK=$(mktemp -d -p "${_OVERLAY_TMPDIR}")
MERGED=$(mktemp -d -p "${_OVERLAY_TMPDIR}")
$SUDO_CMD chmod 755 "${UPPER}" "${WORK}" "${MERGED}"
$SUDO_CMD mount -t overlay overlay \
    -o "lowerdir=${LOWER},upperdir=${UPPER},workdir=${WORK}" \
    "${MERGED}"

echo "==> Applying user.component xattrs via fakecap-restore..."
$SUDO_CMD "${FAKECAP_RESTORE}" files/fakecap-manifest.tsv "${MERGED}"

echo "==> Pulling chunkah..."
for attempt in 1 2 3; do
    $SUDO_CMD podman pull "${CHUNKAH_REF}" && break
    echo "==> chunkah pull attempt ${attempt} failed, retrying in 10s..."
    [ "${attempt}" -lt 3 ] && sleep 10
done

echo "==> Running chunkah (max 120 layers)..."
LOADED=$($SUDO_CMD podman run --rm \
    --pull never \
    --security-opt label=type:unconfined_t \
    -v "${MERGED}:/chunkah:ro" \
    -e "CHUNKAH_ROOTFS=/chunkah" \
    -e "CHUNKAH_CONFIG_STR=${CONFIG}" \
    "${CHUNKAH_REF}" build --max-layers 120 --prune /sysroot/ \
    --label ostree.commit- --label ostree.final-diffid- \
    | $SUDO_CMD podman load)

echo "${LOADED}"

# Parse the loaded image reference — podman's "Loaded image" wording varies by version.
NEW_REF=$(echo "${LOADED}" | sed -n 's/^Loaded image(s): //p; s/^Loaded image: //p' | head -1)
if [ -z "${NEW_REF}" ]; then
    NEW_REF=$(echo "${LOADED}" | grep -oP '^[0-9a-f]{64}$' | head -1 || true)
fi

if [ -z "${NEW_REF}" ]; then
    echo "ERROR: could not parse podman load output — chunkah did not report a loaded image" >&2
    exit 1
fi

if [ -n "${NEW_REF}" ] && [ "${NEW_REF}" != "${TAG}" ]; then
    echo "==> Retagging chunked image to ${TAG}..."
    $SUDO_CMD podman tag "${NEW_REF}" "${TAG}"
fi

NEW_ID=$($SUDO_CMD podman image inspect --format '{{.Id}}' "${TAG}")
LAYERS=$($SUDO_CMD podman image inspect --format '{{len .RootFS.Layers}}' "${TAG}")
echo "==> ${TAG} is ${NEW_ID:0:12}, ${LAYERS} layers."
if [ "${LAYERS}" -le 1 ]; then
    echo "==> ERROR: chunkah produced ${LAYERS} layer(s); expected more than one." >&2
    exit 1
fi

# Release the overlay and the source mount now: the cleanup trap would do it
# at exit, but the source image can't be removed while it is mounted.
cleanup
trap - EXIT
MERGED=""; UPPER=""; WORK=""

if [ "${ROOTLESS}" = true ]; then
    echo "==> Copying the chunked image back to the rootless store..."
    $SUDO_CMD podman save --format oci-archive "${TAG}" | podman load
    podman tag "${NEW_ID}" "${TAG}"
    # The unchunked rootless image is now untagged. Remove it by ID so it
    # doesn't sit in storage (~7 GB); skip quietly if something else still
    # tags it.
    podman rmi "${SRC_ID}" >/dev/null 2>&1 || true
fi
# Same for the unchunked root-store copy, which nothing reads any more.
$SUDO_CMD podman rmi "${SRC_ID}" >/dev/null 2>&1 || true
if [ "${ROOTLESS}" = true ] && [ "${DROP_ROOT_COPY}" = true ]; then
    $SUDO_CMD podman rmi "${TAG}" >/dev/null 2>&1 || true
    echo "==> Dropped the root-store copy (--drop-root-copy)."
fi

# chunkify must not change the composefs digest (#1688: identical digests and
# dumpfiles before and after, measured 2026-11-19). For a sealed image that is
# what keeps the UKI valid, so check it here rather than trust it: a mismatch
# would only surface at install time, on a user's machine.
if podman run --rm --entrypoint /bin/sh "${TAG}" -c '[ -f /boot/EFI/Linux/krytis.efi ]' 2>/dev/null; then
    echo "==> Sealed image: verifying the UKI's composefs digest against the chunked image..."
    "$(dirname "$0")/verify-composefs-digest" --image "${TAG}"
fi

echo "==> Done: ${TAG} is now composefs-ready."
