#!/usr/bin/env bash
#MISE description="Assert an ISO's embedded offline payload is the exact image expected, and that its media-input.json receipt and installer recipe both bind to it (sealed-payload digest gate; --names-only for unsealed ISOs)"
#USAGE flag "--iso <path>" default="output/krytis-live-sealed.iso" help="ISO to inspect"
#USAGE flag "--image <tag>" default="localhost/krytis:sealed" help="Local image tag the payload must match (ignored with --names-only)"
#USAGE flag "--names-only" help="Unsealed ISO: skip the image-ID check, keep the layout, receipt and recipe checks"

set -euo pipefail

# Why this exists: a sealed payload's UKI carries a composefs= digest baked into
# its frozen cmdline at seal time, and `bootc install` refuses any mismatch. The
# embed pipeline therefore has to hand the payload's content through unchanged
# (PAYLOAD_SEALED=1 in scripts/iso-sd-boot.sh). Asserting that inside the pipeline
# would be tautological — the pass-through makes it true by construction. The
# finished ISO is the only place that proves the whole chain (podman save →
# oci-archive → skopeo copy → OCI layout → ISO) preserved the image, and the same
# check catches the "wrong tag embedded" class of bug that already bit once
# (#417/#425). Unprivileged, no QEMU, under a minute (it hashes every blob).
#
# The payload is an OCI layout at /OCI on the ISO, described by the receipt
# /etc/bootc-installer/media-input.json in the live squashfs (#1479). Three
# invariants, each one fisherman also enforces at install time, too late to help:
#
# 1. The layout is intact: every blob's digest and size match its descriptor
#    (scripts/iso-oci-layout.py), and for a sealed payload the config digest is
#    `podman inspect <tag> --format '{{.Id}}'`. iso-sd-boot.sh gzips the layers,
#    which changes the layer digests but not the config, so the image ID still
#    identifies the content.
# 2. The receipt pins that layout: platformManifestDigest and configDigest match
#    it, ociLayoutPath is where dmsquash-live mounts the ISO, and image equals
#    targetImgref (what `bootc upgrade` follows afterwards).
# 3. The installer recipe (#1248) binds to the receipt. fisherman refuses a
#    recipe `image` that is not the receipt's `image`, and a `targetImgref` that
#    differs from it. The embed side (iso-sd-boot.sh) and the recipe side
#    (configure-live-krytis.sh) are configured independently, and the E2E install
#    writes its own recipe, so only a real GUI install would hit a drift. dakota-iso
#    shipped exactly that (bd407ff); see docs/skills/dakota-iso.md § The ISO's
#    embedded payload and the installer's `local_imgref` are set independently.
#
# --names-only (#1261): the ID check holds only for a SEALED payload. An unsealed
# one is re-committed by live/iso-tools/payload-prep.sh (two injected files,
# `buildah commit --squash`), so its ID never equals the local tag's and an ID
# check on an unsealed ISO can only fail. Invariants 2 and 3 do not depend on the
# ID, so unsealed builds keep them.
#
# When this task is invoked as a plain script by another task (build-iso does),
# mise does NOT parse these #USAGE annotations for the child call — it passes the
# literal flags as positional args while leaving the PARENT's usage_* vars in the
# environment. Consume $@ first, fall back to usage_*. Same fix as boot-test and
# generate-disk; see docs/skills/mise.md § Propagating flags through tasks that
# call other tasks.
CLI_ISO=""; CLI_IMAGE=""; CLI_NAMES_ONLY=""
while [ $# -gt 0 ]; do
    case "$1" in
        --iso)        CLI_ISO="$2"; shift 2 ;;
        --image)      CLI_IMAGE="$2"; shift 2 ;;
        --names-only) CLI_NAMES_ONLY=1; shift ;;
        *) break ;;
    esac
done

ISO="${CLI_ISO:-${usage_iso:-output/krytis-live-sealed.iso}}"
IMAGE="${CLI_IMAGE:-${usage_image:-localhost/krytis:sealed}}"
NAMES_ONLY=0
if [[ -n "${CLI_NAMES_ONLY}" || "${usage_names_only:-}" == "true" ]]; then NAMES_ONLY=1; fi

[ -f "${ISO}" ] || { echo "ERROR: ISO not found: ${ISO}" >&2; exit 1; }
EXPECTED_ID=""
if [[ "${NAMES_ONLY}" -eq 0 ]]; then
    podman image exists "${IMAGE}" || { echo "ERROR: ${IMAGE} does not exist locally — nothing to compare the ISO against." >&2; exit 1; }
    EXPECTED_ID="$(podman inspect "${IMAGE}" --format '{{.Id}}')"
fi
MEDIA_JSON_PATH="etc/bootc-installer/media-input.json"
RECIPE_JSON_PATH="etc/bootc-installer/recipe.json"

if [[ "${NAMES_ONLY}" -eq 1 ]]; then
    echo "==> Verifying ${ISO}'s embedded payload, receipt and recipe (unsealed: no ID check)..."
else
    echo "==> Verifying ${ISO} embeds ${IMAGE} (${EXPECTED_ID:0:12})..."
fi

# Read the receipt and the recipe straight out of the ISO's live squashfs — no
# root, no loop mount, no ~5GB extract. See scripts/iso-squashfs-offset.py for
# how the offset is found and why xorriso is not an option on a Krytis host.
SFS_OFFSET="$(python3 scripts/iso-squashfs-offset.py "${ISO}")"

if ! MEDIA_JSON="$(unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${MEDIA_JSON_PATH}" 2>/dev/null)"; then
    echo "ERROR: ${MEDIA_JSON_PATH} not present in the ISO's squashfs." >&2
    echo "       fisherman refuses to install from live media without it (#1479)." >&2
    exit 1
fi
if ! RECIPE_JSON="$(unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${RECIPE_JSON_PATH}" 2>/dev/null)"; then
    echo "ERROR: ${RECIPE_JSON_PATH} not present in the ISO's squashfs — no installer recipe to check." >&2
    exit 1
fi
LAYOUT_JSON="$(python3 scripts/iso-oci-layout.py "${ISO}")"

MEDIA_JSON="${MEDIA_JSON}" RECIPE_JSON="${RECIPE_JSON}" LAYOUT_JSON="${LAYOUT_JSON}" \
EXPECTED_ID="${EXPECTED_ID}" IMAGE="${IMAGE}" python3 <<'PY'
import json, os, sys

# Where dmsquash-live mounts the ISO, plus the graft point in live/src/build-iso.sh.
LIVE_PATH = "/run/initramfs/live/OCI"

expected = os.environ["EXPECTED_ID"].removeprefix("sha256:")
media = json.loads(os.environ["MEDIA_JSON"])
recipe = json.loads(os.environ["RECIPE_JSON"])
layout = json.loads(os.environ["LAYOUT_JSON"])
err = sys.stderr
problems = []

if expected and layout["configDigest"] != f"sha256:{expected}":
    print(f"ERROR: the ISO's embedded layout is not {os.environ['IMAGE']}.", file=err)
    print(f"       expected image ID: {expected[:12]}", file=err)
    print(f"       layout config:     {layout['configDigest'].removeprefix('sha256:')[:12]} ({layout['refName']})", file=err)
    print("", file=err)
    print("Two likely causes:", file=err)
    print("  1. The payload was mutated during embedding (PAYLOAD_SEALED not honoured in", file=err)
    print("     scripts/iso-sd-boot.sh). The layout then holds a re-committed image whose", file=err)
    print("     rootfs no longer matches the digest baked into the UKI, and the install", file=err)
    print("     would abort with 'The UKI has the wrong composefs= parameter'.", file=err)
    print("  2. The wrong tag was embedded — check build-iso's payload ref.", file=err)
    sys.exit(1)

checks = [
    ("media-input.json schemaVersion", media.get("schemaVersion"), 1),
    ("media-input.json platform", media.get("platform"), "linux/amd64"),
    ("media-input.json ociLayoutPath", media.get("ociLayoutPath"), LIVE_PATH),
    ("media-input.json platformManifestDigest", media.get("platformManifestDigest"), layout["manifestDigest"]),
    ("media-input.json configDigest", media.get("configDigest"), layout["configDigest"]),
    ("media-input.json targetImgref", media.get("targetImgref"), media.get("image")),
    ("recipe.json image", recipe.get("image"), media.get("image")),
    ("recipe.json targetImgref", recipe.get("targetImgref"), media.get("image")),
    ("recipe.json imgref", recipe.get("imgref"), media.get("image")),
]
for what, got, want in checks:
    if not want or got != want:
        problems.append(f"{what} is {got!r}, want {want!r}")
if "local_imgref" in recipe:
    problems.append(f"recipe.json still has local_imgref {recipe['local_imgref']!r}; "
                    "the GUI would send it as the source and fisherman would refuse it")

if problems:
    print("ERROR: the payload is embedded, but the receipt or recipe does not bind to it.", file=err)
    for p in problems:
        print(f"       {p}", file=err)
    print("", file=err)
    print("The receipt comes from scripts/iso-sd-boot.sh, the recipe from", file=err)
    print("live/src/configure-live-krytis.sh; both take PAYLOAD_REF. Build both from one", file=err)
    print("PAYLOAD_REF: mise run build-iso does; iso-container-build needs --payload-ref.", file=err)
    sys.exit(1)

cfg = layout["configDigest"].removeprefix("sha256:")[:12]
print(f"==> Payload verified: {cfg} {media['image']}, {layout['layers']} layer(s), "
      f"{layout['bytes'] / 2**30:.2f} GiB" + ("" if expected else " (unsealed: no ID check)"))
print(f"==> media-input.json and recipe.json bind to it: {media['ociLayoutPath']}")
sys.exit(0)
PY
