#!/usr/bin/env bash
#MISE description="Assert an ISO's embedded offline payload is the exact image expected, under the name its installer recipe requests (sealed-payload digest gate)"
#USAGE flag "--iso <path>" default="output/krytis-live-sealed.iso" help="ISO to inspect"
#USAGE flag "--image <tag>" default="localhost/krytis:sealed" help="Local image tag the payload must match"

set -euo pipefail

# Why this exists: a sealed payload's UKI carries a composefs= digest baked into
# its frozen cmdline at seal time, and `bootc install` refuses any mismatch. The
# embed pipeline therefore has to hand the payload through byte-identically
# (PAYLOAD_SEALED=1 in scripts/iso-sd-boot.sh). Asserting that inside the pipeline
# would be tautological — the pass-through makes it true by construction. The
# finished ISO is the only place that proves the whole chain (podman save →
# oci-archive → skopeo copy → VFS store → squashfs → ISO) preserved the image,
# and the same check catches the "wrong tag embedded" class of bug that already bit once
# (#417/#425). Unprivileged, no QEMU, seconds.
#
# The invariant: the image ID recorded in the ISO's embedded VFS store equals
# `podman inspect <tag> --format '{{.Id}}'`. Verified empirically that a VFS
# store's vfs-images/images.json records exactly that value as its `id`, and that
# `podman save --format oci-archive` round-trips both the config digest and the
# layer diff_id unchanged for krytis's (already OCI-format) images.
#
# Second invariant (#1248): every `containers-storage:` ref the installer recipe
# baked into the same squashfs (etc/bootc-installer/recipe.json — `local_imgref`,
# `image`) is one of that store entry's `names`. The embed side
# (scripts/iso-sd-boot.sh, from PAYLOAD_REF or krytis/payload_ref) and the recipe
# side (live/src/configure-live-krytis.sh, from PAYLOAD_REF or its own literal)
# are configured independently; an ID-only check passes a drifted name, and so
# does the E2E install, which writes its own recipe and falls back to a network
# pull. Only a real offline GUI install would fail. dakota-iso shipped exactly
# that (bd407ff); see docs/skills/dakota-iso.md § The ISO's embedded payload and
# the installer's `local_imgref` are set independently.
#
# When this task is invoked as a plain script by another task (build-iso does),
# mise does NOT parse these #USAGE annotations for the child call — it passes the
# literal flags as positional args while leaving the PARENT's usage_* vars in the
# environment. Consume $@ first, fall back to usage_*. Same fix as boot-test and
# generate-disk; see docs/skills/mise.md § Propagating flags through tasks that
# call other tasks.
CLI_ISO=""; CLI_IMAGE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --iso)   CLI_ISO="$2"; shift 2 ;;
        --image) CLI_IMAGE="$2"; shift 2 ;;
        *) break ;;
    esac
done

ISO="${CLI_ISO:-${usage_iso:-output/krytis-live-sealed.iso}}"
IMAGE="${CLI_IMAGE:-${usage_image:-localhost/krytis:sealed}}"

[ -f "${ISO}" ] || { echo "ERROR: ISO not found: ${ISO}" >&2; exit 1; }
podman image exists "${IMAGE}" || { echo "ERROR: ${IMAGE} does not exist locally — nothing to compare the ISO against." >&2; exit 1; }

EXPECTED_ID="$(podman inspect "${IMAGE}" --format '{{.Id}}')"
STORE_JSON="var/lib/containers/storage/vfs-images/images.json"
RECIPE_JSON_PATH="etc/bootc-installer/recipe.json"

echo "==> Verifying ${ISO} embeds ${IMAGE} (${EXPECTED_ID:0:12})..."

# Read the store metadata straight out of the ISO's live squashfs — no root, no
# loop mount, no ~5GB extract. See scripts/iso-squashfs-offset.py for how the
# offset is found and why xorriso is not an option on a Krytis host.
SFS_OFFSET="$(python3 scripts/iso-squashfs-offset.py "${ISO}")"

if ! IMAGES_JSON="$(unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${STORE_JSON}" 2>/dev/null)"; then
    echo "ERROR: ${STORE_JSON} not present in the ISO's squashfs." >&2
    echo "       The offline store is missing, or is not the composefs (VFS) layout." >&2
    exit 1
fi
if ! RECIPE_JSON="$(unsquashfs -offset "${SFS_OFFSET}" -cat "${ISO}" "${RECIPE_JSON_PATH}" 2>/dev/null)"; then
    echo "ERROR: ${RECIPE_JSON_PATH} not present in the ISO's squashfs — no installer recipe to check." >&2
    exit 1
fi

IMAGES_JSON="${IMAGES_JSON}" RECIPE_JSON="${RECIPE_JSON}" EXPECTED_ID="${EXPECTED_ID}" IMAGE="${IMAGE}" python3 <<'PY'
import json, os, sys

expected = os.environ["EXPECTED_ID"].removeprefix("sha256:")
entries = json.loads(os.environ["IMAGES_JSON"])
found = [(e.get("id", ""), e.get("names") or []) for e in entries]

match = next(((i, n) for i, n in found if i == expected), None)

if match:
    image_id, names = match
    recipe = json.loads(os.environ["RECIPE_JSON"])
    prefix = "containers-storage:"
    local_refs = {k: v for k, v in recipe.items()
                  if isinstance(v, str) and v.startswith(prefix)}
    err = sys.stderr
    if "local_imgref" not in local_refs:
        print(f"ERROR: recipe.json has no {prefix} local_imgref "
              f"(got {recipe.get('local_imgref')!r}); the GUI installer has no offline source.",
              file=err)
        sys.exit(1)
    unresolved = {k: v for k, v in local_refs.items() if v.removeprefix(prefix) not in names}
    if unresolved:
        print("ERROR: the payload is embedded, but the installer recipe asks for a name it does not carry.", file=err)
        print(f"       store entry {image_id[:12]} names: {names}", file=err)
        for key, ref in sorted(unresolved.items()):
            print(f"       recipe.json {key}: {ref}", file=err)
        print("", file=err)
        print("An offline GUI install would fail with 'pull failed … containers-storage:…'.", file=err)
        print("The embed name comes from PAYLOAD_REF / krytis/payload_ref (scripts/iso-sd-boot.sh),", file=err)
        print("the recipe's from PAYLOAD_REF or configure-live-krytis.sh's default. Build both from", file=err)
        print("one PAYLOAD_REF: mise run build-iso does; iso-container-build needs --payload-ref.", file=err)
        sys.exit(1)
    print(f"==> Payload verified: {image_id[:12]} {names}")
    print(f"==> Installer recipe resolves to it: {', '.join(sorted(local_refs))}")
    sys.exit(0)

err = sys.stderr
print(f"ERROR: the ISO's embedded store does not contain {os.environ['IMAGE']}.", file=err)
print(f"       expected image ID: {expected[:12]}", file=err)
for image_id, names in found:
    print(f"       store has:         {image_id[:12]} {names}", file=err)
print("", file=err)
print("Two likely causes:", file=err)
print("  1. The payload was mutated during embedding (PAYLOAD_SEALED not honoured in", file=err)
print("     scripts/iso-sd-boot.sh). The store then holds a re-committed image whose", file=err)
print("     rootfs no longer matches the digest baked into the UKI, and the install", file=err)
print("     would abort with 'The UKI has the wrong composefs= parameter'.", file=err)
print("  2. The wrong tag was embedded — check build-iso's payload ref.", file=err)
sys.exit(1)
PY
