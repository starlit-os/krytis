#!/usr/bin/env bash
#MISE description="Build a live ISO for Krytis"
#USAGE flag "--output-dir <dir>" default="output" help="Directory for the final ISO and intermediate artifacts"
#USAGE flag "--workdir <dir>" help="Working directory for squashfs staging (XFS/BTRFS recommended)"
#USAGE flag "--compression <mode>" default="fast" help="Squashfs compression: fast or release"
#USAGE flag "--debug" help="Enable SSH in the live environment (not for production)"
#USAGE flag "--sealed" help="Embed the signed UKI image (localhost/krytis:sealed) as the offline install payload instead of the unsigned one"
#USAGE flag "--payload-image <ref>" help="With --sealed, embed this already-built image instead of localhost/krytis:sealed. Use the published ref for release validation; it is taken as-is, never re-sealed"

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

SEALED=$([[ "${usage_sealed:-}" == "true" ]] && echo 1 || echo 0)

if [[ -n "${usage_payload_image:-}" && "${SEALED}" -eq 0 ]]; then
    echo "ERROR: --payload-image only applies with --sealed." >&2
    echo "       The unsigned payload comes from krytis/payload_ref." >&2
    exit 1
fi

# `mise build` only tags the freshly built image as localhost/krytis:latest, and
# `mise run seal-uki` only tags localhost/krytis:sealed. iso-sd-boot.sh does
# `podman save` on the payload ref it is given, so re-tag on every run: without a
# matching local tag it either fails outright or silently embeds a stale image
# pulled/pushed earlier.
#
# --sealed diverges in three ways, all of which matter:
#   1. the payload image is :sealed, not :latest;
#   2. the payload REF is …/krytis:sealed, so recipe.json's targetImgref makes the
#      installed system follow the sealed stream — pointing it at :latest would make
#      the first `bootc upgrade` replace the signed boot chain with unsigned
#      artifacts the enrolled firmware then refuses (#371);
#   3. PAYLOAD_SEALED=1 tells iso-sd-boot.sh to embed the payload byte-identically,
#      because the UKI's baked composefs= digest cannot survive the pipeline's
#      normal inject-and-recommit pass. See docs/skills/secure-boot.md
#      § A sealed ISO payload must be embedded byte-identically.
if [[ "${SEALED}" -eq 1 ]]; then
    # Default: the sealed image this checkout builds. For release validation (the
    # T4 hardware checklist) pass the PUBLISHED one instead — the ISO otherwise
    # carries local bits wearing the published name, and a sealed image's UKI
    # bakes in a digest of its own rootfs, so local bits prove nothing about
    # whether the artifact users install is self-consistent.
    LOCAL_IMAGE="${usage_payload_image:-localhost/krytis:sealed}"
    ./scripts/ensure-sealed-image.sh ${usage_payload_image:+"${LOCAL_IMAGE}"}
    PAYLOAD_REF="ghcr.io/starlit-os/krytis:sealed"
    ISO_NAME="krytis-live-sealed.iso"

    # iso-sd-boot.sh runs `podman rmi "${PAYLOAD_IMAGE}"` once it has exported the
    # payload to an oci-archive, to reclaim ~7GB before the squashfs step.
    # In the default case that deletes only the tagged copy and
    # localhost/krytis:sealed survives for the verification below — but naming
    # the published ref as the payload makes source and copy the same object, so
    # the build would delete exactly what verify-iso-payload needs.
    # Keep an alias the pipeline has no reason to touch.
    if [[ "${LOCAL_IMAGE}" == "${PAYLOAD_REF}" ]]; then
        podman tag "${LOCAL_IMAGE}" localhost/krytis:iso-payload
        LOCAL_IMAGE="localhost/krytis:iso-payload"
    fi
else
    LOCAL_IMAGE="localhost/krytis:latest"
    PAYLOAD_REF="$(tr -d '[:space:]' < "${REPO_ROOT}/krytis/payload_ref")"
    ISO_NAME="krytis-live.iso"
fi

if ! podman image exists "${LOCAL_IMAGE}"; then
    echo "ERROR: ${LOCAL_IMAGE} not found — run '$([[ "${SEALED}" -eq 1 ]] && echo 'mise run seal-uki' || echo 'mise build')' first." >&2
    exit 1
fi

echo "==> Tagging ${LOCAL_IMAGE} → ${PAYLOAD_REF} for offline embed..."
podman tag "${LOCAL_IMAGE}" "${PAYLOAD_REF}"

OUTPUT_DIR="${usage_output_dir:-output}"
WORKDIR="${usage_workdir:-${OUTPUT_DIR}}"
DEBUG=$([[ "${usage_debug:-}" == "true" ]] && echo 1 || echo 0)
COMPRESSION="${usage_compression:-fast}"
INSTALLER_CHANNEL="stable"

# Absolute from here on: these are handed to iso-sd-boot.sh via env, so a
# relative path would resolve against the script's CWD rather than ours.
mkdir -p "${OUTPUT_DIR}" "${WORKDIR}"
OUTPUT_DIR="$(realpath "${OUTPUT_DIR}")"
WORKDIR="$(realpath "${WORKDIR}")"

# buildah + xorriso have no freedesktop-sdk component, so they are not in the
# Krytis image. Build the iso-tools container (Fedora-based, carries both) and
# point iso-sd-boot.sh at it via ISO_TOOLS_IMAGE. The host runs everything else
# (podman, skopeo, mksquashfs, mtools, dosfstools) from the dev-tools stack.
ISO_TOOLS_IMAGE="${ISO_TOOLS_IMAGE:-localhost/iso-tools:latest}"
echo "==> Building iso-tools container (${ISO_TOOLS_IMAGE})..."
podman build -t "${ISO_TOOLS_IMAGE}" "${REPO_ROOT}/live/iso-tools"

# Build the live installer container (localhost/krytis-installer).
# Pass PAYLOAD_REF so configure-live-krytis.sh bakes the correct imgref into
# recipe.json — a sealed build must point recipe.json at :sealed, not :latest.
echo "==> Building localhost/krytis-installer..."
BUILD_ARGS=(
    --build-arg "TARGET=krytis"
    --build-arg "TAG=$(tr -d '[:space:]' < "${REPO_ROOT}/krytis/tag")"
    --build-arg "REGISTRY=$(tr -d '[:space:]' < "${REPO_ROOT}/krytis/registry")"
    --build-arg "INSTALLER_CHANNEL=${INSTALLER_CHANNEL}"
    --build-arg "DEBUG=${DEBUG}"
    --build-arg "CACHE_BUST=$(date +%Y%m%d)"
    --build-arg "PAYLOAD_REF=${PAYLOAD_REF}"
)
podman build \
    "${BUILD_ARGS[@]}" \
    -t localhost/krytis-installer \
    --cap-add SYS_ADMIN \
    --security-opt label=disable \
    "${REPO_ROOT}/live"

echo "==> Building Krytis live ISO"
echo "    output:     ${OUTPUT_DIR}"
echo "    workdir:    ${WORKDIR}"
echo "    compress:   ${COMPRESSION}"
echo "    iso-tools:  ${ISO_TOOLS_IMAGE}"
echo "    sealed:     ${SEALED}"
echo "    payload:    ${PAYLOAD_REF}"

TARGET=krytis \
OUTPUT_DIR="${OUTPUT_DIR}" \
WORKDIR="${WORKDIR}" \
DEBUG="${DEBUG}" \
INSTALLER_CHANNEL="${INSTALLER_CHANNEL}" \
COMPRESSION="${COMPRESSION}" \
PAYLOAD_SEALED="${SEALED}" \
PAYLOAD_REF="${PAYLOAD_REF}" \
ISO_TOOLS_IMAGE="${ISO_TOOLS_IMAGE}" \
    bash "${REPO_ROOT}/scripts/iso-sd-boot.sh"

# iso-sd-boot.sh always writes ${TARGET}-live.iso; rename for sealed builds.
if [[ "${SEALED}" -eq 1 ]]; then
    mv "${OUTPUT_DIR}/krytis-live.iso" "${OUTPUT_DIR}/${ISO_NAME}"
    # iso-sd-boot.sh's `podman rmi "${PAYLOAD_IMAGE}"` has just deleted the tag
    # it was handed. When that tag was one the user pulled themselves, put it back
    # so follow-up steps name it the obvious way rather than knowing about the alias.
    if [[ "${LOCAL_IMAGE}" == "localhost/krytis:iso-payload" ]]; then
        podman tag "${LOCAL_IMAGE}" "${PAYLOAD_REF}"
    fi
    ./mise/tasks/verify-iso-payload --iso "${OUTPUT_DIR}/${ISO_NAME}" --image "${LOCAL_IMAGE}"
fi

echo "==> ISO ready: ${OUTPUT_DIR}/${ISO_NAME}"
