#!/usr/bin/env bash
#MISE description="Build a live ISO for Krytis using the dakota-iso pipeline"
#USAGE flag "--output-dir <dir>" default="output" help="Directory for the final ISO and intermediate artifacts"
#USAGE flag "--workdir <dir>" help="Working directory for squashfs staging (XFS/BTRFS recommended)"
#USAGE flag "--compression <mode>" default="fast" help="Squashfs compression: fast or release"
#USAGE flag "--debug" help="Enable SSH in the live environment (not for production)"
#USAGE flag "--sealed" help="Embed the signed UKI image (localhost/krytis:sealed) as the offline install payload instead of the unsigned one"
#USAGE flag "--payload-image <ref>" help="With --sealed, embed this already-built image instead of localhost/krytis:sealed. Use the published ref for release validation; it is taken as-is, never re-sealed"

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

# dakota-iso is expected as a sibling of the main krytis checkout. Resolve from
# the main worktree (via git-common-dir) so this works when run from a git
# worktree too — there REPO_ROOT is nested under .worktrees/ and a naive
# "${REPO_ROOT}/.." points at the wrong place. Override with DAKOTA_ISO_DIR.
if [[ -z "${DAKOTA_ISO_DIR:-}" ]]; then
    COMMON_GIT="$(git -C "${REPO_ROOT}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    MAIN_ROOT="${COMMON_GIT:+$(dirname "${COMMON_GIT}")}"
    MAIN_ROOT="${MAIN_ROOT:-${REPO_ROOT}}"
    DAKOTA_ISO_DIR="$(realpath "${MAIN_ROOT}/../dakota-iso" 2>/dev/null || echo "${MAIN_ROOT}/../dakota-iso")"
fi

if [[ ! -f "${DAKOTA_ISO_DIR}/justfile" ]]; then
    echo "ERROR: dakota-iso not found at ${DAKOTA_ISO_DIR}" >&2
    echo "       Clone kitten-lily/dakota-iso as a sibling of the krytis checkout, or set DAKOTA_ISO_DIR." >&2
    exit 1
fi

SEALED=$([[ "${usage_sealed:-}" == "true" ]] && echo 1 || echo 0)

if [[ -n "${usage_payload_image:-}" && "${SEALED}" -eq 0 ]]; then
    echo "ERROR: --payload-image only applies with --sealed." >&2
    echo "       The unsigned payload comes from ${DAKOTA_ISO_DIR}/krytis/payload_ref." >&2
    exit 1
fi

# iso-sd-boot.sh ignores env vars it does not know, so an out-of-date sibling
# checkout would silently build a BROKEN sealed ISO — a mutated payload whose
# UKI composefs digest no longer matches, discovered ~40 minutes later when
# `bootc install` aborts. Refuse before the expensive step, matching boot-test's
# up-front "does this image even have a UKI" guard.
if [[ "${SEALED}" -eq 1 ]]; then
    if ! grep -q 'PAYLOAD_SEALED' "${DAKOTA_ISO_DIR}/scripts/iso-sd-boot.sh" \
       || ! grep -q 'PAYLOAD_REF' "${DAKOTA_ISO_DIR}/live/src/configure-live-krytis.sh"; then
        echo "ERROR: ${DAKOTA_ISO_DIR} predates sealed-payload support (#371)." >&2
        echo "       --sealed needs PAYLOAD_SEALED in scripts/iso-sd-boot.sh and PAYLOAD_REF in" >&2
        echo "       live/src/configure-live-krytis.sh. Update the sibling checkout:" >&2
        echo "         git -C ${DAKOTA_ISO_DIR} pull" >&2
        echo "       Without them the ISO would embed a mutated payload whose UKI composefs" >&2
        echo "       digest no longer matches, and the install would fail late." >&2
        exit 1
    fi
fi

# `mise build` only tags the freshly built image as localhost/krytis:latest, and
# `mise run seal-uki` only tags localhost/krytis:sealed. iso-sd-boot.sh does
# `podman save` on the payload ref it is given, so re-tag on every run: without a
# matching local tag it either fails outright or silently embeds a stale image
# pulled/pushed earlier.
#
# --sealed diverges in three ways, all of which matter:
#   1. the payload image is :sealed, not :latest;
#   2. the payload REF is …/krytis:sealed, so recipe.json's targetImgref makes the
#      installed system follow the sealed stream — pointing it at :latest would make
#      the first `bootc upgrade` replace the signed boot chain with unsigned
#      artifacts the enrolled firmware then refuses (#371);
#   3. PAYLOAD_SEALED=1 tells dakota-iso to embed the payload byte-identically,
#      because the UKI's baked composefs= digest cannot survive the pipeline's
#      normal inject-and-recommit pass. See docs/skills/secure-boot.md
#      § A sealed ISO payload must be embedded byte-identically.
if [[ "${SEALED}" -eq 1 ]]; then
    # Default: the sealed image this checkout builds. For release validation (the
    # T4 hardware checklist) pass the PUBLISHED one instead — the ISO otherwise
    # carries local bits wearing the published name, and a sealed image's UKI
    # bakes in a digest of its own rootfs, so local bits prove nothing about
    # whether the artifact users install is self-consistent.
    LOCAL_IMAGE="${usage_payload_image:-localhost/krytis:sealed}"
    ./scripts/ensure-sealed-image.sh ${usage_payload_image:+"${LOCAL_IMAGE}"}
    PAYLOAD_REF="ghcr.io/starlit-os/krytis:sealed"
    ISO_NAME="krytis-live-sealed.iso"

    # dakota-iso runs `podman rmi "${PAYLOAD_IMAGE}"` once it has exported the
    # payload to an oci-archive, to reclaim ~7GB before the squashfs step
    # (scripts/iso-sd-boot.sh). In the default case that deletes only the tagged
    # copy and localhost/krytis:sealed survives for the verification below — but
    # naming the published ref as the payload makes source and copy the same
    # object, so the build would delete exactly what verify-iso-payload needs.
    # Keep an alias the pipeline has no reason to touch.
    if [[ "${LOCAL_IMAGE}" == "${PAYLOAD_REF}" ]]; then
        podman tag "${LOCAL_IMAGE}" localhost/krytis:iso-payload
        LOCAL_IMAGE="localhost/krytis:iso-payload"
    fi
else
    LOCAL_IMAGE="localhost/krytis:latest"
    PAYLOAD_REF="$(tr -d '[:space:]' < "${DAKOTA_ISO_DIR}/krytis/payload_ref")"
    ISO_NAME="krytis-live.iso"
fi

if ! podman image exists "${LOCAL_IMAGE}"; then
    echo "ERROR: ${LOCAL_IMAGE} not found — run '$([[ "${SEALED}" -eq 1 ]] && echo 'mise run seal-uki' || echo 'mise build')' first." >&2
    exit 1
fi

echo "==> Tagging ${LOCAL_IMAGE} → ${PAYLOAD_REF} for offline embed..."
podman tag "${LOCAL_IMAGE}" "${PAYLOAD_REF}"

OUTPUT_DIR="${usage_output_dir:-output}"
WORKDIR="${usage_workdir:-${OUTPUT_DIR}}"
DEBUG=$([[ "${usage_debug:-}" == "true" ]] && echo 1 || echo 0)
COMPRESSION="${usage_compression:-fast}"

# Absolute from here on: these are handed to just with --working-directory set to
# the dakota-iso checkout, so a relative path would resolve against ITS root.
mkdir -p "${OUTPUT_DIR}" "${WORKDIR}"
OUTPUT_DIR="$(realpath "${OUTPUT_DIR}")"
WORKDIR="$(realpath "${WORKDIR}")"

# buildah + xorriso have no freedesktop-sdk component, so they are not in the
# Krytis image. Build the iso-tools container (Fedora-based, carries both) and
# point iso-sd-boot.sh at it via ISO_TOOLS_IMAGE. The host runs everything else
# (podman, skopeo, mksquashfs, mtools, dosfstools) from the dev-tools stack.
ISO_TOOLS_IMAGE="${ISO_TOOLS_IMAGE:-localhost/iso-tools:latest}"
echo "==> Building iso-tools container (${ISO_TOOLS_IMAGE})..."
podman build -t "${ISO_TOOLS_IMAGE}" "${DAKOTA_ISO_DIR}/live/iso-tools"

echo "==> Building Krytis live ISO"
echo "    dakota-iso: ${DAKOTA_ISO_DIR}"
echo "    output:     ${OUTPUT_DIR}"
echo "    workdir:    ${WORKDIR}"
echo "    compress:   ${COMPRESSION}"
echo "    iso-tools:  ${ISO_TOOLS_IMAGE}"
echo "    sealed:     ${SEALED}"
echo "    payload:    ${PAYLOAD_REF}"

# Pass output_dir/workdir/debug/compression as just VARIABLES, not environment.
# dakota-iso's iso-sd-boot recipe assigns them from its own just variables
# (OUTPUT_DIR={{output_dir}}, DEBUG={{debug}}, …), and a recipe-level assignment
# shadows whatever the caller exported — so every one of these flags was silently
# a no-op until #371: the ISO landed in dakota-iso/output/ instead of ours, and
# --debug never enabled sshd in the live session. ISO_TOOLS_IMAGE / PAYLOAD_REF /
# PAYLOAD_SEALED are NOT assigned by the recipe, so those do travel as env.
ISO_TOOLS_IMAGE="${ISO_TOOLS_IMAGE}" \
PAYLOAD_REF="${PAYLOAD_REF}" \
PAYLOAD_SEALED="${SEALED}" \
    just --justfile "${DAKOTA_ISO_DIR}/justfile" \
         --working-directory "${DAKOTA_ISO_DIR}" \
         output_dir="${OUTPUT_DIR}" \
         workdir="${WORKDIR}" \
         debug="${DEBUG}" \
         compression="${COMPRESSION}" \
         iso-sd-boot krytis

# dakota-iso always writes ${TARGET}-live.iso, so a sealed build necessarily
# overwrites any existing default ISO at that path before this rename — rebuild
# the default one if you need both variants side by side.
if [[ "${SEALED}" -eq 1 ]]; then
    mv "${OUTPUT_DIR}/krytis-live.iso" "${OUTPUT_DIR}/${ISO_NAME}"
    # dakota-iso's `podman rmi "${PAYLOAD_IMAGE}"` has just deleted the tag it was
    # handed. When that tag was one the user pulled themselves, put it back —
    # building an ISO should not silently remove an image from their storage, and
    # every follow-up step (iso-install-test --payload-image, another build) names
    # it the obvious way rather than knowing about the alias.
    if [[ "${LOCAL_IMAGE}" == "localhost/krytis:iso-payload" ]]; then
        podman tag "${LOCAL_IMAGE}" "${PAYLOAD_REF}"
    fi
    ./mise/tasks/verify-iso-payload --iso "${OUTPUT_DIR}/${ISO_NAME}" --image "${LOCAL_IMAGE}"
fi

echo "==> ISO ready: ${OUTPUT_DIR}/${ISO_NAME}"
