#!/usr/bin/env bash
#MISE description="Update falcond element to the latest pikaos release"

set -euo pipefail

ELEMENT="elements/desktop/falcond.bst"
REPO="PikaOS-Linux/falcond"

# git.pika-os.com (the canonical PikaOS Gitea instance falcond is developed
# on) sits behind Cloudflare, which 403s GitHub Actions' own hosted-runner
# IP range regardless of User-Agent — the identical request succeeds from
# other networks, and `bst source track`/fetch from Blacksmith and
# self-hosted runners is unaffected, so it is that IP range specifically,
# not a User-Agent denylist. PikaOS-Linux/falcond on GitHub is a verified
# mirror (same annotated tag object id as the Gitea origin — see the
# "Source" comment in falcond.bst) with no such block, so both the
# element's source and this tracker use it instead of runner-hopping.
UA="krytis/1.0 (+https://github.com/starlit-os/krytis)"

echo "==> Fetching latest falcond release..."
LATEST_TAG=$(gh api "repos/${REPO}/releases/latest" --jq '.tag_name')
LATEST_VER="${LATEST_TAG#v}"
echo "==> Latest: ${LATEST_TAG}"

# Scoped to the `url:` line — a stale version number left in a comment
# elsewhere in the element must not be picked up here (see #652 / the
# wlroots incident documented in mise/tasks/tarball-update).
CURRENT_TAG=$(grep -oP '^\s*url:.*archive/\Kv[^/]+(?=\.tar\.gz)' "$ELEMENT" | head -1)
CURRENT_VER="${CURRENT_TAG#v}"
echo "==> Current: ${CURRENT_TAG}"

if [ "${LATEST_VER}" = "${CURRENT_VER}" ]; then
  echo "==> Already up to date (${CURRENT_VER})"
  exit 0
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

ARCHIVE="${LATEST_TAG}.tar.gz"
echo "==> Downloading ${ARCHIVE}..."
curl -fsSL -A "$UA" "https://github.com/${REPO}/archive/${ARCHIVE}" -o "${TMPDIR}/${ARCHIVE}"
SHA=$(sha256sum "${TMPDIR}/${ARCHIVE}" | awk '{print $1}')
echo "    sha256=${SHA}"

CURRENT_SHA=$(grep -A2 "archive/${CURRENT_TAG}.tar.gz" "$ELEMENT" | grep 'ref:' | awk '{print $2}')

echo "==> Updating ${ELEMENT}: ${CURRENT_VER} → ${LATEST_VER}"
sed -i "s|archive/${CURRENT_TAG}.tar.gz|archive/${LATEST_TAG}.tar.gz|" "$ELEMENT"
sed -i "s|ref: ${CURRENT_SHA}|ref: ${SHA}|" "$ELEMENT"

echo "==> Done. Run 'mise run validate' to verify."
