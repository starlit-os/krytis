#!/usr/bin/env bash
#MISE description="Sync tracked upstreams (docs/upstreams.yml) to their upstream branch and report the commit range since the last lessons-mining pass"
#USAGE arg "[repo]" help="Only sync this repo (matches 'name:' in docs/upstreams.yml); default: all tracked repos"
#USAGE flag "--check" help="Report pending commits without moving the local checkout (still fetches; skips the --ff-only merge)"

# Cadence (#304): a mining pass is due every two weeks, or sooner once a range grows past
# what one review can absorb. This task does not mine; it only reports, per repo,
# how long ago the last pass was, and flags a repo DUE when it has new commits AND
# either its last_checked_date is MINING_CADENCE_DAYS or more old, or the pending
# range is MINING_MAX_COMMITS or more commits. A repo with no new commits is never
# due, however old its date: there is nothing to mine.

set -euo pipefail

TRACKING_FILE="docs/upstreams.yml"
FILTER="${usage_repo:-}"
CHECK_ONLY="${usage_check:-false}"
MINING_CADENCE_DAYS=14
MINING_MAX_COMMITS=50
TODAY=$(date -u +%F)

if [ ! -f "$TRACKING_FILE" ]; then
  echo "ERROR: $TRACKING_FILE not found" >&2
  exit 1
fi

# docs/upstreams.yml is a fixed, flat "name/upstream/branch/..." shape owned by
# the upstream-lessons skill — parsed with awk rather than pulling in a yaml library.
mapfile -t NAMES < <(awk -F': ' '/^  - name:/{print $2}' "$TRACKING_FILE")

if [ -n "$FILTER" ] && ! printf '%s\n' "${NAMES[@]}" | grep -qx "$FILTER"; then
  echo "ERROR: '${FILTER}' not found in ${TRACKING_FILE} (known: ${NAMES[*]})" >&2
  exit 1
fi

# local_path in docs/upstreams.yml is a bare dir name, sibling of krytis's *main*
# checkout — not $PWD, which under a worktree is somewhere else on disk entirely.
MAIN_WORKTREE=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
SIBLING_BASE=$(dirname "$MAIN_WORKTREE")

for name in "${NAMES[@]}"; do
  [ -n "$FILTER" ] && [ "$name" != "$FILTER" ] && continue

  block=$(awk -v n="$name" '
    $0 ~ "^  - name: " n "$" {found=1}
    found && /^  - name:/ && $0 !~ ("^  - name: " n "$") {found=0}
    found {print}
  ' "$TRACKING_FILE")

  upstream=$(awk -F': ' '/^    upstream:/{print $2; exit}' <<<"$block")
  branch=$(awk -F': ' '/^    branch:/{print $2; exit}' <<<"$block")
  local_path="${SIBLING_BASE}/$(awk -F': ' '/^    local_path:/{print $2; exit}' <<<"$block")"
  last_sha=$(awk -F': ' '/^    last_checked_sha:/{print $2; exit}' <<<"$block")
  last_date=$(awk -F': ' '/^    last_checked_date:/{gsub(/"/, "", $2); print $2; exit}' <<<"$block")
  age_days=$(( ($(date -u -d "$TODAY" +%s) - $(date -u -d "$last_date" +%s)) / 86400 ))

  echo "==> ${name} (${upstream}, branch ${branch}) — last mined ${last_date} (${age_days} days ago)"

  # A missing checkout used to be skipped with a warning, which made the whole
  # task a silent no-op on a machine that never had the siblings (exit 0, every
  # repo "skipped", nothing mined). Clone it instead — and clone from
  # `upstream:`, which is also the only clone path that cannot reintroduce a
  # fork remote. Full depth, not --depth: the mining pass runs `git log A..B`
  # and `git show`, both of which need real history.
  if [ ! -d "$local_path/.git" ]; then
    echo "    no checkout at ${local_path} — cloning https://github.com/${upstream}"
    git clone --branch "$branch" "https://github.com/${upstream}.git" "$local_path"
  fi

  if [ "$CHECK_ONLY" = "true" ]; then
    git -C "$local_path" fetch origin "$branch" --quiet
    new_sha=$(git -C "$local_path" rev-parse "origin/${branch}")
  else
    git -C "$local_path" fetch origin "$branch"
    git -C "$local_path" merge --ff-only "origin/${branch}"
    new_sha=$(git -C "$local_path" rev-parse HEAD)
  fi

  if [ "$new_sha" = "$last_sha" ]; then
    echo "    up to date at ${last_sha:0:12} — nothing new since the last lessons pass"
    continue
  fi

  count=$(git -C "$local_path" rev-list --count "${last_sha}..${new_sha}" 2>/dev/null || echo "?")
  echo "    ${last_sha:0:12}..${new_sha:0:12} (${count} commits) — new HEAD: ${new_sha}"
  reasons=()
  [ "$age_days" -ge "$MINING_CADENCE_DAYS" ] && reasons+=("last pass is ${age_days} days old")
  [[ "$count" =~ ^[0-9]+$ ]] && [ "$count" -ge "$MINING_MAX_COMMITS" ] && reasons+=("${count} commits pending")
  if [ "${#reasons[@]}" -gt 0 ]; then
    joined=$(printf '%s; ' "${reasons[@]}")
    echo "    DUE: ${joined%; } (cadence: ${MINING_CADENCE_DAYS} days or ${MINING_MAX_COMMITS} commits, #304) — run the upstream-lessons skill"
  fi
done
