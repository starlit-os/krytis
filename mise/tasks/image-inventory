#!/usr/bin/env python3
#MISE description="Regenerate or check the first-party element inventory in docs/design/image-inventory.md"
#USAGE flag "--write" help="Rewrite the doc's Inventory section in place, keeping existing descriptions"
#USAGE flag "--check" help="Fail if the Inventory section differs from the element graph, or a row has no description"
"""Inventory of what krytis itself adds to the image, outside the two junctions.

The element graph is walked from oci/krytis/image.bst. Every element under
elements/oci/ or elements/stacks/ is a *container*: it only aggregates, so the
walk descends through all of its dependencies. Any other krytis element a
container lists directly is a *top-level* element, filed under the first
container (depth-first, in dependency-list order) that lists it.

From the top-level elements and the junction override targets, the walk follows
krytis-local edges only (anything with a `:` is a junction element and is
skipped):

  runtime dependency  reached through `depends:`/`runtime-depends:` edges
                      alone, so it is staged into the image;
  build-only          reached only through some `build-depends:` edge, so it
                      never lands in the image itself.

Junction replacements are read from the `config: overrides:` map of every
`kind: junction` element: a krytis element standing in for a freedesktop-sdk or
gnome-build-meta one.

Default output is the regenerated Inventory section on stdout. `--write` puts
it into the doc; `--check` (CI) fails if the doc's section differs from it, or
if any row's description cell is empty. Descriptions are the only hand-written
part and are carried over by element path, so an element moving between
sections keeps its text.

Tree-not-diff, like patch-inventory-check, and for the same reason: a
diff-scoped gate only sees the PR that adds an element, never one that landed
before the gate existed.
"""

import difflib
import os
import pathlib
import re
import sys

import yaml

DOC = pathlib.Path("docs/design/image-inventory.md")
ROOT = "oci/krytis/image.bst"
CONTAINER_PREFIXES = ("oci/", "stacks/")
ELEMENTS = pathlib.Path("elements")

H_TOP = "### Top-level elements"
H_RUNTIME = "### Runtime dependencies"
H_BUILD = "### Build-only dependencies"
H_REPLACE = "### Junction replacements"
MARKER = (
    "<!-- Generated by `mise run image-inventory --write`. "
    "Only the last column of each table is hand-written. -->"
)

Loader = getattr(yaml, "CSafeLoader", yaml.SafeLoader)
_cache = {}


def load(name):
    if name not in _cache:
        _cache[name] = yaml.load((ELEMENTS / name).read_text(), Loader=Loader) or {}
    return _cache[name]


def edges(name):
    """[(dep, is_runtime)] for krytis-local dependencies of `name`, in list order."""
    data = load(name)
    out = []
    for key, default in (("depends", None), ("build-depends", "build"),
                         ("runtime-depends", "runtime")):
        for entry in data.get(key) or []:
            if isinstance(entry, str):
                names, dep_type = [entry], default
            else:
                fn = entry.get("filename")
                names = fn if isinstance(fn, list) else [fn]
                dep_type = default or entry.get("type")
                if entry.get("junction"):
                    continue
            for n in names:
                if ":" not in n:
                    out.append((n, dep_type != "build"))
    return out


def is_container(name):
    return name.startswith(CONTAINER_PREFIXES)


def walk():
    top = {}       # element -> container, insertion order = section order
    sections = []  # containers that list at least one top-level element
    seen = set()

    def visit(container):
        if container in seen:
            return
        seen.add(container)
        for dep, _ in edges(container):
            if is_container(dep):
                visit(dep)
            elif dep not in top:
                top[dep] = container
                if container not in sections:
                    sections.append(container)

    visit(ROOT)

    replacements = []  # (local element, upstream element)
    for path in sorted(ELEMENTS.glob("*.bst")):
        data = load(path.name)
        if data.get("kind") != "junction":
            continue
        for upstream, local in ((data.get("config") or {}).get("overrides") or {}).items():
            if ":" in local or load(local).get("kind") == "junction":
                continue
            replacements.append((local, f"{path.name}:{upstream}"))

    sources = list(top) + [local for local, _ in replacements]
    parents, runtime = {}, set()
    stack = [(s, True) for s in sources]
    while stack:
        name, via_runtime = stack.pop()
        for dep, is_rt in edges(name):
            if is_container(dep) or dep in top:
                continue
            first = dep not in parents
            parents.setdefault(dep, set()).add((name, is_rt))
            if via_runtime and is_rt and dep not in runtime:
                runtime.add(dep)
                stack.append((dep, True))
            elif first:
                stack.append((dep, False))

    # "Pulled in by" names only the parents that put a runtime dependency in the
    # image: a runtime edge from something that is itself in the image.
    in_image = set(top) | runtime | {local for local, _ in replacements}
    deps_rt = {d: sorted({p for p, rt in parents[d] if rt and p in in_image})
               for d in runtime}
    deps_build = {d: sorted({p for p, _ in parents[d]})
                  for d in parents if d not in runtime}
    return top, sections, deps_rt, deps_build, replacements


def split_row(line):
    cells = re.split(r"(?<!\\)\|", line.strip())[1:-1]
    return [c.strip() for c in cells]


def ticked(cell):
    return re.findall(r"`([^`]+)`", cell)


def read_doc():
    text = DOC.read_text()
    start = text.index("\n## Inventory\n") + 1
    m = re.search(r"^## ", text[start + 1:], re.M)
    end = start + 1 + m.start() if m else len(text)
    descriptions = {}
    for line in text[start:end].splitlines():
        if not line.startswith("|") or line.startswith("|---"):
            continue
        cells = split_row(line)
        names = ticked(cells[0])
        if not names or cells[0] == "Element":
            continue
        descriptions[names[0]] = cells[-1]
    return text, start, end, descriptions


def table(header, rows):
    out = ["| " + " | ".join(header) + " |", "|" + "---|" * len(header)]
    out += ["| " + " | ".join(r) + " |" for r in rows]
    return out


def render(top, sections, deps_rt, deps_build, replacements, desc):
    def d(name):
        return desc.get(name, "")

    def names(xs):
        return ", ".join(f"`{x}`" for x in xs)

    lines = ["## Inventory", "", MARKER, "", H_TOP, ""]
    for container in sections:
        lines += [f"#### `{container}`", ""]
        rows = [[f"`{e}`", d(e)] for e, c in top.items() if c == container]
        lines += table(["Element", "What it adds"], rows) + [""]
    lines += [H_RUNTIME, ""]
    rows = [[f"`{e}`", names(deps_rt[e]), d(e)] for e in sorted(deps_rt)]
    lines += table(["Element", "Pulled in by", "What it is"], rows) + [""]
    lines += [H_BUILD, ""]
    rows = [[f"`{e}`", names(deps_build[e]), d(e)] for e in sorted(deps_build)]
    lines += table(["Element", "Needed by", "What it is"], rows) + [""]
    lines += [H_REPLACE, ""]
    rows = [[f"`{local}`", f"`{up}`", d(local)] for local, up in replacements]
    lines += table(["Element", "Replaces", "Why"], rows)
    return "\n".join(lines) + "\n"


def main():
    write = os.environ.get("usage_write") == "true" or "--write" in sys.argv[1:]
    check = os.environ.get("usage_check") == "true" or "--check" in sys.argv[1:]
    graph = walk()
    text, start, end, desc = read_doc()
    section = render(*graph, desc)
    tail = text[end:]
    new = text[:start] + section + ("\n" + tail if tail else "")

    if check:
        blank = [line for line in section.splitlines()
                 if line.startswith("| `") and line.rstrip().endswith("|  |")]
        if new != text or blank:
            print("==> image-inventory --check FAILED.")
            if new != text:
                print(f"{DOC} disagrees with the element graph:")
                sys.stdout.writelines(difflib.unified_diff(
                    text.splitlines(True), new.splitlines(True), str(DOC), "regenerated"))
            for line in blank:
                print(f"  NO DESCRIPTION {line}")
            print("Fix: mise run image-inventory --write, then fill in every empty last cell.")
            sys.exit(1)
        total = len(graph[0]) + len(graph[2]) + len(graph[3]) + len(graph[4])
        print(f"==> image-inventory --check passed: {len(graph[0])} top-level, "
              f"{len(graph[2])} runtime, {len(graph[3])} build-only, "
              f"{len(graph[4])} replacements ({total} rows).")
    elif write:
        DOC.write_text(new)
        print(f"==> wrote {DOC}")
    else:
        sys.stdout.write(section)


if __name__ == "__main__":
    main()
