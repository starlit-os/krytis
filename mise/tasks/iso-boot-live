#!/usr/bin/env bash
#MISE description="Boot a Krytis live ISO in QEMU and wait for SSH to be ready"
#USAGE flag "--iso <path>" help="Live ISO to boot (auto-detected from output/ if unset)"
#USAGE flag "--disk <path>" default="/var/tmp/krytis-install.img" help="Install target disk image (created if absent)"
#USAGE flag "--scratch <path>" default="/var/tmp/krytis-scratch.img" help="Scratch disk mounted over /var/tmp in the live VM"
#USAGE flag "--monitor <path>" default="/tmp/krytis-qemu-live.sock" help="QEMU HMP monitor socket"
#USAGE flag "--serial <path>" default="/tmp/krytis-qemu-live-serial.log" help="Serial console log"
#USAGE flag "--ssh-port <port>" default="2224" help="SSH port forwarded from the live VM"
#USAGE flag "--mem <mb>" default="8192" help="QEMU memory in MiB"
#USAGE flag "--smp <n>" default="8" help="QEMU vCPU count"
#USAGE flag "--ovmf-vars-scratch <path>" default="/var/tmp/krytis-qemu-live-vars.fd" help="Writable copy of the OVMF variable store"

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=scripts/e2e-lib.sh
source "${REPO_ROOT}/scripts/e2e-lib.sh"

# argc-fallback: parse flags when invoked directly (not via mise run).
CLI_ISO="" CLI_DISK="" CLI_SCRATCH="" CLI_MONITOR="" CLI_SERIAL=""
CLI_SSH_PORT="" CLI_MEM="" CLI_SMP="" CLI_OVMF_VARS_SCRATCH=""
while [ $# -gt 0 ]; do
    case "$1" in
        --iso)               CLI_ISO="$2";              shift 2 ;;
        --disk)              CLI_DISK="$2";             shift 2 ;;
        --scratch)           CLI_SCRATCH="$2";          shift 2 ;;
        --monitor)           CLI_MONITOR="$2";          shift 2 ;;
        --serial)            CLI_SERIAL="$2";           shift 2 ;;
        --ssh-port)          CLI_SSH_PORT="$2";         shift 2 ;;
        --mem)               CLI_MEM="$2";              shift 2 ;;
        --smp)               CLI_SMP="$2";              shift 2 ;;
        --ovmf-vars-scratch) CLI_OVMF_VARS_SCRATCH="$2"; shift 2 ;;
        *) break ;;
    esac
done

ISO="${CLI_ISO:-${usage_iso:-}}"
QEMU_DISK="${CLI_DISK:-${usage_disk:-/var/tmp/krytis-install.img}}"
SCRATCH_DISK="${CLI_SCRATCH:-${usage_scratch:-/var/tmp/krytis-scratch.img}}"
MONITOR="${CLI_MONITOR:-${usage_monitor:-/tmp/krytis-qemu-live.sock}}"
SERIAL="${CLI_SERIAL:-${usage_serial:-/tmp/krytis-qemu-live-serial.log}}"
SSH_PORT="${CLI_SSH_PORT:-${usage_ssh_port:-2224}}"
QEMU_MEM="${CLI_MEM:-${usage_mem:-8192}}"
QEMU_SMP="${CLI_SMP:-${usage_smp:-8}}"
OVMF_VARS_SCRATCH="${CLI_OVMF_VARS_SCRATCH:-${usage_ovmf_vars_scratch:-/var/tmp/krytis-qemu-live-vars.fd}}"

QEMU=$(command -v /usr/libexec/qemu-kvm /usr/bin/qemu-kvm \
           /usr/bin/qemu-system-x86_64 \
           /home/linuxbrew/.linuxbrew/bin/qemu-system-x86_64 2>/dev/null | head -1 || true)
[[ -z "$QEMU" ]] && { echo "ERROR: qemu-kvm / qemu-system-x86_64 not found" >&2; exit 1; }

if [[ -z "$ISO" ]]; then
    for f in "output/krytis-live-sealed.iso" "output/krytis-live.iso" output/krytis-live-*.iso; do
        [[ -f "$f" ]] && { ISO="$f"; break; }
    done
fi
[[ -z "$ISO" ]] && { echo "ERROR: No ISO found — run: mise run build-iso --debug" >&2; exit 1; }
[[ -f "$ISO" ]] || { echo "ERROR: ISO not found: $ISO" >&2; exit 1; }

OVMF_CODE=""
for f in /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd \
          /usr/share/edk2/ovmf/OVMF_CODE.fd /usr/share/ovmf/OVMF.fd \
          /home/linuxbrew/.linuxbrew/share/qemu/edk2-x86_64-code.fd; do
    [[ -f "$f" ]] && { OVMF_CODE="$f"; break; }
done
[[ -z "$OVMF_CODE" ]] && { echo "ERROR: OVMF firmware code image not found" >&2; exit 1; }

OVMF_VARS=""
for f in /usr/share/OVMF/OVMF_VARS_4M.fd /usr/share/OVMF/OVMF_VARS.fd \
          /usr/share/edk2/ovmf/OVMF_VARS.fd \
          /home/linuxbrew/.linuxbrew/share/qemu/edk2-i386-vars.fd; do
    if [[ -f "$f" ]]; then cp "$f" "${OVMF_VARS_SCRATCH}"; OVMF_VARS="${OVMF_VARS_SCRATCH}"; break; fi
done

[[ -f "${QEMU_DISK}" ]]    || truncate -s 64G "${QEMU_DISK}"
[[ -f "${SCRATCH_DISK}" ]] || truncate -s 16G "${SCRATCH_DISK}"
rm -f "${MONITOR}" "${SERIAL}" "${MONITOR}.pid"

QEMU_ACCEL="-accel kvm"
QEMU_PREFIX=""
if ! test -r /dev/kvm 2>/dev/null; then
    if sudo test -r /dev/kvm 2>/dev/null; then
        QEMU_PREFIX="sudo"
    else
        QEMU_ACCEL="-accel tcg,thread=multi"
    fi
fi
CPU_FLAG="-cpu host"
[[ "$QEMU_ACCEL" =~ tcg ]] && CPU_FLAG="-cpu qemu64"

QEMU_PFLASH=(-drive "if=pflash,format=raw,readonly=on,file=${OVMF_CODE}")
[[ -n "$OVMF_VARS" ]] && QEMU_PFLASH+=(-drive "if=pflash,format=raw,file=${OVMF_VARS}")

echo "Booting live ISO: $ISO (mem=${QEMU_MEM} MiB, smp=${QEMU_SMP})"
# shellcheck disable=SC2086
$QEMU_PREFIX "$QEMU" \
    -machine q35 $CPU_FLAG -m "${QEMU_MEM}" -smp "${QEMU_SMP}" $QEMU_ACCEL \
    "${QEMU_PFLASH[@]}" \
    -drive "if=none,id=iso,file=${ISO},media=cdrom,readonly=on,format=raw" \
    -device virtio-scsi-pci,id=scsi \
    -device scsi-cd,drive=iso \
    -drive "if=none,id=disk,file=${QEMU_DISK},format=raw,cache=unsafe" \
    -device virtio-blk-pci,drive=disk \
    -drive "if=none,id=scratch,file=${SCRATCH_DISK},format=raw,cache=unsafe" \
    -device virtio-blk-pci,drive=scratch \
    -netdev "user,id=net0,hostfwd=tcp::${SSH_PORT}-:22" \
    -device virtio-net-pci,netdev=net0 \
    -monitor "unix:${MONITOR},server,nowait" \
    -serial "file:${SERIAL}" \
    -display none \
    -daemonize -pidfile "${MONITOR}.pid"
echo "Live QEMU started (monitor: ${MONITOR})"

SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o PreferredAuthentications=password"
e2e_ssh_auth_init live
SSH_PROBE="${E2E_SSH_WRAP} ssh $SSH_OPTS ${E2E_SSH_AUTH_OPTS} liveuser@127.0.0.1 -p ${SSH_PORT}"

echo "Waiting for live environment on port ${SSH_PORT}..."
for i in $(seq 1 60); do
    # The live env emits KRYTIS_LIVE_READY (or DAKOTA_LIVE_READY for older
    # images) on the serial console when systemd declares the target reached.
    # sshd finishes host-key generation after that, so poll SSH after the
    # marker and add a small settling delay — avoids a "Connection reset by
    # peer" from sshd mid-keygen.
    if grep -qE 'KRYTIS_LIVE_READY|DAKOTA_LIVE_READY|debug-ssh-banner' "${SERIAL}" 2>/dev/null; then
        echo "Serial marker seen — polling SSH (sshd lags systemd-ready by ~10-20 s on KVM)..."
        for j in $(seq 1 30); do
            if $SSH_PROBE true 2>/dev/null; then
                echo "Live environment ready (serial marker + SSH confirmed)."
                sleep 3
                break 2
            fi
            sleep 3
        done
        echo "ERROR: serial marker seen but SSH not ready after 90 s" >&2
        cat "${SERIAL}" >&2
        e2e_qemu_stop "${MONITOR}" "live VM"
        exit 1
    fi
    if $SSH_PROBE true 2>/dev/null; then
        echo "SSH responded (pre-marker) — waiting 15 s for sshd to stabilise..."
        sleep 15
        break
    fi
    [[ $i -eq 60 ]] && {
        echo "ERROR: Timeout waiting for live environment" >&2
        cat "${SERIAL}" >&2
        e2e_qemu_stop "${MONITOR}" "live VM"
        exit 1
    }
    sleep 5
done
